					margin = {1 1}
					margin_top = 0
					alpha = 0.3
					modify_texture = {
						using = color_black_texture
						blend_mode = multiply
					}
				}
			}

			# onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(GoodsDemandEntry.GetGoods)]"
			tooltipwidget = {
				using = SpecificGoodsMarket_tooltip
			}

			widget = {
				size = {23 20}
				text_single = {
					autoresize = no
					parentanchor = center
					align = center|nobaseline
