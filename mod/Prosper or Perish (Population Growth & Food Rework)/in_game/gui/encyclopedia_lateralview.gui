                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowGoodsName('manual_labor')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LABOR_STEP_GOOD" }
                                                        blockoverride "step_text" { text = "PP_EU_LABOR_STEP_GOOD_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/production_methods/_default.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[production_method|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LABOR_STEP_BUILDINGS" }
                                                        blockoverride "step_text" { text = "PP_EU_LABOR_STEP_BUILDINGS_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/highest_market_price.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[market_price|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LABOR_STEP_PRICE" }
                                                        blockoverride "step_text" { text = "PP_EU_LABOR_STEP_PRICE_DESC" }
                                                    }
                                                }

                                                # ---- Newer methods need fewer hands: one manufacturing line, oldest to newest ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/production_methods/_default.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LABOR_AGES" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_step = {
