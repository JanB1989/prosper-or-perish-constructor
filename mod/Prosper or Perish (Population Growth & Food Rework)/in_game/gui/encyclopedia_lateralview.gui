                                                        }
                                                    }
                                                }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/building_based.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_RURAL_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_RURAL_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Labor ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'labor'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/trade_goods/icon_goods_manual_labor.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_labor" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_labor.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_labor_desc" }

                                                # Your capital's market: the labor price (the Manual Labor Price map mode's script value)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                        pp_eu_medallion_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_manual_labor.dds" }
                                                    }
                                                    text_multi = { max_width = 900 autoresize = yes text = "PP_EU_LABOR_CAPITAL" }
                                                }

                                                # ---- Where labor comes from and where it goes: a flow ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_manual_labor.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LABOR_FLOW" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/unemploy.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[Concept('unemploy', 'Unemployed')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LABOR_STEP_IDLE" }
                                                        blockoverride "step_text" { text = "PP_EU_LABOR_STEP_IDLE_DESC" }
                                                    }
