                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/coffee_grove.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('coffee_grove')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/cocoa_grove.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('cocoa_grove')|e]" } }
