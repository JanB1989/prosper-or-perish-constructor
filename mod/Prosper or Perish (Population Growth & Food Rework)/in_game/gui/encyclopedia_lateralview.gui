                                                        blockoverride "step_title" { text = "PP_EU_HARVEST_STEP_REGION" }
                                                        blockoverride "step_text" { text = "PP_EU_HARVEST_STEP_REGION_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/modifiers.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_HARVEST_STEP_MODIFIER" }
                                                        blockoverride "step_text" { text = "PP_EU_HARVEST_STEP_MODIFIER_DESC" }
                                                    }
                                                }

                                                # ---- Lean years and fat years: the scale ----
