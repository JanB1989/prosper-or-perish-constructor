                                                            }
                                                        }
                                                    }
                                                }

                                                # ---- Over the limit: a flow from building levels to market access ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/pp_unsupported_building_levels.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LOGI_OVER" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
