                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/lowest_market_price.dds" } blockoverride "item_link" { raw_text = "[Concept('market_price', 'Cheap Labor')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/tools_guild.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('tools_guild')|e]" } }
