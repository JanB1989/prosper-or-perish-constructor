                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_cotton.dds" tooltip = "cotton" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_tobacco.dds" tooltip = "tobacco" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_dyes.dds" tooltip = "dyes" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_fruit.dds" tooltip = "fruit" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_olives.dds" tooltip = "olives" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_wine.dds" tooltip = "wine" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_cocoa.dds" tooltip = "cocoa" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_coffee.dds" tooltip = "coffee" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_tea.dds" tooltip = "tea" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_sugar.dds" tooltip = "sugar" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_silk.dds" tooltip = "silk" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_incense.dds" tooltip = "incense" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_saffron.dds" tooltip = "saffron" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_pepper.dds" tooltip = "pepper" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_cloves.dds" tooltip = "cloves" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_chili.dds" tooltip = "chili" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_medicaments.dds" tooltip = "medicaments" }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_HARDY" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_fiber_crops.dds" tooltip = "fiber_crops" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_potato.dds" tooltip = "potato" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_beeswax.dds" tooltip = "beeswax" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_horses.dds" tooltip = "horses" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" tooltip = "elephants" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_fur.dds" tooltip = "fur" }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_SPARED" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_livestock.dds" tooltip = "livestock" alpha = 0.55 }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_wool.dds" tooltip = "wool" alpha = 0.55 }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_fish.dds" tooltip = "fish" alpha = 0.55 }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_wild_game.dds" tooltip = "wild_game" alpha = 0.55 }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_camels.dds" tooltip = "camels" alpha = 0.55 }
                                                        }
                                                    }
                                                }
                                                hbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    margin_top = 6
                                                    spacing = 14
                                                    icon = { size = { 56 56 } texture = "gfx/interface/icons/pops/peasants.dds" }
                                                    text_multi = { max_width = 1290 min_width = 1290 autoresize = yes text = "PP_EU_HARVEST_PEASANTS" }
                                                }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/location_modifiers.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_HARVEST_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_HARVEST_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Arable Land ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'pop_capacity'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_population_capacity" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_arable_land.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_population_capacity_desc" }

                                                # Your capital's arable land: the location view's land chip states (markers in pp_capacity_pressure_effects.txt)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/overused.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/abundant.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/available.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0')))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" }
                                                        }
                                                    }
                                                    text_multi = {
                                                        visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_OVERUSED"
                                                    }
                                                    text_multi = {
                                                        visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_ABUNDANT"
                                                    }
                                                    text_multi = {
                                                        visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_AVAILABLE"
                                                    }
                                                    text_multi = {
                                                        visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0')))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_SETTLED"
                                                    }
                                                }

                                                # ---- Where arable land comes from ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/terrain.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_SOURCES" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 24
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/climate.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_NATURAL" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_NATURAL_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/land_clearance.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_IMPROVEMENTS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_IMPROVEMENTS_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/guild_hall.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_BUILDINGS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_BUILDINGS_DESC" }
                                                    }
                                                }
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_LAND_IMPROVEMENTS_ROW" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/land_clearance.dds" tooltip = "land_clearance" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/field_drainage.dds" tooltip = "field_drainage" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/field_management.dds" tooltip = "field_management" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/irrigation_systems.dds" tooltip = "irrigation_systems" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/irrigated_fields.dds" tooltip = "irrigated_fields" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/paddy_water_control.dds" tooltip = "paddy_water_control" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/bund.dds" tooltip = "bund" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/terraces.dds" tooltip = "terraces" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/polders.dds" tooltip = "polders" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/qanats.dds" tooltip = "qanats" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/khmer_baray.dds" tooltip = "khmer_baray" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/buildings/incamisana.dds" tooltip = "incamisana" }
                                                        }
                                                    }
                                                }

                                                # ---- What uses it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_USES" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 24
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_PEOPLE" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_PEOPLE_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/wheat_farm.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_FARMS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_FARMS_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/eng_royal_forest.dds" }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_GROUNDS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_GROUNDS_DESC" }
                                                    }
                                                }

                                                # ---- How full the land is: the three states, emptiest to overused ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/migration.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_STATES" }
                                                }
                                                hbox = {
                                                    spacing = 24
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/abundant.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_ABUNDANT" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/available.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_AVAILABLE" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/overused.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_OVERUSED" }
                                                    }
                                                }
                                                pp_eu_text = { text = "PP_EU_LAND_STATES_DESC" }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/location_modifiers.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_LAND_WHERE_DESC" }
                                            }
                                        }

	                                        # ---- Population Growth ----
