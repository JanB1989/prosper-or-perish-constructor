                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/highest_market_price.dds" } blockoverride "item_link" { raw_text = "[Concept('market_price', 'Dear Labor')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_tools.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('tools')|e]" } }
