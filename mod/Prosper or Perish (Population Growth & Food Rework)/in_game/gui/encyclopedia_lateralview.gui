                                                pp_eu_lead = { text = "game_concept_pp_victuals_desc" }

                                                # Your capital's market: the victuals price (the Victuals Price map mode's script value)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
