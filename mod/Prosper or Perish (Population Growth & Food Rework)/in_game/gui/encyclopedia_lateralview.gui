                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/fruit_orchard.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('fruit_orchard')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/vineyard_estate.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('vineyard_estate')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/fiber_crops_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('fiber_crops_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/sericulture_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('sericulture_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/incense_grove.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('incense_grove')|e]" } }
