                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/geopolitics/accessible_coasts.dds" } blockoverride "item_link" { raw_text = "[port|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/shipyard.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('shipyard')|e]" } }
                                                        }
                                                        blockoverride "panel_title" { text = "PP_EU_NAV_COAST" }
                                                        blockoverride "panel_text" { text = "PP_EU_NAV_COAST_DESC" }
                                                    }
                                                }
                                                pp_eu_text = { text = "PP_EU_NAV_BOTH_DESC" }

                                                # ---- Not every reach is open: the four kinds of waterway ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/pp_river_navigation.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_NAV_REACHES" }
