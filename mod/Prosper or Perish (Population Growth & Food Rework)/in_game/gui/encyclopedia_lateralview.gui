                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('tools_guild')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LABOR_AGE_GUILD" }
                                                        blockoverride "step_text" { text = "PP_EU_LABOR_AGE_GUILD_DESC" }
