                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/dye_plantation.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('dye_plantation')|e]" } }
                                                                    expand = {}
