                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/mountains.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('mountains')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/wetlands.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('wetlands')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/ha1300_topo_deltas.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('ha1300_topo_deltas')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/atoll.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('atoll')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/plateau.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('plateau')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/topography/hills.dds" } blockoverride "item_link" { raw_text = "[ShowTopographyName('hills')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/vegetation/desert.dds" } blockoverride "item_link" { raw_text = "[ShowVegetationName('desert')]" } }
