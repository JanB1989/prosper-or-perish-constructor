                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_clay.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('clay')|e]" } }
                                                            pp_eu_item_arrow = {}
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/rural_daywork_yard.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('rural_daywork_yard')|e]" } }
                                                            pp_eu_item_arrow = {}
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_manual_labor.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('manual_labor')|e]" } }
                                                        }
                                                        blockoverride "entry_title" { text = "PP_EU_LABOR_HIRING_FAIR" }
                                                        blockoverride "entry_text" { text = "PP_EU_LABOR_HIRING_FAIR_DESC" }
                                                    }
                                                    pp_eu_entry_wide = {
