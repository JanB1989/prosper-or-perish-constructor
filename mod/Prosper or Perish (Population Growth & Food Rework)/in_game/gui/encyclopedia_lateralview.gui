                                                # ---- Fishing capacity: the grounds that give it, the buildings that use it up ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/pp_fishing_village_capacity.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_RURAL_FISH" }
                                                }
                                                pp_eu_text = { text = "PP_EU_RURAL_FISH_DESC" }
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_RURAL_GROUNDS_ROW" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/coastal.dds" } blockoverride "item_link" { raw_text = "[coastal|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/geopolitics/exploration_sea.dds" } blockoverride "item_link" { raw_text = "[lake|e]" } }
