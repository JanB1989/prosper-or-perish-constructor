                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/river_boatmen_yard.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('river_boatmen_yard')|e]" } }
                                                        }
                                                        blockoverride "panel_title" { text = "PP_EU_NAV_RIVER" }
                                                        blockoverride "panel_text" { text = "PP_EU_NAV_RIVER_DESC" }
