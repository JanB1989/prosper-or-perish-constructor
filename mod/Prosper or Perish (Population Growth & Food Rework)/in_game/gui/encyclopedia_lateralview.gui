                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_millet.dds" tooltip = "millet" }
                                                            pp_eu_goods = { texture = "gfx/interface/icons/trade_goods/icon_goods_maize.dds" tooltip = "maize" }
