                                        # ---- Logistics (Market Access) ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'building_limits'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/location_icons/market_access.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_building_limits" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_logistics.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_building_limits_desc" }

                                                # Your capital: building levels against its limit, and its market access
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    icon = { texture = "gfx/interface/icons/modifier_types/free_building_levels.dds" size = { 56 56 } }
                                                    text_multi = { max_width = 800 autoresize = yes text = "PP_EU_LOGI_CAPITAL" }
                                                }

                                                # ---- What sets the limit: the location's attributes ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/modifier_types/free_building_levels.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LOGI_LIMIT" }
                                                }
                                                pp_eu_text = { text = "PP_EU_LOGI_LIMIT_DESC" }
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_LOGI_EASY_ROW" }
                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/map_modes/rivers.dds" } blockoverride "item_link" { raw_text = "[river|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/geopolitics/accessible_coasts.dds" } blockoverride "item_link" { raw_text = "[port|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/map_modes/roads.dds" } blockoverride "item_link" { raw_text = "[road|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/city.dds" } blockoverride "item_link" { raw_text = "[location_rank|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/development.dds" } blockoverride "item_link" { raw_text = "[development|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/market.dds" } blockoverride "item_link" { raw_text = "[market_center|e]" } }
                                                                    expand = {}
                                                                }
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/province_capital.dds" } blockoverride "item_link" { raw_text = "[province_capital|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/capital.dds" } blockoverride "item_link" { raw_text = "[capital|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/mediterranean.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('mediterranean')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/oceanic.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('oceanic')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/subtropical.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('subtropical')]" } }
                                                                    expand = {}
