                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_millet.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('millet')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_maize.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('maize')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_rice.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('rice')|e]" } }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_CROPS" }
                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_legumes.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('legumes')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_cotton.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('cotton')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_tobacco.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('tobacco')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_dyes.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('dyes')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_fruit.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('fruit')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_olives.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('olives')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_wine.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('wine')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_cocoa.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('cocoa')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_coffee.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('coffee')|e]" } }
                                                                    expand = {}
                                                                }
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_tea.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('tea')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_sugar.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('sugar')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_silk.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('silk')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_incense.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('incense')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_saffron.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('saffron')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_pepper.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('pepper')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_cloves.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('cloves')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_chili.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('chili')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_medicaments.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('medicaments')|e]" } }
                                                                    expand = {}
                                                                }
                                                            }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_HARDY" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_fiber_crops.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('fiber_crops')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_potato.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('potato')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_beeswax.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('beeswax')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_horses.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('horses')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_elephants.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('elephants')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_fur.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('fur')|e]" } }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_SPARED" }
                                                        blockoverride "row_goods" {
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_livestock.dds" alpha = 0.55 } blockoverride "item_link" { raw_text = "[ShowGoodsName('livestock')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_wool.dds" alpha = 0.55 } blockoverride "item_link" { raw_text = "[ShowGoodsName('wool')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_fish.dds" alpha = 0.55 } blockoverride "item_link" { raw_text = "[ShowGoodsName('fish')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_wild_game.dds" alpha = 0.55 } blockoverride "item_link" { raw_text = "[ShowGoodsName('wild_game')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_camels.dds" alpha = 0.55 } blockoverride "item_link" { raw_text = "[ShowGoodsName('camels')|e]" } }
                                                        }
                                                    }
                                                }
                                                hbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    margin_top = 6
                                                    spacing = 14
                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/pops/peasants.dds" } blockoverride "item_link" { raw_text = "[ShowPopTypeName('peasants')]" } }
                                                    text_multi = { max_width = 1290 min_width = 1290 autoresize = yes text = "PP_EU_HARVEST_PEASANTS" }
                                                }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/location_modifiers.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_HARVEST_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_HARVEST_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Arable Land ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'pop_capacity'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_population_capacity" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_arable_land.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_population_capacity_desc" }

                                                # Your capital's arable land: the location view's land chip states (markers in pp_capacity_pressure_effects.txt)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/overused.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/abundant.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/available.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0')))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" }
                                                        }
                                                    }
                                                    text_multi = {
                                                        visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_OVERUSED"
                                                    }
                                                    text_multi = {
                                                        visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_ABUNDANT"
                                                    }
                                                    text_multi = {
                                                        visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_AVAILABLE"
                                                    }
                                                    text_multi = {
                                                        visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0')))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_SETTLED"
                                                    }
                                                }

                                                # ---- Where arable land comes from ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/terrain.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_SOURCES" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 24
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/climate.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[Concept('pp_location_potential', 'Natural Arable Land')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_NATURAL" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_NATURAL_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/land_clearance.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('land_clearance')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_IMPROVEMENTS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_IMPROVEMENTS_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/guild_hall.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('guild_hall')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_SOURCE_BUILDINGS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_SOURCE_BUILDINGS_DESC" }
                                                    }
                                                }
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_LAND_IMPROVEMENTS_ROW" }
                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/land_clearance.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('land_clearance')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/field_drainage.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('field_drainage')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/field_management.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('field_management')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/irrigation_systems.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('irrigation_systems')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/irrigated_fields.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('irrigated_fields')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/paddy_water_control.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('paddy_water_control')|e]" } }
                                                                    expand = {}
                                                                }
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/bund.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('bund')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/terraces.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('terraces')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/polders.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('polders')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/qanats.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('qanats')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/khmer_baray.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('khmer_baray')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/incamisana.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('incamisana')|e]" } }
                                                                    expand = {}
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                # ---- What uses it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_USES" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 24
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[pop|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_PEOPLE" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_PEOPLE_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/wheat_farm.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('wheat_farm')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_FARMS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_FARMS_DESC" }
                                                    }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/eng_royal_forest.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('eng_royal_forest')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_LAND_USE_GROUNDS" }
                                                        blockoverride "step_text" { text = "PP_EU_LAND_USE_GROUNDS_DESC" }
                                                    }
                                                }

                                                # ---- How full the land is: the three states, emptiest to overused ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/migration.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_STATES" }
                                                }
                                                hbox = {
                                                    spacing = 24
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/abundant.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_ABUNDANT" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/available.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_AVAILABLE" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/overused.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_LAND_STATE_OVERUSED" }
                                                    }
                                                }
                                                pp_eu_text = { text = "PP_EU_LAND_STATES_DESC" }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/location_modifiers.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_LAND_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_LAND_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Population Growth ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'pop_growth'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_population_growth" }
                                                    }
                                                }
                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_population_growth.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_population_growth_desc" }

                                                # Your capital's province: its store (the Food card's months value, the store's fill) and the capital's growth
                                                # (the population growth map mode's value)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[GetPlayer.GetCapital.GetProvince.IsStarving]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/alerts_icons/starving_provinces.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[Not(GetPlayer.GetCapital.GetProvince.IsStarving)]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" }
                                                        }
                                                    }
                                                    text_multi = { max_width = 900 autoresize = yes text = "PP_EU_GROWTH_CAPITAL" }
                                                }

                                                # ---- What fills the store and what empties it: food in - food eaten = months in store ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_GROWTH_STORE" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_local_food.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowGoodsName('local_food')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_GROWTH_IN" }
                                                        blockoverride "step_text" { text = "PP_EU_GROWTH_IN_DESC" }
                                                    }
                                                    pp_eu_sign = { blockoverride "sign_text" { raw_text = "–" } }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/food.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[Concept('pp_food_consumption', 'Food Consumption')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_GROWTH_EATEN" }
                                                        blockoverride "step_text" { text = "PP_EU_GROWTH_EATEN_DESC" }
                                                    }
                                                    pp_eu_sign = { blockoverride "sign_text" { raw_text = "=" } }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[Concept('pp_food_storage', 'Province Store')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_GROWTH_MONTHS" }
                                                        blockoverride "step_text" { text = "PP_EU_GROWTH_MONTHS_DESC" }
                                                    }
                                                }
                                                pp_eu_text = { text = "PP_EU_GROWTH_STORE_DESC" }

                                                # ---- From starving to full: the store steps, worst to best (tests/test_europedia_style.py ties them to
                                                # pp_stored_food.txt and the location ranks' decline) ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_GROWTH_SCALE" }
                                                }
                                                hbox = {
                                                    spacing = 10
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/alerts_icons/starving_provinces.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_STARVING" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_very_poor.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/alerts_icons/low_food_stockpile.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_EMPTY" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_poor.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_VILLAGES" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_TOWNS" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_GROWING" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_GROWTH_SCALE_FULL" }
                                                    }
                                                }
                                                pp_eu_text = { text = "PP_EU_GROWTH_SCALE_DESC" }

                                                # ---- Room in the store: the province's own room + Granaries ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/buildings/granary.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_GROWTH_ROOM" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 10
                                                    pp_eu_panel = {
                                                        blockoverride "panel_icons" {
                                                            pp_eu_item = {
                                                                blockoverride "item_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                                blockoverride "item_link" { raw_text = "[food_capacity|e]" }
                                                            }
                                                            pp_eu_item = {
                                                                blockoverride "item_icon" { texture = "gfx/interface/icons/location_icons/new/population.dds" }
                                                                blockoverride "item_link" { raw_text = "[pop|e]" }
                                                            }
                                                        }
                                                        blockoverride "panel_title" { text = "PP_EU_GROWTH_ROOM_OWN" }
                                                        blockoverride "panel_text" { text = "PP_EU_GROWTH_ROOM_OWN_DESC" }
                                                    }
                                                    pp_eu_sign = { blockoverride "sign_text" { raw_text = "+" } }
                                                    pp_eu_panel = {
                                                        blockoverride "panel_icons" {
                                                            pp_eu_item = {
                                                                blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/granary.dds" }
                                                                blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('granary')|e]" }
                                                            }
                                                            pp_eu_item = {
                                                                blockoverride "item_icon" { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                                blockoverride "item_overlay" { pp_eu_medallion_goods = { texture = "gfx/interface/icons/location_icons/new/population_growth.dds" } }
                                                                blockoverride "item_link" { raw_text = "[ShowModifier('pp_food_store_24')]" }
                                                            }
                                                        }
                                                        blockoverride "panel_title" { text = "PP_EU_GROWTH_ROOM_GRANARY" }
                                                        blockoverride "panel_text" { text = "PP_EU_GROWTH_ROOM_GRANARY_DESC" }
                                                    }
                                                }

                                                # ---- Where to see it ----
