                                                # Your capital's arable land: the location view's land chip states (markers in pp_capacity_pressure_effects.txt)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_abysmal.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/overused.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_bountiful.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/abundant.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/pp_harvest/frame_good.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pp_arable_land/available.dds" }
                                                        }
                                                        widget = { size = { 100% 100% }
                                                            visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0')))]"
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" }
                                                        }
                                                    }
                                                    text_multi = {
                                                        visible = "[GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_OVERUSED"
                                                    }
                                                    text_multi = {
                                                        visible = "[And(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_ABUNDANT"
                                                    }
                                                    text_multi = {
                                                        visible = "[And3(Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_overpopulation')), '(float)0')), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_abundant')), '(float)0')), GreaterThan_float(FixedPointToFloat(GetPlayer.GetCapital.GetModifierValueFixed('pp_land_available')), '(float)0'))]"
                                                        max_width = 700 autoresize = yes text = "PP_EU_LAND_CAPITAL_AVAILABLE"
                                                    }
                                                    text_multi = {
