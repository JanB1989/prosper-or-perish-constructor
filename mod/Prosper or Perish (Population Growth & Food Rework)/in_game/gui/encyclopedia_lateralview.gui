                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/peasants_hunting_grounds.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('peasants_hunting_grounds')|e]" } }
