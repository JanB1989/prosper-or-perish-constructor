                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pops/nobles.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_CONS_POP_NOBLES" }
                                                    }
                                                    pp_eu_scale_step = {
                                                        blockoverride "medallion" {
                                                            pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                            pp_eu_medallion_goods = { texture = "gfx/interface/icons/pops/clergy.dds" }
                                                        }
                                                        blockoverride "scale_label" { text = "PP_EU_CONS_POP_CLERGY" }
                                                    }
                                                    pp_eu_scale_step = {
