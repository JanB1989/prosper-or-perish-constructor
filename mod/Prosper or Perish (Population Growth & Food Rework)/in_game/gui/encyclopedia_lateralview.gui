                                                    pp_eu_panel = {
                                                        blockoverride "panel_icons" {
                                                            pp_eu_item = {
                                                                blockoverride "item_icon" { texture = "gfx/interface/icons/map_modes/prosperity.dds" }
                                                                blockoverride "item_link" { raw_text = "[ShowModifier('prosperity')]" }
                                                            }
                                                            pp_eu_item = {
