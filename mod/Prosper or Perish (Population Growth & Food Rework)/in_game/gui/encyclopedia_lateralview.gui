                                                            pp_eu_item_arrow = {}
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/slave_labor_yard.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('slave_labor_yard')|e]" } }
                                                            pp_eu_item_arrow = {}
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_manual_labor.dds" } blockoverride "item_link" { raw_text = "[ShowGoodsName('manual_labor')|e]" } }
                                                        }
