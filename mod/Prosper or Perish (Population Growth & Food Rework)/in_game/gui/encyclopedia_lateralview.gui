                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/vegetation/ha1300_veg_tundra.dds" } blockoverride "item_link" { raw_text = "[ShowVegetationName('ha1300_veg_tundra')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/vegetation/forest.dds" } blockoverride "item_link" { raw_text = "[ShowVegetationName('forest')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/arctic.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('arctic')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/subpolar.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('subpolar')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/cold_arid.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('cold_arid')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/arid.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('arid')]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/climate/tropical.dds" } blockoverride "item_link" { raw_text = "[ShowClimateName('tropical')]" } }
                                                                    expand = {}
