                                                    blockoverride "section_title" { text = "PP_EU_GROWTH_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_GROWTH_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Buildings in Location (Other Changes) ----
