                                                # ---- What a harvest changes: goods by how far they swing, then the peasants ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/flat_icons/raw_goods.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_HARVEST_CHANGES" }
                                                }
                                                pp_eu_text = { text = "PP_EU_HARVEST_CHANGES_DESC" }
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_HARVEST_GOODS_GRAIN" }
                                                        blockoverride "row_goods" {
