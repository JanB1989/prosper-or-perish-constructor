                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/land_clearance.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('land_clearance')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/field_drainage.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('field_drainage')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/field_management.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('field_management')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/irrigation_systems.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('irrigation_systems')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/irrigated_fields.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('irrigated_fields')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/paddy_water_control.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('paddy_water_control')|e]" } }
                                                                    expand = {}
                                                                }
                                                                hbox = {
                                                                    spacing = 4
