                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/terraces.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('terraces')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/polders.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('polders')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/qanats.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('qanats')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/khmer_baray.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('khmer_baray')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/incamisana.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('incamisana')|e]" } }
                                                                    expand = {}
                                                                }
