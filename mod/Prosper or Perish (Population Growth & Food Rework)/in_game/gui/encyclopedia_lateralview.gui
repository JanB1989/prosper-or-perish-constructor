                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/legume_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('legume_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/potato_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('potato_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/olive_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('olive_farm')|e]" } }
