                                                        blockoverride "step_text" { text = "PP_EU_HARVEST_STEP_SEPTEMBER_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/map_modes/continent.dds" }
