                                                    }
                                                    text_multi = { max_width = 700 autoresize = yes text = "PP_EU_FOOD_CAPITAL" }
                                                }

                                                # ---- Everything hinges on the province store: the farms' split, low store vs full store ----
                                                pp_eu_section = {
