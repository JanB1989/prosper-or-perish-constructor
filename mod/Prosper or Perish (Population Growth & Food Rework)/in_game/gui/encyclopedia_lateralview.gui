                                        # ---- Food Consumption ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'food_consumption'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_food_consumption" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_food_consumption.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_food_consumption_desc" }

                                                # Your capital's province: what it eats a month and how many months of that its store holds
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    widget = {
                                                        size = { 64 64 }
                                                        pp_eu_medallion_frame = { texture = "gfx/interface/icons/climate/brown_frame.dds" }
                                                        pp_eu_medallion_goods = { texture = "gfx/interface/icons/location_icons/food.dds" }
                                                    }
                                                    text_multi = { max_width = 900 autoresize = yes text = "PP_EU_CONS_CAPITAL" }
                                                }

                                                # ---- From the store, month by month: a flow ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/food.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_CONS_FLOW" }
                                                }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[pop_food_consumption|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_CONS_STEP_EAT" }
                                                        blockoverride "step_text" { text = "PP_EU_CONS_STEP_EAT_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/flat_icons/trade_market/food_stockpile.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[Concept('pp_food_storage', 'Province Store')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_CONS_STEP_STORE" }
                                                        blockoverride "step_text" { text = "PP_EU_CONS_STEP_STORE_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/trade_goods/icon_goods_local_food.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowGoodsName('local_food')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_CONS_STEP_BALANCE" }
                                                        blockoverride "step_text" { text = "PP_EU_CONS_STEP_BALANCE_DESC" }
                                                    }
                                                    pp_eu_arrow = {}
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/alerts_icons/starving_provinces.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowModifier('province_starving')]" } }
                                                        blockoverride "step_title" { text = "PP_EU_CONS_STEP_EMPTY" }
                                                        blockoverride "step_text" { text = "PP_EU_CONS_STEP_EMPTY_DESC" }
                                                    }
                                                }

                                                # ---- Who eats how much: the pop types, hungriest to most frugal (pop_food_consumption, pop_types/pp_pop_adjustments.txt) ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/location_icons/population.dds" }
