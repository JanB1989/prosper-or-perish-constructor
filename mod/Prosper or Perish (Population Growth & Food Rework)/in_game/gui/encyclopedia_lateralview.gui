                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/sheep_farms.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('sheep_farms')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/horse_breeders.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('horse_breeders')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/camel_herders.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('camel_herders')|e]" } }
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/elephant_kraal.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('elephant_kraal')|e]" } }
                                                        }
                                                    }
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_RURAL_PLANTATIONS_ROW" }
                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
                                                                hbox = {
                                                                    spacing = 4
                                                                    layoutpolicy_horizontal = expanding
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/sugar_plantation.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('sugar_plantation')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/sugarcane_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('sugarcane_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/cotton_plantation.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('cotton_plantation')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/cotton_farm.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('cotton_farm')|e]" } }
                                                                    pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/tobacco_plantation.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('tobacco_plantation')|e]" } }
