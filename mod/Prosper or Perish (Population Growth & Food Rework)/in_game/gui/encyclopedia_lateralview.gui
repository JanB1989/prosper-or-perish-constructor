                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/lumber_mill.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('lumber_mill')|e]" } }
                                                            pp_eu_item_arrow = {}
                                                            pp_eu_item = { blockoverride "item_icon" { texture = "gfx/interface/icons/buildings/water_sawmill.dds" } blockoverride "item_link" { raw_text = "[ShowBuildingTypeName('water_sawmill')|e]" } }
                                                            pp_eu_item_arrow = {}
