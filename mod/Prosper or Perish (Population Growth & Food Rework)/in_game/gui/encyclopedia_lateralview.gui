                                                pp_eu_text = { text = "PP_EU_NAV_CANAL_DESC" }

                                                # ---- Where to see it ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/location_modifiers.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_NAV_WHERE" }
                                                }
                                                pp_eu_text = { text = "PP_EU_NAV_WHERE_DESC" }
                                            }
                                        }

                                        # ---- Farming/Fishing/Forest Capacities ----
                                        # Card style: in_game/gui/shared/pp_europedia_style.gui (rules: Ingame_Documentation_Rules.md)
                                        vbox = {
                                            visible = "[Or(GetVariableSystem.HasValue('pp_filter', 'all'), GetVariableSystem.HasValue('pp_filter', 'farm_capacity'))]"
                                            set_parent_size_to_minimum = yes
                                            margin = { 0 10 }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 10
                                                margin_bottom = 24
                                                using = bg_paper_card
                                                blockoverride "card_color" { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                max_width = 1450
                                                min_width = 1450
                                                icon = {
                                                    layoutpolicy_horizontal = expanding
                                                    using = button_main_tab_texture
                                                    frame = 4
                                                    modify_texture = { using = color_intense_bg_blue_texture blend_mode = multiply }
                                                    modify_texture = { using = overlay_leather_texture blend_mode = overlay alpha = 0.2 }
                                                    hbox = {
                                                        margin = { 40 0 }
                                                        margin_top = 8
                                                        icon = { texture = "gfx/interface/icons/buildings/wheat_farm.dds" size = { 45 45 } }
                                                        text_single = { name = "title" using = layoutpolicy_expanding using = Font_Size_Medium fontsize = 18 autoresize = no default_format = "yellow_titles" text = "game_concept_pp_farm_capacity" }
                                                    }
                                                }

                                                pp_eu_banner = { blockoverride "banner_texture" { texture = "gfx/interface/illustrations/pp_europedia/banner_rural_capacities.dds" } }
                                                pp_eu_lead = { text = "game_concept_pp_farm_capacity_desc" }

                                                # Your capital: room left for farms, fishing and forest buildings (the three map modes' script values)
                                                hbox = {
                                                    visible = "[GetPlayer.IsValid]"
                                                    spacing = 14
                                                    icon = { texture = "gfx/interface/icons/map_modes/pp_farming_village_capacity.dds" size = { 56 56 } }
                                                    text_multi = { max_width = 1000 autoresize = yes text = "PP_EU_RURAL_CAPITAL" }
                                                }

                                                # ---- Farms take arable land: a farm's maximum level as its tooltip adds it up ----
                                                pp_eu_section = {
                                                    blockoverride "section_icon" { texture = "gfx/interface/icons/map_modes/pp_farming_village_capacity.dds" }
                                                    blockoverride "section_title" { text = "PP_EU_RURAL_FARMS" }
                                                }
                                                pp_eu_text = { text = "PP_EU_RURAL_FARMS_DESC" }
                                                hbox = {
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/map_modes/pp_population_capacity.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[population_capacity|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_RURAL_FARM_LAND" }
                                                        blockoverride "step_text" { text = "PP_EU_RURAL_FARM_LAND_DESC" }
                                                    }
                                                    pp_eu_sign = { blockoverride "sign_text" { raw_text = "–" } }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/modifier_types/global_population_capacity_modifier.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowModifierTypeName('local_pp_farmland_used')]" } }
                                                        blockoverride "step_title" { text = "PP_EU_RURAL_FARM_OTHERS" }
                                                        blockoverride "step_text" { text = "PP_EU_RURAL_FARM_OTHERS_DESC" }
                                                    }
                                                    pp_eu_sign = { blockoverride "sign_text" { raw_text = "=" } }
                                                    pp_eu_step = {
                                                        blockoverride "step_icon" { texture = "gfx/interface/icons/buildings/wheat_farm.dds" }
                                                        blockoverride "step_link" { pp_eu_link = { raw_text = "[ShowBuildingTypeName('wheat_farm')|e]" } }
                                                        blockoverride "step_title" { text = "PP_EU_RURAL_FARM_MAX" }
                                                        blockoverride "step_text" { text = "PP_EU_RURAL_FARM_MAX_DESC" }
                                                    }
                                                }

                                                # The farms by the land a level takes (worldbuilder.farm_land in constructor.toml); first tier of each line
                                                vbox = {
                                                    layoutpolicy_horizontal = expanding
                                                    margin = { 40 0 }
                                                    spacing = 8
                                                    pp_eu_goods_row = {
                                                        blockoverride "row_label" { text = "PP_EU_RURAL_FIELDS_ROW" }
                                                        blockoverride "row_goods" {
                                                            vbox = {
                                                                spacing = 6
