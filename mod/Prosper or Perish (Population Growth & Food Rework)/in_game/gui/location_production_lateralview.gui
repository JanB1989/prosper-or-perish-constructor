lateralview = {
	name = "location_production_lateralview"
	size = { 990 100% } # PP: wider than the vanilla left panel (570), like the build panel
	widget = { # PP: pp_panel_width for the search filter menu
		size = { 0 0 }
		visible_at_creation = no
		visible = "[Not(LocationProductionView.Vars.HasValue('pp_panel_width', '990'))]"
		state = {
			name = _show
			on_start = "[LocationProductionView.Vars.Set('pp_panel_width', '990')]"
		}
	}
	widgetid = "location_production_lateralview"

	blockoverride "panel_header" {
		window_header_alt = {
			datacontext = "[LocationProductionView.GetSelectedLocation]"
			blockoverride "header_text" {
				text = "PRODUCTION_VIEW_LOC"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}

			blockoverride "header_text_object" {
				hbox = {
					spacing = 5
					expand = {}

					location_building_levels_piechart = {
						size = { 28 28 }
					}

					header_title = {
						layoutpolicy_horizontal = fixed
						autoresize = yes
						maximumsize = { 840 -1 }
						text = "PRODUCTION_VIEW_LOC"
						using = snd_UI_window_state
					}

					expand = {}
				}
			}
		}
	}

	blockoverride "panel_content" {
		widget = {
			using = layoutpolicy_expanding

			vbox = {
				using = bg_main_inner_alt
				using = bg_main_inner_image_alt
				using = window_main_tabs_margin_alt

				#Province header
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 45 }
					datacontext = "[LocationProductionView.GetSelectedLocation]"
	
					hbox = {
						margin = { 10 0 }
						hbox = {
							layoutpolicy_horizontal = expanding
							layoutstretchfactor_horizontal = 1
							subheader_unified_icon = {
								alwaystransparent = no
								onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
								visible = "[Location.HasOwner]"
								datacontext = "[Location.GetProvince]"
								margin = { 0 0 }
								maximumsize = {165 -1}
								layoutpolicy_horizontal = expanding
								tooltipwidget = {
									using = province_tooltip
								}
								blockoverride "subheader_unified_icon_texture" {
									using = province_texture
	
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.6
									}
								}
								blockoverride "subheader_unified_top_text" {
									text = "game_concept_province"
									align = nobaseline
								}
								blockoverride "subheader_unified_text_maxsize" { maximumsize = { 125 20 } }
								blockoverride "subheader_unified_bottom_text" {
									text = "[Province.GetNameWithNoTooltip]"
									align = nobaseline
								}
								blockoverride "subheader_unified_icon_post"{
									expand = {}
								}
							}
	
							subheader_unified_icon = {
								visible = "[Not(Location.HasOwner)]"
								datacontext = "[Location.GetProvinceDefinition]"
								margin = { 0 0 }
								maximumsize = {165 -1}
								layoutpolicy_horizontal = expanding
								tooltipwidget = {
									using = ProvinceDefinition_tooltip
								}
								blockoverride "subheader_unified_icon_texture" {
									using = province_texture
	
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.6
									}
								}
								blockoverride "subheader_unified_text_maxsize" { maximumsize = { 125 20 } }
								blockoverride "subheader_unified_top_text" {
									text = "game_concept_province"
									align = nobaseline
								}
								blockoverride "subheader_unified_bottom_text" {
									text = "[ProvinceDefinition.GetNameWithNoTooltip]"
									align = nobaseline
								}
								blockoverride "subheader_unified_icon_post"{
									expand = {}
								}
							}
	
							expand = {}
						}
	
						# OWNER FLAG
						widget = {
							visible = "[Location.HasOwner]"
							size = { 72 48 }
	
							country_flag_mid = {
								parentanchor = center
								size = { 80% 80% }
								datacontext = "[Location.GetOwner]"
							}
						}
	
	
						hbox = {
							datacontext = "[Location.GetProvince]"
							layoutpolicy_horizontal = expanding
							layoutstretchfactor_horizontal = 1
							expand = {}
							subheader_unified_icon = {
								visible = "[Location.HasOwner]"
								blockoverride "mirror_layout" {
									righttoleft = yes
								}
								expand = {}
								margin = { 0 0 }
								maximumsize = {165 -1}
								layoutpolicy_horizontal = expanding
	
								tooltipwidget = {
									using = province_food_tooltip
								}
	
								blockoverride "subheader_unified_icon_texture" {
									piechart = {
										size = { 30 30 }
										using = bg_circle
										using = bg_circle_piechart
										using = piechart_angles
	
										pieslice_no_highlight = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
											value = "[FixedPointToFloat(Divide_CFixedPoint(Province.GetCapital.MakeScope.ScriptValue('pp_province_food_storage_months'), '(CFixedPoint)24'))]"
											color = { 1 1 1 1 }
										}
	
										pieslice_no_highlight = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
											value = "[Subtract_float('(float)1.0', FixedPointToFloat(Divide_CFixedPoint(Province.GetCapital.MakeScope.ScriptValue('pp_province_food_storage_months'), '(CFixedPoint)24')))]"
											color = { 1 1 1 1 }
										}
	
										icon = {
											size = {  71% 71% }
											texture = "gfx/interface/icons/unit_view/food.dds"
											parentanchor = vcenter|hcenter
	
											modify_texture = {
												visible = "[Province.IsRiskOfStarving]"
												using = color_black_texture
												alpha = 0.5
												blend_mode = multiply
											}
	
											modify_texture = {
												visible = "[Province.IsRiskOfStarving]"
												using = color_yellow_texture
												alpha = 0.6
											}
	
											modify_texture = {
												visible = "[Province.IsStarving]"
												using = color_black_texture
												alpha = 0.5
												blend_mode = multiply
											}
	
											modify_texture = {
												visible = "[Province.IsStarving]"
												using = color_mid_red_texture
											}
										}
									}
								}
								blockoverride "subheader_unified_text_maxsize" { maximumsize = { 125 20 } }
								blockoverride "subheader_unified_top_text" {
									text = "game_concept_provincial_food"
									align = right|nobaseline
								}
	
								blockoverride "unified_icon_bottom_content" {
									spacing = 5
	
									text_single = { ### PROVINCE FOOD (GREEN IF POSITIVE)
										visible = "[GreaterThanOrEqualTo_CFixedPoint(Province.GetMonthlyFood, '(CFixedPoint)0')]"
										raw_text = "[Province.GetMonthlyFood|2+=]"
										align = right|nobaseline
										minimumsize = { -1 20 }
										maximumsize = { 45 20 }
										fontsize = 13
									}
	
									hbox = {
										visible = "[Not(GreaterThanOrEqualTo_CFixedPoint(Province.GetMonthlyFood, '(CFixedPoint)0'))]"
										text_single = { ### PROVINCE FOOD (WHITE IF LOCAL PRODUCTION IS NEGATIVE, BUT BUYING ENOUGH FROM MARKET)
											# raw_text = "[Add_float(FixedPointToFloat(Province.GetFoodFromMarket), FixedPointToFloat(Province.GetMonthlyFood))|+=2]"
											visible = "[GreaterThanOrEqualTo_float(
												Add_float(
													FixedPointToFloat(Province.GetFoodFromMarket), 
													FixedPointToFloat(Province.GetMonthlyFood)
												), 
												'(float)0'
											)]"
											raw_text = "[Province.GetMonthlyFood|2H]"
											align = right|nobaseline
											minimumsize = { -1 20 }
											maximumsize = { 45 20 }
											fontsize = 13
										}
										text_single = { ### PROVINCE FOOD (RED IF STOCKPILE IS DECREASING)
											visible = "[LessThan_float(
												Add_float(
													FixedPointToFloat(Province.GetFoodFromMarket), 
													FixedPointToFloat(Province.GetMonthlyFood)
												), 
												'(float)0'
											)]"
											raw_text = "[Province.GetMonthlyFood|2R]"
											align = right|nobaseline
											minimumsize = { -1 20 }
											maximumsize = { 45 20 }
											fontsize = 13
										}
									}
	
								}
							}
						}
					}
				}

				# LOCATION Info
				vbox = {
					layoutpolicy_horizontal = expanding
					margin_bottom = 5
					name = "location_production_content"
					datacontext = "[LocationProductionView.GetSelectedLocation]"
					# LOCATION FILTERED
					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 73 }

						hbox = {
							using = bg_market_card
							using = bg_cabinet_card_frame

							pp_location_card = {
								blockoverride "location_card_margins" {
									margin = {0 5}
									margin_left = 5
								}
							}

							location_card_right_buttons = {
								blockoverride "location_filter_middle_button" {
									vbox = {
										layoutpolicy_vertical = expanding
										spacing = 3

										filter_button_alt = {
											size = { 19 19 }
											blockoverride "filter_button_action" {
												action_tooltip = {
													click_type = left
													click_mode = single
													title = "TOGGLE_LOCATION_SELECTION"
													on_action = "[LocationProductionView.ToggleLocationProductionSelectLocation(PdxGuiWidget.FindParent('location_production_content').Self)]"
												}
											}
											tooltipwidget = { BasicFunctionalTooltip = {} }

											blockoverride "glow_visible" {
												visible = "[LocationProductionView.IsLocationProductionSelectLocationOpened(PdxGuiWidget.FindParent('location_production_content').Self)]"
											}
										}
									}
								}

								blockoverride "location_filter_next_button" {
									action_tooltip = {
										click_type = left
										click_mode = single
										enabled = "[CanSelectNextRelevantLocation(Location.Self)]"
										title = "SCROLL_DOWN_LOCATION_FILTER"
										on_action = "[ShowLocationProductionView(GetNextRelevantLocation(Location.Self).GetId, '(bool)no')]"
									}
								}

								blockoverride "location_filter_prev_button" {
									action_tooltip = {
										click_type = left
										click_mode = single
										enabled = "[CanSelectPrevRelevantLocation(Location.Self)]"
										title = "SCROLL_UP_LOCATION_FILTER"
										on_action = "[ShowLocationProductionView(GetPrevRelevantLocation(Location.Self).GetId, '(bool)no')]"
									}
								}
							}
						}
					}
				}

				filtered_sorted_list = {
					datacontext = "[LocationProductionView.GetBuildingsSortSearch.WithFilterTags('building')]"
					name = "location_production_filtered_list"

					blockoverride "subheader_upper_divider"{
						
					}

					blockoverride "custom_search_filter"{
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							margin = { 2 5 }
							datamodel = "[GetPopTypes]"
							datacontext = "[LocationProductionView.GetSelectedLocation]"
					
							item = {
								# ESTATES FILTERS
								estates_filter_button = {
									visible = "[ShowBuildingCardForLocation(Location.Self, PopType.Self)]"
									blockoverride "building_color" {
										color = "[PopType.GetColor]"
										alpha = 0.8
										blend_mode = overlay
									}
									blockoverride "estates_filter_button_action" {
										action_tooltip = {
											click_type = left
											click_mode = single
											on_action = "[SearchBar.ToggleFilterByKeyForceExclusive(PopType.GetKey)]"
											on_action = "[ShowLocationProductionView(Location.GetId, '(bool)no')]"
											# datacontext = "[PopType]"
											title = "TOGGLE_BUILDINGS_POP_TYPE"
										}
									}
									blockoverride "estates_filter_button_texture" {
										texture = "[GetGraphicalCultureTextureForCountryPopType(PopType.Self, Location.GetOwner.Self)]"
									}
									blockoverride "estates_filter_button_pin" {
										widget = {
											size = { 14 14 }
											datacontext = "[LocationProductionView.GetBuildingsSortSearch.GetSearchBar]"
											using = estates_filter_button_pin_overlay
										}
									}
									blockoverride "estates_filter_button_searchbar_datacontext" {
										datacontext = "[LocationProductionView.GetBuildingsSortSearch.GetSearchBar]"
									}
								}
							}
						}
					}

					blockoverride "scroll_list_is_empty" {
						visible = "[And(IsDataModelEmpty(LocationProductionView.GetBuildingItems), LocationProductionView.Vars.NotExistOrHasValue( 'display', 'lists' ))]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "BUILDINGS_SCROLL_LIST_EMPTY"
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							onclick = "[GetVariableSystem.Clear('pp_build_payback_order')]" # PP: a sort leaves the payback order
							name = "name"
							layoutpolicy_vertical = expanding
							size = { 220 -1 }
						}

						expand = {} # PP: the value buttons sit over their columns

						sort_by_key_button = {
							onclick = "[GetVariableSystem.Clear('pp_build_payback_order')]" # PP: a sort leaves the payback order
							size = { 70 -1 }
							name = "production_efficiency"
							layoutpolicy_vertical = expanding
							blockoverride "sort_by_key_button_texture" {
								texture = "gfx/interface/icons/sort/efficiency.dds"
							}
						}
		
						widget = { # PP: build cost (no engine sort key in this list)
							layoutpolicy_vertical = expanding
							size = { 60 -1 }
							tooltip = "PP_BUILD_COST_HEADER_TT"
							icon = {
								size = { 20 20 }
								parentanchor = center
								texture = "gfx/interface/icons/sort/cost.dds"
							}
						}

						button = { # PP: payback order (no engine sort key: the list is drawn in payback bands)
							name = "pp_payback_order"
							layoutpolicy_vertical = expanding
							size = { 55 -1 }
								down = "[GetVariableSystem.Exists('pp_build_payback_order')]"
							background = {
								visible = "[GetVariableSystem.Exists('pp_build_payback_order')]"
								texture = "gfx/interface/component_masks/mask_fade_vertical_up.dds"
								texture_density = 2
								alpha = 0.4
								modify_texture = {
									using = color_sortby_off
									blend_mode = multiply
								}
							}
							onclick = "[GetVariableSystem.Toggle('pp_build_payback_order')]"
							tooltip = "PP_BUILD_PAYBACK_ORDER_TT"
							icon = {
								size = { 20 20 }
								parentanchor = center
								texture = "gfx/interface/icons/sort/time.dds"
							}
						}

						sort_by_key_button = {
							onclick = "[GetVariableSystem.Clear('pp_build_payback_order')]" # PP: a sort leaves the payback order
							name = "profit"
							layoutpolicy_vertical = expanding
							size = { 60 -1 }
						}

						sort_by_key_button = {
							onclick = "[GetVariableSystem.Clear('pp_build_payback_order')]" # PP: a sort leaves the payback order
							name = "income"
							layoutpolicy_vertical = expanding
							size = { 65 -1 }
						}
						
						sort_by_key_button = {
							onclick = "[GetVariableSystem.Clear('pp_build_payback_order')]" # PP: a sort leaves the payback order
							name = "level"
							layoutpolicy_vertical = expanding
							size = { 125 -1 }
						}
					}

					blockoverride "scroll_list_layout" { # PP: the selected sort or the payback order
						flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							fixedgridbox = { # the selected sort: vanilla's grid
								visible = "[And(And( LocationProductionView.Vars.NotExistOrHasValue( 'display', 'lists' ), LocationProductionView.IsLocationFilterEnabled ), Not(GetVariableSystem.Exists('pp_build_payback_order')))]"
								addrow = 65
								addcolumn = 930
								datamodel = "[LocationProductionView.GetBuildingItems]"
								item = {
									widget = {
										size = { 930 60 }
										hbox = {
											pp_location_filtered_header_with_candidate = {
												using = layoutpolicy_expanding
												blockoverride "location_filtered_header_with_candidate_visible" {
													visible = "[And(LocationProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
												}
											}
											pp_location_filtered_header_no_candidate = {
												using = layoutpolicy_expanding
												blockoverride "location_filtered_header_no_candidate_visible" {
													visible = "[And(LocationProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
												}
												blockoverride "location_context"
												{
													datacontext = "[LocationProductionView.GetSelectedLocation]"
												}
											}
										}
									}
								}
							}
							flowcontainer = { # payback order: shortest first, the last sort inside each band
								direction = vertical
								ignoreinvisible = yes
								visible = "[And(And( LocationProductionView.Vars.NotExistOrHasValue( 'display', 'lists' ), LocationProductionView.IsLocationFilterEnabled ), GetVariableSystem.Exists('pp_build_payback_order'))]"
								flowcontainer = { # payback 0 to 1 years
									direction = vertical
									ignoreinvisible = yes
									datamodel = "[LocationProductionView.GetBuildingItems]"
									item = {
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datacontext = "[BuildingItem.GetBuildingType]"
											datacontext = "[LocationProductionView.GetSelectedLocation]"
											datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), '0'), '(int32)1', '(int32)0'))]"
											item = {
												widget = {
													size = { 930 65 }
													widget = {
														size = { 930 60 }
														hbox = {
															pp_location_filtered_header_with_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_with_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
																}
															}
															pp_location_filtered_header_no_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_no_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
																}
																blockoverride "location_context"
																{
																	datacontext = "[LocationProductionView.GetSelectedLocation]"
																}
															}
														}
													}
												}
											}
										}
									}
								}
								flowcontainer = { # payback 1 to 2 years
									direction = vertical
									ignoreinvisible = yes
									datamodel = "[LocationProductionView.GetBuildingItems]"
									item = {
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datacontext = "[BuildingItem.GetBuildingType]"
											datacontext = "[LocationProductionView.GetSelectedLocation]"
											datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), '1'), '(int32)1', '(int32)0'))]"
											item = {
												widget = {
													size = { 930 65 }
													widget = {
														size = { 930 60 }
														hbox = {
															pp_location_filtered_header_with_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_with_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
																}
															}
															pp_location_filtered_header_no_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_no_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
																}
																blockoverride "location_context"
																{
																	datacontext = "[LocationProductionView.GetSelectedLocation]"
																}
															}
														}
													}
												}
											}
										}
									}
								}
								flowcontainer = { # payback 2 to 3 years
									direction = vertical
									ignoreinvisible = yes
									datamodel = "[LocationProductionView.GetBuildingItems]"
									item = {
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datacontext = "[BuildingItem.GetBuildingType]"
											datacontext = "[LocationProductionView.GetSelectedLocation]"
											datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), '2'), '(int32)1', '(int32)0'))]"
											item = {
												widget = {
													size = { 930 65 }
													widget = {
														size = { 930 60 }
														hbox = {
															pp_location_filtered_header_with_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_with_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
																}
															}
															pp_location_filtered_header_no_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_no_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
																}
																blockoverride "location_context"
																{
																	datacontext = "[LocationProductionView.GetSelectedLocation]"
																}
															}
														}
													}
												}
											}
										}
									}
								}
								flowcontainer = { # payback 3 to 4 years
									direction = vertical
									ignoreinvisible = yes
									datamodel = "[LocationProductionView.GetBuildingItems]"
									item = {
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datacontext = "[BuildingItem.GetBuildingType]"
											datacontext = "[LocationProductionView.GetSelectedLocation]"
											datamodel = "[DataModelRepeatedItem(Select_int32(GetVariableSystem.HasValue(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), '3'), '(int32)1', '(int32)0'))]"
											item = {
												widget = {
													size = { 930 65 }
													widget = {
														size = { 930 60 }
														hbox = {
															pp_location_filtered_header_with_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_with_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
																}
															}
															pp_location_filtered_header_no_candidate = {
																using = layoutpolicy_expanding
																blockoverride "location_filtered_header_no_candidate_visible" {
																	visible = "[And(LocationProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
																}
																blockoverride "location_context"
																{
																	datacontext = "[LocationProductionView.GetSelectedLocation]"
																}
															}
														}
													}
												}
											}
										}
									}
								}
