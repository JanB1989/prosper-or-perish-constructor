# Prosper or Perish: the welcome situation panel (hand-kept). The game opens gui/panels/situation/<situation key>.gui
# when the player clicks a situation. An introduction, one button that opens the Prosper or Perish section of the
# Europedia (encyclopedia_lateralview.gui shows it when pp_encyclopedia_active is yes; pp_filter picks its cards) and
# one that dismisses the welcome for good (two buttons: players and observers).
# Built like harvest_situation.gui; texts PP_WELCOME_SIT_* in pp_situations_l_english.yml, no numbers;
# tests/test_welcome_situation_panel.py.

situation_panel = {

	##################################### MAIN IMAGE #####################################

	# a growing town (tools/build_harvest_situation_art.py), the Population Growth card's painting
	blockoverride "situation_panel_image" {
		background = {
			texture = "gfx/interface/illustrations/situation/pp_mod_welcome_situation.dds"
		}

		using = scene_fade_vertical_up
	}

	# the welcome stays until the player closes it: no start date banner over the picture
	blockoverride "situation_start_date" {}

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	# no actions: vanilla's action list evaluates every situation action with the player as actor
	blockoverride "situation_panel_main_actions" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 14
			margin_bottom = 10
			# one of the two dismiss buttons is hidden
			ignoreinvisible = yes

			text_multi = {
				max_width = 480
				min_width = 480
				autoresize = yes
				margin = { 10 4 }
				align = hcenter|nobaseline
				using = Font_Type_Flavor
				fontsize = 15
				text = "PP_WELCOME_SIT_LEAD"
			}

			text_multi = {
				max_width = 460
				min_width = 460
				autoresize = yes
				margin = { 10 0 }
				text = "PP_WELCOME_SIT_BODY"
			}

			# the call to action: the Europedia opens on the Prosper or Perish section, all cards
			button_regular = {
				size = { 360 44 }
				text = "PP_WELCOME_SIT_CTA"
				onclick = "[OpenLateralView('encyclopedia')]"
				onclick = "[GetVariableSystem.Set('pp_encyclopedia_active', 'yes')]"
				onclick = "[GetVariableSystem.Set('pp_filter', 'all')]"
				tooltip = "PP_WELCOME_SIT_CTA_TT"
			}

			# for players who know the Europedia: ends the welcome for good (scripted_guis/pp_welcome_situation.txt)
			# and closes the panel; the scripted GUI is a game command, so it reaches every machine in multiplayer
			button_regular = {
				visible = "[Not(IsPlayerObserver)]"
				size = { 360 36 }
				text = "PP_WELCOME_SIT_DISMISS"
				onclick = "[GetScriptedGui('pp_dismiss_welcome_situation').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[LateralView.Close]"
				tooltip = "PP_WELCOME_SIT_DISMISS_TT"
			}

			# the same for an observer: the game drops every game command an observer sends, scripted GUIs included
			# (the click only closed the panel, 2026-10-24), so this one runs the effect through the console, which
			# an observer may use in a single player game that is not ironman
			button_regular = {
				visible = "[IsPlayerObserver]"
				size = { 360 36 }
				text = "PP_WELCOME_SIT_DISMISS"
				onclick = "[ExecuteConsoleCommand('effect end_situation = situation:pp_mod_welcome_situation')]"
				onclick = "[LateralView.Close]"
				tooltip = "PP_WELCOME_SIT_DISMISS_TT"
			}
		}
	}
}
