
template goods_market_import_tariff_overlay {
	icon = {
		position = { -3 3 }
		parentanchor = bottom|left
		size = { 10 10 }
		alpha = 0.8
		texture = "gfx/interface/icons/flat_icons/circle_flat_icon.dds"
		visible = "[Market.HasImportTariff(Goods.Self)]"
		modify_texture = {
			using = color_super_dark_brown_texture
			blend_mode = normal
		}
		glow = {
			name = "drop_shadow"
			glow_radius = 2
			color = {0.0 0.0 0.0 1.0}
			alpha = 0.5
		}
	}

	icon = {
		position = { -3 3 }
		parentanchor = bottom|left
		size = { 10 10 }
		texture = "gfx/interface/icons/flat_icons/trade_market/tariff_small.dds"
		visible = "[Market.HasImportTariff(Goods.Self)]"
	}

	icon = {
		position = { -3 3 }
		parentanchor = bottom|left
		size = { 12 12 }
		alpha = 0.8
		texture = "gfx/interface/icons/flat_icons/circle_flat_icon.dds"
		visible = "[Market.HasImportSubvention(Goods.Self)]"
		modify_texture = {
			using = color_light_blue_texture
			blend_mode = normal
		}
		glow = {
			name = "drop_shadow"
			glow_radius = 2
			color = {0.0 0.0 0.0 1.0}
			alpha = 0.5
		}
	}
	icon = {
		position = { -3 3 }
		parentanchor = bottom|left
		size = { 10 10 }
		texture = "gfx/interface/icons/flat_icons/trade_market/subvention_small.dds"
		visible = "[Market.HasImportSubvention(Goods.Self)]"
	}
}

