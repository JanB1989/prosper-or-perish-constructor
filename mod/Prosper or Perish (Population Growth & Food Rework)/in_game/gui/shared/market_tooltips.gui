template GoodsOnMarket_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[GoodsOnMarketWrap.GetName]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/advances_panel/market_price.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "concept_link" {
			text = "[market_price|e]"
		}
		blockoverride "tooltip_content" {
			TooltipListBase = {
				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
					blockoverride "section_content" {
						TooltipListColumnContent = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							
							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" { text = "[goods|e]" }
								blockoverride "column_title_right" { expand = {} }

								blockoverride "field_left" {
									icon = {
										size = { 24 24 }
										texture = "[GetGoodsIcon(GoodsDemandEntry.GetGoods)]"
									}
								}

								blockoverride "field_text" {
									default_format = "#subtle_name"
									raw_text = "[GoodsDemandEntry.GetGoods.GetNameWithNoTooltip]"
								}

								blockoverride "field_right" { expand = {} }
							}

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" { text = "MONTHLY_CHANGE" }
								blockoverride "column_title_right" { expand = {} }

								blockoverride "field_text" {
									raw_text = "[GoodsDemandEntry.GetValue|=] [GoodsDemandEntry.GetValueLabel]"
								}

								blockoverride "field_left" {}
								blockoverride "field_right" { expand = {} }
							}

							TooltipTableColumn = {
								blockoverride "column_title" {}
								blockoverride "column_title_text" { text = "BALANCE_TEXT" }
								blockoverride "column_title_left" { expand = {} }

								blockoverride "field_left" { expand = {} }
								blockoverride "field_text" {
									datacontext = "[GoodsOnMarketWrap.GetMarket]"
									datacontext = "[GoodsOnMarketWrap.GetMarket.GetMarketEntry(GoodsDemandEntry.GetGoods)]"
									raw_text = "[GoodsDemandEntry.GetMarketBalance(Market.Self)|+=2] @button_simple! [GoodsDemandEntry.GetProjectedMarketBalance(Market.Self)|+=2]@balance!"
									tooltipwidget = { using = goods_market_balance_tooltip }
								}
							}

							blockoverride "column_datamodel" { datamodel = "[GoodsOnMarketWrap.GetDemand.GetEntries]" }
						}
					}
				}
			}
		}
	}
}

