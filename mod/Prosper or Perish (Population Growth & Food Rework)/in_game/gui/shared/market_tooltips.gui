template market_hub_trade_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "MERCHANT_CAPACITY_TT_HEADER"
		}

		blockoverride "title_icon" {
			icon = {
				size = { 32 32 }
				texture = "gfx/interface/icons/flat_icons/trade_capacity.dds"
			}
		}

		blockoverride "concept_link" {
			text = [trade|e]
		}

		blockoverride "title_button" {
            hint_button = {
				visible = "[GreaterThan_CFixedPoint(Market.GetMerchantAvailableCapacity(Player.Self),'(CFixedPoint)0.01')]"
                action_tooltip = {
                    title = "OPEN_HINT"
                    on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_unused_trade_capacity')]"
                }
            }
        }

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[GreaterThan_CFixedPoint(Market.GetAvailableTradeCapacity(Player.Self),'(CFixedPoint)0.01')]"
				blockoverride "text" {
					text = "MERCHANT_CAPACITY_TT_ALERT_YELLOW"
				}

				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_yellow_texture
					}
				}
			}

			TooltipListBase = { ### TC
				visible = "[GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0')]"
				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "MERCHANT_CAPACITY_LIST_ENTRY"
							}
							text_single = {
								autoresize = yes
								raw_text = "[Market.GetTotalMerchantCapacity(Player.Self)|2L]@trade_capacity!"
								tooltipwidget = {
									using = merchant_capacity_tooltip
								}
							}
						}
					}
				}
			}
			
			TooltipScrolledStringPairList = {
				visible = "[Not(IsMarketInRange(Market.Self))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 120 } }
				textcontext = "[GetMarketRangeInfo(Market.Self)]"
			}	
			
			TooltipTextBlock = {
				visible = "[And(IsMarketInRange(Market.Self), Not(GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0')))]"
				blockoverride "text" {
					text = "[Market.GetMerchantCapacityInfo(Player.Self)]"
				}
			}
			
			TooltipListBase = { ### TC
				visible = "[GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0')]"
				TooltipListRowContent = {
					datacontext = "[Market.GetMerchant(Player.Self)]"
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "MARKET_HUB_TC_BUTTON_TOTAL_PROFIT"
							}
							text_single = {
								autoresize = yes
								raw_text = "[Merchant.GetProjectedTradeProfit|2+=]@gold! ([Merchant.GetProjectedTradeIncome|2+=]@income!)"

								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												size = { 48 48 }
												texture = "[GetConceptTexture('trade_profit')]"
											}
										}
										blockoverride "title_text" {
											text = "[trade_profit]"
										}
										blockoverride "concept_link" {
											text = "[trade_profit|e]"
										}
										blockoverride "tooltip_content" {
											TooltipTextBlock = {
												blockoverride "text" {
													text = "MARKET_HUB_TC_BUTTON_PROFIT"
												}
											}
										}
									}
								}
							}
						}
					}
					TooltipManualTableField = {
						visible = "[GreaterThan_CFixedPoint(Merchant.GetUsedCapacity,'(CFixedPoint)0')]"
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "MARKET_HUB_TC_BUTTON_PROFIT_PER_TC"
							}
							text_single = {
								autoresize = yes
								tagtooltip_enabled = yes
								raw_text = "[Merchant.GetAverageTradeCapacityProfitInfo]"
							}
						}
					}
				}
			}
			
			TooltipScrolledStringPairList = {
				blockoverride "block_title" {
					text = "TRADE_PROFIT_GROUPED_BY_GOOD_TT_TTILE"
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 300 }}
				textcontext = "[Merchant.GetCountry.GetTradeByGoodForCountryInfo(Merchant.GetMarket)]"
			}
					
			
			# TooltipTextBlock = {
			# 	visible = "[GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0')]"
			# 	blockoverride "text" {
			# 		text = "Our Trades in this market generate a profit of [Merchant.GetTotalTradeProfit|+=2]@gold!"
			# 	}
			# }

			# TooltipTextBlock = {
			# 	visible = "[Not(IsMarketInRange(Market.Self))]"
			# 	blockoverride "text" {
			# 		text = "MERCHANT_CAPACITY_TT_OUT_OF_RANGE"
			# 	}
			# }

			# TooltipTextBlock = {
			# 	visible = "[GreaterThan_int32(Market.GetMerchantRanking(Player.Self), '(int32)0')]"
			# 	blockoverride "text" {
			# 		text = "MERCHANT_POWER_HUB_TT"
			# 	}
			# }
		}
	}
}

