					texture_density = 2
				}
				blockoverride "any_good_card_label" {
					text = "TRADE_ORDER_CREATE_FROM_POP_NEED"
				}
				blockoverride "any_good_card_tooltip" {
					tooltipwidget = { using = trade_order_pop_need_tooltip }
				}
				blockoverride "any_good_card_action" {
					action_tooltip = {
						click_type = left
						click_mode = single
						title = "TRADE_ORDER_CREATE_FROM_POP_NEED"
						description = "TRADE_ORDER_ANY_POP_NEED_TT"
						enabled = "[CanOpenTradeOrderForNeed(MarketCountryNeeds.GetMarket, '(int32)3')]"
						conditions = "[AddLocalizationIf(Not(HasTradeCapacityInMarket(MarketCountryNeeds.GetMarket)), 'TRADE_ORDER_NO_TC_IN_MARKET_TT')]"
						conditions = "[MakeItFailIfLoc(HasExistingTradeOrderForNeed(MarketCountryNeeds.GetMarket, '(int32)3'), 'TRADE_ORDER_CREATE_ALREADY_EXISTS_TT')]"
						on_action = "[OpenTradeOrderForNeed(MarketCountryNeeds.GetMarket, '(int32)3')]"
					}

					action_tooltip = {
						click_modifier = shift
