template goods_market_imports_tooltip {
	ContextualTooltipType = {
		datacontext = "[GoodsMarketEntry.GetGoods]"
		blockoverride "title_icon" {
			button = {
				using = tooltip_title_icon_size
				texture = "[GetGoodsIcon(Goods.Self)]"
				tooltipwidget = { 
					using = Goods_tooltip
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					title = "OPEN_GOOD_PANEL"
					on_action = "[ShowGoods(Goods.Self)]"
				}
			}
		}
	
		blockoverride "title_text" {
			text = "MARKET_GOOD_IMPORTS_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [imports|e]
		}
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[And(Not(GreaterThan_CFixedPoint(Market.GetLastMonthImportByCountryTotal(Goods.Self),'(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Market.GetForecastImportTotal(Goods.Self),'(CFixedPoint)0')))]"
				blockoverride "text" {
					text = "MARKET_GOOD_IMPORTS_TT_TEXT"
				}
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 420 }}
				visible = "[GreaterThan_CFixedPoint(Market.GetLastMonthImportByCountryTotal(Goods.Self),'(CFixedPoint)0')]"
				blockoverride "block_title" {
					text = "MARKET_GOOD_IMPORTS_TT_LIST_TITLE"
				}
				lowpriotextcontext = "[Market.GetLastMonthImportByCountryInfo(Goods.Self)]"
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 420 }}
				visible = "[GreaterThan_CFixedPoint(Market.GetForecastImportTotal(Goods.Self),'(CFixedPoint)0')]"
				blockoverride "block_title" {
					text = "MARKET_GOOD_IMPORTS_TT_FORECAST_TITLE"
				}
				lowpriotextcontext = "[Market.GetSupplyInfoOnlyTrade(Goods.Self)]"
			}

			TooltipTextBlock = {
				visible = "[Or(Market.HasImportTariff(Goods.Self), Market.HasImportSubvention(Goods.Self))]"
				blockoverride "text" {
					text = "[Market.GetImportTariffInfo(Goods.Self)]"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_blue_texture
					}
				}
			}

			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 220 }}
				visible = "[And(Or(Market.HasImportTariff(Goods.Self), Market.HasImportSubvention(Goods.Self)), Market.HasTariffExemptCountries)]"
				lowpriotextcontext = "[Market.GetTariffExemptCountriesInfo]"
			}
		}
	}
}

template goods_market_exports_tooltip {
	ContextualTooltipType = {
		datacontext = "[GoodsMarketEntry.GetGoods]"
		blockoverride "title_icon" {
			button = {
				using = tooltip_title_icon_size
				texture = "[GetGoodsIcon(Goods.Self)]"
				tooltipwidget = { 
					using = Goods_tooltip
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					title = "OPEN_GOOD_PANEL"
					on_action = "[ShowGoods(Goods.Self)]"
				}
			}
		}
	
		blockoverride "title_text" {
			text = "MARKET_GOOD_EXPORTS_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [exports|e]
		}
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[And(Not(GreaterThan_CFixedPoint(Market.GetLastMonthExportByCountryTotal(Goods.Self),'(CFixedPoint)0')), Not(GreaterThan_CFixedPoint(Market.GetForecastExportTotal(Goods.Self),'(CFixedPoint)0')))]"
				blockoverride "text" {
					text = "MARKET_GOOD_EXPORTS_TT_TEXT"
				}
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 240 }}
				visible = "[GreaterThan_CFixedPoint(Market.GetLastMonthExportByCountryTotal(Goods.Self),'(CFixedPoint)0')]"
				blockoverride "block_title" {
					text = "MARKET_GOOD_EXPORTS_TT_LIST_TITLE"
				}
				lowpriotextcontext = "[Market.GetLastMonthExportByCountryInfo(Goods.Self)]"
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 240 }}
				visible = "[GreaterThan_CFixedPoint(Market.GetForecastExportTotal(Goods.Self),'(CFixedPoint)0')]"
				blockoverride "block_title" {
					text = "MARKET_GOOD_EXPORTS_TT_FORECAST_TITLE"
				}
				lowpriotextcontext = "[Market.GetTradeDemandInfo(Goods.Self)]"
			}

			TooltipTextBlock = {
				visible = "[Or(Market.HasExportTariff(Goods.Self), Market.HasExportSubvention(Goods.Self))]"
				blockoverride "text" {
					text = "[Market.GetExportTariffInfo(Goods.Self)]"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_blue_texture
					}
				}
			}

			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 220 }}
				visible = "[And(Or(Market.HasExportTariff(Goods.Self), Market.HasExportSubvention(Goods.Self)), Market.HasTariffExemptCountries)]"
				lowpriotextcontext = "[Market.GetTariffExemptCountriesInfo]"
			}
		}
	}
}


