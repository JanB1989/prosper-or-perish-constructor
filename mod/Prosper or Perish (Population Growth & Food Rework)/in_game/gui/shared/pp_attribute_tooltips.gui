template pp_attribute_tooltip_winter {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = {
                using = tooltip_title_icon_size
                texture = "[GetWinterIcon(Location.Self)]"
            }
        }

        blockoverride "title_text" {
            text = "[Location.GetWinterName]"
        }

        blockoverride "concept_link" {
            text = [winter|E]
        }

        blockoverride "tooltip_content" {

            pp_attribute_view_winter = {}
            TooltipStringPairList = {
                visible = "[EqualTo_string(LocationView.GetLocation.Custom('pp_tt_winter'), Localize('PP_TT_KEY_NONE'))]"
                textcontext = "[Location.GetWinterDetails]"
            }

			TooltipContentSection = {
				using = tooltip_location_alt_content
			}
        }
    }
}

types pp_attribute_tooltips
{
	type pp_goods_output_table = TooltipListBase {
		blockoverride "block_title" { text = "PP_TT_GOODS_OUTPUT" }
		vbox = {
			layoutpolicy_horizontal = expanding
			block "rows" {}
		}
	}

	type pp_goods_output_row = TooltipManualTableField {
		blockoverride "field_margin" { margin = { 10 0 } spacing = 4 }
		blockoverride "field_content" {
			block "cells" {}
			expand = {}
		}
	}

	# fixed width, so the values line up in columns
	type pp_goods_output_cell = widget {
		size = { 70 30 }
		background = {
			using = bg_round_corners
			alpha = 0.6
			block "highlight" { visible = no }
		}
		icon = {
			size = { 24 24 }
			position = { 2 3 }
			block "good_icon" {}
		}
		text_single = {
			using = text_single_template
			position = { 29 7 }
			block "good_value" {}
		}
	}

	# goods that share a value: the value once, then their icons
	type pp_goods_output_group_row = TooltipManualTableField {
		blockoverride "field_margin" { margin = { 10 0 } spacing = 6 }
		blockoverride "field_content" {
			text_single = {
				using = text_single_template
				autoresize = no
				size = { 48 30 }
				align = right|nobaseline
				block "group_value" {}
			}
			hbox = {
				spacing = 2
				block "group_icons" {}
			}
			expand = {}
		}
	}

	type pp_land_potential_tier = TooltipListBase {
		blockoverride "block_title" { block "tier_title" {} }
		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 8 2 }
			block "tier_lines" {}
		}
	}

	# fixed width, so the values line up in columns
	type pp_land_potential_cell = widget {
		size = { 56 28 }
		background = {
			using = bg_round_corners
			alpha = 0.9
			block "highlight" { visible = no }
		}
		icon = {
			size = { 22 22 }
			position = { 2 3 }
			block "good_icon" {}
		}
		text_single = {
			using = text_single_template
			position = { 26 6 }
			block "good_value" {}
		}
	}

