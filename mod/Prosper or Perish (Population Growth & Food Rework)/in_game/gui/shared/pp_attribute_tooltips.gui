types pp_attribute_tooltips
{
	type pp_goods_output_table = TooltipListBase {
		blockoverride "block_title" { text = "PP_TT_GOODS_OUTPUT" }
		vbox = {
			layoutpolicy_horizontal = expanding
			block "rows" {}
		}
	}

	type pp_goods_output_row = TooltipManualTableField {
		blockoverride "field_margin" { margin = { 10 0 } spacing = 4 }
		blockoverride "field_content" {
			block "cells" {}
			expand = {}
		}
	}

	# fixed width, so the values line up in columns
	type pp_goods_output_cell = widget {
		size = { 70 30 }
		icon = {
			size = { 24 24 }
			position = { 0 3 }
			block "good_icon" {}
		}
		text_single = {
			using = text_single_template
			position = { 27 7 }
			block "good_value" {}
		}
	}

