# Generated by tools/port_vanilla_gui.py (INTERNAL_GOODS): the mod's internal goods are pinned at their price
# floor and never traded, so the market, the ledgers, the market tooltip and the trade-order picker skip them.
# Needs a Goods context; the lists that use it lay out visible items only (vbox, dynamicgridbox with
# ignoreinvisible).
template pp_hide_internal_goods {
	visible = "[Not(Or(Or(EqualTo_string(Goods.GetKey, 'offset'), EqualTo_string(Goods.GetKey, 'logistics')), Or(EqualTo_string(Goods.GetKey, 'local_food'), EqualTo_string(Goods.GetKey, 'province_food_sales'))))]"
}

types PPInternalGoods {
	type pp_GoodsMarketTableColumn = vbox { # PP: vanilla TooltipTableColumn, rows without the internal goods
		layoutpolicy_horizontal = expanding

		TooltipTableField = {
			block "column_title" {
				visible = no
			}

			blockoverride "field_background" {
				background = {
					using = tile_background_squared_texture
					frame_grid = { 1 2 }
					spriteborder_bottom = 0
					alpha = 0.4
					modify_texture = {
						using = color_turquoise_texture
					}
				}
			}

			blockoverride "field_content" {
				block "column_title_left" {}

				text_single = {
					using = Font_Type_Headers
					block "column_title_text" {}
				}

				block "column_title_right" {}
			}
		}

		scrollarea = { # the first 5 visible rows (vanilla TooltipListScrollArea; a scrollvbox takes no scrollbar policy)
			layoutpolicy_horizontal = expanding
			maximumsize = { -1 150 }
			autoresizescrollarea = yes
			autoresizeviewport = yes
			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = always_off

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					block "column_datamodel" {}

					item = {
							TooltipTableField = {
								blockoverride "visibility" {
									datacontext = "[GoodsMarketEntry.GetGoods]"
									using = pp_hide_internal_goods
								}
								blockoverride "field_content" {
									block "table_field_margin" {
										margin = { 10 0 }
									}
									spacing = 5

									block "field_left" {}

									block "tooltip_table_text_single" {
										text_single = {
											block "field_text_visibility" {}
											block "field_text" {}
										}
									}

									block "field_right" {}
								}
							}
					}
				}
			}
		}
	}
}
