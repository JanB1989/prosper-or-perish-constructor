# Generated by tools/port_vanilla_gui.py (INTERNAL_GOODS): the mod's internal goods are pinned at their price
# floor and never traded, so the market, the ledgers and the trade-order picker skip them. Needs a Goods context;
# the lists that use it lay out visible items only (vbox, dynamicgridbox with ignoreinvisible).
template pp_hide_internal_goods {
	visible = "[Not(Or(Or(EqualTo_string(Goods.GetKey, 'offset'), EqualTo_string(Goods.GetKey, 'logistics')), Or(EqualTo_string(Goods.GetKey, 'local_food'), EqualTo_string(Goods.GetKey, 'province_food_sales'))))]"
}
