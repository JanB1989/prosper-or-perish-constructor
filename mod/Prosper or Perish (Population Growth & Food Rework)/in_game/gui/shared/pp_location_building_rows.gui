# Generated by tools/port_vanilla_gui.py (port_location_rows): the location view's building rows with the
# build panel's layout (slots and efficiencies two per column, build cost, payback, profit, tax income) and
# the payback band recorder. pp_ copies: CMF re-declares the vanilla types.
types PPLocationBuildingRows {
	type pp_location_filtered_header_with_candidate = hbox {
		# !!! for performance, it's important that location_filtered_header_with_candidate and location_filtered_header_no_candidate have the same size !!!
		block "location_filtered_header_with_candidate_visible" {
			visible = "[And(ProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
		}
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes

		datamodel = "[BuildingItem.GetBuildingCandidates]"
		item = {
			widget = {
				size = { -1 60 }
				layoutpolicy_horizontal = expanding

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					using = bg_cabinet_card_frame
					margin = {2 5}
					margin_right = 4
					margin_bottom = 3

					datacontext = "[BuildingCandidate.GetBuilding]"
					datacontext = "[Building.GetType]"
					datacontext = "[Building.GetLocation]"

					widget = { # PP: records this row's payback band (read by the payback order)
						size = { 0 0 }
						ignore_layout = yes
						datacontext = "[BuildingCandidate.GetLocationToBuildItem]"
						widget = {
							visible_at_creation = no
							visible = "[And(LocationToBuildItem.HasConstructedBuildingLevels, IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions)))]"
							size = { 0 0 }
							state = {
								name = _show
								on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
							}
						}
						widget = {
							visible_at_creation = no
							visible = "[And(LocationToBuildItem.HasConstructedBuildingLevels, Not(IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions))))]"
							size = { 0 0 }
							state = {
								name = _show
								on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
							}
						}
						widget = {
							visible_at_creation = no
							visible = "[And(Not(LocationToBuildItem.HasConstructedBuildingLevels), IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions)))]"
							size = { 0 0 }
							state = {
								name = _show
								on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
							}
						}
						widget = {
							visible_at_creation = no
							visible = "[And(Not(LocationToBuildItem.HasConstructedBuildingLevels), Not(IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions))))]"
							size = { 0 0 }
							state = {
								name = _show
								on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
							}
						}
					}

					# icon
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						layoutstretchfactor_horizontal = 1

						using = bg_building_card_colors
						blockoverride "building_color" {
							color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
							alpha = 0.7
							blend_mode = overlay
						}
						ignoreinvisible = yes

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							icon = {
								size = {100% 100%}
								ignore_layout = yes
								visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
								using = color_black_texture
								alpha = 0.2
							}

							vbox = {
								card_header_button_04 = {
									size = { 55 -1 }
									layoutpolicy_vertical = expanding
									datacontext = "[BuildingItem.GetBuildingType]"

									action_tooltip = {
										click_type = left
										click_mode = single
										title = "OPEN_PROD_METHOD_BUILDING_ITEM_LOCATION"
										on_action = "[BuildingCandidate.ShowBuilding]"
									}
			
									action_tooltip = {
										click_type = right
										click_mode = single
										title = "BUILD_BUILDING"
										on_action = "[SelectLocationToBuildDefault(BuildingItem.GetBuildingType)]"
									}
								
									tooltipwidget = {
										using = Building_tooltip
									}
									piechart = {
										using = bg_circle
										size = { 36 36 }
										parentanchor = center
										datacontext = "[BuildingCandidate.GetBuilding]"
										using = piechart_angles

										using = building_employment_piechart_data

										icon = {
											size = { 55% 55% }
											parentanchor = center
											texture = "[GetBuildingIcon(BuildingItem.GetBuildingType.Self)]"
											glow = {
												name = "drop_shadow"
												glow_radius = 3
												color = {0.0 0.0 0.0 1.0}
												alpha = 0.3
											}
										}
										sort_by_highlight = {
											name = "name"
										}
									}
								}
							}

							icon = {
								position = { 0 -2 }
								parentanchor = hcenter
								using = warning_icon_texture
								size = { 15 15 }
								visible = "[BuildingItem.HasBuildingsLackingInput]"
								using = bg_circle
							}

							widget = {
								size = { 22 14 }
								parentanchor = bottom|left
								position = { 2 -2 }
								visible = "[BuildingCandidate.IsForeign]"
								datacontext = "[BuildingCandidate.GetBuilding.GetOwner]"

								country_flag_mini = {
									parentanchor = center
								}
							}
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						layoutstretchfactor_horizontal = 8
						ignoreinvisible = yes
						spacing = 0

						widget = {
							layoutpolicy_horizontal = expanding
							size = { -1 50 }

							tooltipwidget = {
								using = Building_tooltip
							}

							using = bg_building_card_colors
							blockoverride building_color_card_margins {}
							blockoverride building_color_grey_margins {}
							blockoverride "building_main_texture" {
								using = color_grey_texture
							}
							blockoverride "building_color" {
								color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
								alpha = 0.7
								blend_mode = overlay
							}

							icon = {
								size = {100% 100%}
								visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
								using = color_black_texture
								alpha = 0.2
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								maximumsize = { -1 50 }
								ignoreinvisible = yes
								spacing = 6
								margin_left = 3
								margin_right = 3

								vbox = { #name
									spacing = 4
									margin_top = 1

									hbox = {
										size = {-1 15}
										layoutpolicy_horizontal = expanding

										text_single = {
											autoresize = no
											size = { 120 15 }
											align = left|nobaseline
											default_format = "#yellow_titles"
											text = "[BuildingCandidate.GetBuilding.GetName]"
											datacontext = "[BuildingCandidate.GetBuilding]"
											tooltipwidget = {
												using = Building_tooltip
											}
										}

										expand = {}
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 3
										maximumsize = {-1 15}
										datacontext = "[BuildingType.GetPopType]"

										text_single = {
											autoresize = yes
											align = left|nobaseline
											fontsize = 14
											raw_text = "[BuildingCandidate.GetBuilding.GetEmploymentSize]/[BuildingCandidate.GetBuilding.GetMaxWorkersRequired]"
											# default_format = "#W"
											datacontext = "[BuildingCandidate.GetBuilding]"
											tooltipwidget = {
												using = Building_tooltip
											}
										}
										icon = {
											size = { 12 12 }
											texture = "[GetGraphicalCultureTextureForCountryPopType(PopType.Self, Location.GetOwner.Self)]"
											glow = {
												name = "drop_shadow"
												glow_radius = 5
												color = {0.0 0.0 0.0 1.0}
												alpha = 0.5
											}
										}

										expand = {}
									}
								}

								expand = {}
							
								hbox = {
									spacing = 4

									vbox = {
										margin = { 5 0 }
										ignoreinvisible = yes

										button_square_checkbox = {
											visible = "[And(BuildingItem.HasBuildings, BuildingItem.GetBuildingType.IsProducing)]"
											size = { 20 16 }
											enabled = "[CanSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
											tooltipwidget = {
												using = Building_Subsidized_Tooltip
											}

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/flat_icons/building_panel/subsidized.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												on_action = "[ToggleSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
												on_action = "[PlayAudioEffect(Concatenate('UI_action_building_subsidize', GetToggleSuffix(AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc))))]"
												enabled = "[CanSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
												title = "[SelectLocalization( BuildingCandidate.GetBuilding.IsSubsidized, 'TOGGLE_SUBSIDIZE_ON', 'TOGGLE_SUBSIDIZE_OFF' )]"
											}
										}

										button_square_checkbox = {
											visible = "[And(BuildingItem.HasBuildings, BuildingItem.ShowCloseAll)]"
											size = { 20 16 }
											enabled = "[CanToggleBuildings(BuildingItem.GetBuildingsFunc)]"
											tooltipwidget = {
												using = Building_Open_Tooltip
											}

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/achievements/padlock.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[AreBuildingsClosed(BuildingItem.GetBuildingsFunc)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(AreBuildingsClosed(BuildingItem.GetBuildingsFunc))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												on_action = "[ToggleBuildings(BuildingItem.GetBuildingsFunc)]"
												enabled = "[CanToggleBuildings(BuildingItem.GetBuildingsFunc)]"
												title = "[SelectLocalization( BuildingCandidate.GetBuilding.IsOpen, 'TOGGLE_CLOSE_ON', 'TOGGLE_CLOSE_OFF' )]"
											}
										}

										button_square_checkbox = {
											visible = "[And(ObjectsEqual(Building.GetOwner, Player.Self), BuildingType.IsMultipleLevels)]"
											size = { 20 16 }
											tooltipwidget = { using = AutoExpand_Building_Tooltip }

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[IsAutoExpand(Building.Self)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(IsAutoExpand(Building.Self))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												click_type = left
												title = "[SelectLocalization(IsAutoExpand(Building.Self), 'TOGGLE_AUTO_EXPAND_ON', 'TOGGLE_AUTO_EXPAND_OFF')]"
												on_action = "[ToggleAutoExpandBuilding(Building.Self)]"
												description = "[GetAutoExpandBuildingsAutomationWarning]"
											}
										}
									}

									hbox = { # PP: production-method slots, two per column
