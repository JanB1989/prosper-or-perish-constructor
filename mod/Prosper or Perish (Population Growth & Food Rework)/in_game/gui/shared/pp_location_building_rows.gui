													size = { 21 21 }
													visible = "[Not(BuildingCandidate.GetBuilding.CanPlayerUpgrade)]"
													blockoverride "square_icon_content" {
														icon = {
															visible = "[Not(GreaterThan_CFixedPoint(GetRemainingUpgradeLevels(BuildingCandidate.GetBuilding.GetType, BuildingCandidate.GetBuilding.GetLocation), '(CFixedPoint)0'))]"
															size = { 12 12 }
