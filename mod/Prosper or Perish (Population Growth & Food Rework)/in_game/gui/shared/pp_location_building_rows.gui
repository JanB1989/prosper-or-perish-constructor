						# 										texture = "[GetGoodsIcon(ProductionMethod.GetProduced)]"
						# 									}
						# 									lowpriotextcontext = "[Building.GetEffectiveOutputInfo(ProductionMethod.Self)]"
						# 								}
						# 							}
						# 						}
						# 						blockoverride "production_method_good_button_tooltip" {
						# 							datacontext = "[ProductionMethod.GetProduced]"
						# 							datacontext = "[ProductionView.GetSelectedMarket]"
						# 							tooltipwidget = { using = SpecificGoodsMarket_tooltip }
						# 						}

						# 						blockoverride "container_color" {
						# 							modify_texture = {
						# 								using = color_bg_brown_texture
						# 								blend_mode = multiply
						# 							}
						# 							alpha = 0.8
						# 						}
						# 					}
						# 				}
						# 			}
						# 		}
						# 	}
						# }
					}
				}
			}
		}
	}

	type pp_location_filtered_header_no_candidate = hbox {
		# !!! for performance, it's important that location_filtered_header_with_candidate and location_filtered_header_no_candidate have the same size !!!
		# Using same structure as location_filtered_header_with_candidate for placeholder visuals
		block "location_filtered_header_no_candidate_visible" {
			visible = "[And(ProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
		}
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 60 }
			block "location_context"
			{
				datacontext = "[ProductionView.GetSelectedLocation]"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				using = bg_cabinet_card_frame
				margin = {2 1}

				widget = {
					size = { -1 54 }
					layoutpolicy_horizontal = expanding

					using = bg_building_card_colors
					blockoverride "building_color" {
						color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
						alpha = 0.7
						blend_mode = overlay
					}

					icon = {
						size = {100% 100%}
						ignore_layout = yes
						visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
						using = color_black_texture
						alpha = 0.2
					}

					card_header_button_04 = {
						size = { 100% 100% }
						# blockoverride "button_simple_max_size" {}

						datacontext = "[BuildingItem.GetNoCandidateUIAction]"
						using = button_action_provider


						datacontext = "[BuildingItem.GetBuildingType]"

						action_tooltip = {
							click_type = left
							click_mode = single
							click_modifier = ctrl
							title = "BUILDING_IN_LOCATION_ACTION_CTRL"
							description = "[CanBuildOrExpandBuildingInfo(BuildingItem.GetBuildingType, Location.Self)]"
							enabled = "[CanBuildOrExpandBuilding(BuildingItem.GetBuildingType, Location.Self)]"
							on_action = "[BuildOrExpandBuildingCtrl(BuildingItem.GetBuildingType, Location.Self)]"
						}
						action_tooltip = {
							click_type = left
							click_mode = single
							click_modifier = shift
							title = "BUILDING_IN_LOCATION_ACTION_SHIFT"
							description = "[CanBuildOrExpandBuildingInfo(BuildingItem.GetBuildingType, Location.Self)]"
							enabled = "[CanBuildOrExpandBuilding(BuildingItem.GetBuildingType, Location.Self)]"
							on_action = "[BuildOrExpandBuildingShift(BuildingItem.GetBuildingType, Location.Self)]"
						}

						tooltipwidget = {
							using = BuildingType_tooltip
							blockoverride "production_method_simple_good_tooltip" { 
								datacontext = "[Location.GetMarket]"
								tooltipwidget = { 
								
									using = SpecificGoodsMarket_tooltip 
								} 
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6
							margin_right = 8

							# icon
							widget = {
								size = { 55 30 }

								icon = {
									size = { 29 29 }
									parentanchor = center
									texture = "[GetBuildingIcon(BuildingItem.GetBuildingType.Self)]"

									sort_by_highlight = {
										name = "name"
									}
								}
							}

							text_single = {
								autoresize = no
								size = { 140 15 }
								align = left|nobaseline
								default_format = "#yellow_titles"
								text = "[BuildingItem.GetBuildingType.GetNameWithNoTooltip]"
								datacontext = "[BuildingItem.GetBuildingType]"
							}

							expand = {}

							hbox = {
								margin_right = 3
								spacing = 6

								widget = {
									size = { 24 24 }
								}

								widget = { #efficiency
									datacontext = "[BuildingItem.GetBuildingType]"
									datacontext = "[Location]"
									size = { 70 44 }
									vbox = { #unbuilt
										visible = "[BuildingItem.GetBuildingType.IsProducing]"
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										text_single = {
											size = { 70 18 }
											autoresize = no
											align = nobaseline|right
											default_format = "@bold!"
											fontsize = 14
											text = "BUILDING_TYPE_POSSIBLE_PROD_EFFICIENCY"
											tooltipwidget = {
												SimpleContextualStringPairTooltipType = {
													blockoverride "title_icon" {
														icon = {
															using = tooltip_title_icon_size
															texture = "gfx/interface/icons/flat_icons/building_panel/production_efficiency.dds"
														}
													}
													blockoverride "concept_link" {
														text = "[production_efficiency|e]"
													}
													lowpriotextcontext = "[BuildingItem.GetBuildingType.ProductionEfficiencyInfo(Location.GetOwnerPtr, Location.Self)]"
												}
											}
										}
									}
								}

								hbox = { using = pp_location_values_unbuilt } # PP: build cost, payback, profit, tax income

								widget = { # PP: records this row's payback band (read by the payback order)
									size = { 0 0 }
									ignore_layout = yes
									widget = {
										visible_at_creation = no
										visible = "[IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions))]"
										size = { 0 0 }
										state = {
											name = _show
											on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
										}
									}
									widget = {
										visible_at_creation = no
										visible = "[Not(IsOdd_int32(GetDataModelSize(Location.GetCivilConstructions)))]"
										size = { 0 0 }
										state = {
											name = _show
											on_start = "[GetVariableSystem.Set(Concatenate('pp_pb_', Concatenate(BuildingType.GetName, Location.GetKey)), Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)0'), '0', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)1'), '1', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)2'), '2', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)3'), '3', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)4'), '4', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)5'), '5', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)6'), '6', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)7'), '7', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)8'), '8', Select_CString(EqualTo_int32(FixedPointToInt(Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)12'), Max_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0.05'))), '(int32)9'), '9', '10')))))))))))]"
										}
									}
								}
							}

							widget = {
								size = { 110 25 }

								hbox = {
									layoutpolicy_horizontal = expanding
									expand = {}
									widget = {
										size = { 25 25 }
										using = bg_circle_piechart

										icon = {
											visible = "[BuildingItem.GetBuildingType.BuildOnlyInCapital]"
											texture = "gfx/interface/buttons/flats/move_capital_button.dds"
											size = { 18 18 }
											parentanchor = center
											position = {-1 0}
											using = color_new_gold
										}
										icon = {
											visible = "[Not(BuildingItem.GetBuildingType.BuildOnlyInCapital)]"
											texture = "gfx/interface/icons/flat_icons/building_panel/build_button.dds"
											size = { 18 18 }
											parentanchor = center
											position = {-1 0}
											using = color_new_gold
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

template pp_location_values_unbuilt { # PP: the value columns of an unbuilt location-view row
	visible = "[BuildingType.IsProducing]"
	layoutpolicy_vertical = expanding
	margin = { 5 0 }
	widget = { # build cost of the next level
		size = { 55 -1 }
		layoutpolicy_vertical = expanding
		text_single = {
			size = { 100% 18 }
			parentanchor = vcenter
			align = nobaseline|right
			autoresize = no
			fontsize = 14
			raw_text = "[GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self)|0]@gold!"
			tooltip = "PP_BUILD_PAYBACK_TT_UNBUILT"
			sort_by_highlight = {
				size = { 105% 100% }
				name = "cost"
			}
		}
	}
	widget = { # payback: years of profit per build cost
		size = { 55 -1 }
		layoutpolicy_vertical = expanding
		text_single = {
			visible = "[GreaterThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0')]"
			size = { 100% 18 }
			parentanchor = vcenter
			align = nobaseline|right
			autoresize = no
			fontsize = 14
			raw_text = "[Divide_CFixedPoint(Divide_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self)), '(CFixedPoint)12')|1]@time!"
			tooltip = "PP_BUILD_PAYBACK_TT_UNBUILT"
		}
		text_single = {
			visible = "[Not(GreaterThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0'))]"
			size = { 100% 18 }
			parentanchor = vcenter
			align = nobaseline|right
			autoresize = no
			fontsize = 14
			raw_text = "#L -#!"
		}
	}
	widget = { # profit per level
		size = { 60 -1 }
		layoutpolicy_vertical = expanding
		text_single = {
			size = { 100% 18 }
			parentanchor = vcenter
			align = nobaseline|right
			autoresize = no
			fontsize = 14
			raw_text = "[GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self)|+=2]@wealth!"
			tooltipwidget = {
				using = BuildingTypeProfit_Tooltip
			}
			sort_by_highlight = {
				size = { 105% 100% }
				name = "profit"
			}
		}
	}
	widget = { # tax income per level
		size = { 60 -1 }
		layoutpolicy_vertical = expanding
		text_single = {
			size = { 100% 18 }
			parentanchor = vcenter
			align = nobaseline|right
			autoresize = no
			fontsize = 14
			raw_text = "[GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self)|+=2]@income!"
			tooltipwidget = {
				using = BuildingTypeProfit_Tooltip
			}
			sort_by_highlight = {
				size = { 105% 100% }
				name = "income"
			}
		}
	}
}
