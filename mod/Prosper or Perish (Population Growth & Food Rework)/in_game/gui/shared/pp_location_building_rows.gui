															text = "BUILDING_CONSTRUCTION_RISK_LABEL_GREEN_BUILDING_CANDIDATE"
														}
														blockoverride "building_expansion_risk_badge_yellow_label" {
															text = "BUILDING_CONSTRUCTION_RISK_LABEL_YELLOW_BUILDING_CANDIDATE"
														}
														blockoverride "building_expansion_risk_badge_red_label" {
															text = "BUILDING_CONSTRUCTION_RISK_LABEL_RED_BUILDING_CANDIDATE"
														}
														blockoverride "building_expansion_risk_badge_impact_warning_visible" {
															visible = "[BuildingCandidate.HasGoodsImpactedByConstruction]"
														}
													}
												
												}

