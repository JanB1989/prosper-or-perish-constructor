											}
											blockoverride "header_button_frame_inner_mirror" { mirror = horizontal }
											parentanchor = vcenter
											position = { 0 2 }
											enabled = "[ShowGrantTownRights]"

											blockoverride "icon_texture" {
												texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
											}

											blockoverride "text_top" {
												autoresize = no
												using = layoutpolicy_expanding
												text = "ADD_NEW_URBAN_RIGHT"
											}

											blockoverride "text_bottom" {
												visible = no
											}

											tooltipwidget = {
												BasicFunctionalTooltip = {}
											}

											action_tooltip = {
												click_type = left
												click_mode = single
												title = "GRANT_NEW_TOWN_RIGHTS"
												on_action = "[SelectTownRights]"
												conditions = "[AddLocalizationIf(Not(ShowGrantTownRights), 'TWR_NOT_CAPABLE')]"
												enabled = "[ShowGrantTownRights]"
											}
										}
									}
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									margin = { 5 5 }
									hbox = {
										spacing = 5
										layoutpolicy_horizontal = expanding
										margin = { 3 3 }
										hbox = {
											spacing = 1
											datamodel = "[DataModelFirst(TownRightsLateralView.GetTownRightsTypes, '(int32)10')]"
											item = {
												using = town_rights_type_item
											}
										}

										text_single = {
											margin = { 6 11 }
											using = Font_Type_Headers
											raw_text = "+[Subtract_int32(GetDataModelSize(TownRightsLateralView.GetTownRightsTypes), '(int32)10')]"
											align = nobaseline
											visible = "[GreaterThan_int32(GetDataModelSize(TownRightsLateralView.GetTownRightsTypes), '(int32)10')]"
											using = bg_number_container_bckg
											tooltipwidget = {
												ContextualTooltipType = {
													blockoverride "title_text" {
														text = "TOWN_RIGHTS_TEXT"
													}

													blockoverride "concept_link" {
														text = [town_rights|E]
													}

													blockoverride "title_icon_texture" {
														texture = "[GetConceptTexture('town_rights')]"
													}

													blockoverride "tooltip_layout_policy" { }

													blockoverride "tooltip_content" {
														TooltipListBase = {
															TooltipScrolledContentSection = {
																blockoverride "section_content" {
																	vbox = {
																		layoutpolicy_horizontal = expanding
																		datamodel = "[DataModelSkipFirst(TownRightsLateralView.GetTownRightsTypes, '(int32)10')]"
																		item = {
																			TooltipManualTableField = {
																				margin = { 0 0 }
																				margin_left = 10
																				tooltipwidget = {
																					using = TownRightsItem_tooltip
																				}

																				widget = {
																					size = { 60 60 }
																					using = town_rights_type_item
																					blockoverride "item_size" {
																						size = { 50 45 }
																						parentanchor = center
																					}
																				}
																		
																				vbox = {
																					using = layoutpolicy_expanding
																					text_single = {
																						margin = { 10 0 }
																						using = layoutpolicy_expanding
																						text = "[TownRightsItem.GetType.GetNameWithNoTooltip]"
																						default_format = "#L"
																					}
																					hbox = {
																						using = layoutpolicy_expanding
																						margin = { 10 0 }
																						background = {
																							using = text_mask_container_texture
																							alpha = 0.2
																							modify_texture = {
																								using = color_black_texture
																							}
																						}

																						text_single = {
																							layoutpolicy_horizontal = expanding
																							text = "TOWN_RIGHTS_ITEM_LOCATIONS_TITLE"
																						}
																						text_single = {
																							autoresize = yes
																							text = "[TownRightsItem.GetLocationsAmount]"
																						}
																					}
																				}
																			}
																		}
																	}
																}
															}
														}	
													}
												}
											}
											blockoverride "number_container_alpha" {
												alpha = 0.5
											}
											blockoverride "number_container_color" {
												modify_texture = {
													using = color_bg_blue_texture
													blend_mode = multiply
												}
											}
										}

										expand = {}
									}
								}
							}
						}

						blockoverride "filtered_sorted_list_sorts_visible" {
							visible = "[TownRightsLateralView.Vars.HasValue( 'urb_tab', 'locations' )]"
						}

						blockoverride "sort_buttons_filtered_list" {
							sort_by_key_button = {
								name = "town_rights"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "rank"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "population"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "name"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "market"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "control"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "good"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "income"
								using = layoutpolicy_expanding
							}
							sort_by_key_button = {
								name = "wealth"
								using = layoutpolicy_expanding
							}
						}
		
						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(TownRightsLateralView.GetLocations)]"
						}
		
						blockoverride "scroll_list_is_empty_text" {
							text = "LOCATIONS_SCROLL_LIST_EMPTY"
						}
					
						blockoverride "scroll_list_layout" {
							vbox = {
								layoutpolicy_horizontal = expanding

								fixedgridbox = {
									visible = "[TownRightsLateralView.Vars.NotExistOrHasValue( 'urb_tab', 'urban_rights' )]"
									addcolumn = 100%
									addrow = 100
									datamodel_reuse_widgets = yes
									datamodel = "[TownRightsLateralView.GetLocations]"
									item = {
										widget = {
											size = { 100% 90 }
											datacontext = "[LocationReference.GetLocation]"
											widget = {
												size = { 98% 81 }
												parentanchor = center
												hbox = {
													using = bg_townrights_card
													using = bg_cabinet_card_frame
													using = urban_rights_location_card
												}
											}
										}
									}
								}

								fixedgridbox = {
									visible = "[TownRightsLateralView.Vars.HasValue( 'urb_tab', 'locations' )]"
									addcolumn = 100%
									addrow = 80
									datamodel_reuse_widgets = yes
									datamodel = "[TownRightsLateralView.GetLocations]"
									item = {
										widget = {
											size = { 100% 70 }
											datacontext = "[LocationReference.GetLocation]"
											widget = {
												size = { 98% 70 }
												parentanchor = center
												hbox = {
													using = bg_market_card
													using = bg_cabinet_card_frame

													pp_location_card = {
														blockoverride "location_card_margins" {
															margin = {0 5}
															margin_left = 5
														}
														blockoverride "location_control_sort_highlight"
														{
															sort_by_highlight = {
																name = "control"
															}
														}
														blockoverride "location_population_sort_highlight"
														{
															sort_by_highlight = {
																name = "population"
															}
														}
														blockoverride "location_town_rights_sort_highlight"
														{
															sort_by_highlight = {
																name = "town_rights"
															}
														}
														blockoverride "location_rank_sort_highlight"
														{
															sort_by_highlight = {
																name = "rank"
															}
														}
														blockoverride "location_name_sort_highlight"
														{
															sort_by_highlight = {
																name = "name"
															}
														}
														blockoverride "location_raw_good_sort_highlight"
														{
															sort_by_highlight = {
																name = "good"
															}
														}
														blockoverride "location_income_sort_highlight"
														{
															sort_by_highlight = {
																name = "income"
															}
														}
														blockoverride "location_wealth_sort_highlight"
														{
															sort_by_highlight = {
																name = "wealth"
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
					}
				}
			}
		}
	}
}
