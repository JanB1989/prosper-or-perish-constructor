			blockoverride "searchbar_filter_button" {
				icon = {
					size = { 28 28 }
					visible = "[SearchBar.HasSearchFilterCategories]"

					texture = "gfx/interface/buttons/round_button_texture_alt.dds"
					texture_density = 2

					modify_texture = {
						using = color_new_gold_texture
						blend_mode = overlay
						alpha = 1
					}

					modify_texture = {
						using = overlay_stone_texture
						blend_mode = overlay
						alpha = 1
					}

					background = {
						texture = "gfx/interface/buttons/bg_button_light.dds"
						texture_density = 2
						modify_texture = {
							using = color_intense_brown_texture
							blend_mode = add
						}
						modify_texture = {
							using = color_super_dark_brown_texture
							blend_mode = multiply
							alpha = 0.6
						}
					}

					ui_direction_button = {
						size = { 28 28 }

						blockoverride "button_texture"  {
							texture = "gfx/interface/buttons/flats/filter.dds"
						}

						visible = "[SearchBar.HasSearchFilterCategories]"
						down = "[SearchBar.Manager.IsSelectSearchFilterOpened(PdxGuiWidget.Self)]"

						action_tooltip = {
							click_type = left
							click_mode = single
							title = "FILTERS_SIDEMENU"
							on_action = "[PdxGuiWidget.ToggleContextMenu]"
						}

						action_tooltip = {
							click_type = right
							title = "[SelectLocalization(SearchBar.HasPin, 'SEARCHBAR_SET_FAV_SEARCH_FILTERS_BT', 'SEARCHBAR_SET_DEFAULT_FILTERS_BT')]"
							on_action = "[SearchBar.ResetFiltersToDefault]"
						}

						contextmenu_widget = {
							ContextMenuBase = {
								blockoverride "contextmenu_scroll_maximumsize" {
									maximumsize = { -1 600 }
								}
								blockoverride "contextmenu_content" {
									vbox = {
										minimumsize = { 390 -1 }
										maximumsize = { 390 -1 }
										datacontext = "[TradeOrderSelectGood.Parent.GetMarketGoodsSortSearch.GetSearchBar]"
										using = select_search_filter_content
									}
								}
							}
						}

						tooltipwidget = { BasicFunctionalTooltip = {} }

						blockoverride "glow_visible" {
							visible = "[SearchBar.Manager.IsSelectSearchFilterOpened(PdxGuiWidget.Self)]"
						}
					}
				}
			}

			blockoverride "sort_buttons_filtered_list" {
				sort_by_key_button = {
					name = "name"
