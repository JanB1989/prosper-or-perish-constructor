	type TradeOrderGoodToggleRow = widget {
		size = { 100% 32 }

		card_list_button = {
			size = { 100% 100% }
			enabled = "[TradeOrderSelectGood.Parent.CanAddGoodFromPanel(Goods.Self)]"
			datacontext = "[TradeOrderSelectGood.Parent.GetMarket]"
			tooltipwidget = { using = SpecificGoodsMarket_tooltip }
			action_tooltip = {
				click_type = left
				click_mode = single
				title = "[Goods.GetNameWithNoTooltip]"
				enabled = "[TradeOrderSelectGood.Parent.CanAddGoodFromPanel(Goods.Self)]"
				conditions = "[MakeItFailIfLoc(Not(TradeOrderSelectGood.Parent.CanAddGoodFromPanel(Goods.Self)), 'TRADE_ORDER_GOOD_CANNOT_ADD_TT')]"
				on_action = "[TradeOrderSelectGood.Parent.AddGoodFromPanel(Goods.Self)]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				title = "GOODS_MARKET_CTXMENU_OPEN"
				on_action = "[PdxGuiWidget.ToggleContextMenu]"
			}

			contextmenu_widget = {
				GoodsMarketContextMenu = {}
			}

			hbox = {
				margin = { 8 0 }
				spacing = 6

				widget = {
					size = { 26 26 }
					icon = {
						size = { 24 24 }
						parentanchor = center
						texture = "[GetGoodsIcon(Goods.Self)]"
					}
					icon = {
						visible = "[TradeOrderSelectGood.Parent.IsGoodsPanelImport]"
						parentanchor = bottom|right
						size = { 12 12 }
						texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
					}
					icon = {
						visible = "[Not(TradeOrderSelectGood.Parent.IsGoodsPanelImport)]"
						parentanchor = bottom|right
						size = { 12 12 }
						texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
					}
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					autoresize = no
					align = left|nobaseline
					fontsize = 13
					text = "[Goods.GetNameWithNoTooltip]"
				}

				expand = {}

				trade_order_good_market_info = {
					datacontext = "[TradeOrderSelectGood.Parent.GetMarket]"
				}
			}
		}
	}
}

lateralview = {
	name = "trade_order_lateral_view"
	widgetid = "trade_order_lateral_view"

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text_object" {
				hbox = {
					spacing = 5
					expand = {}

					header_title = {
						layoutpolicy_horizontal = fixed
						layoutpolicy_vertical = fixed
						autoresize = yes
						maximumsize = { 420 -1 }
						datacontext = "[TradeOrderLateralView.GetMarket]"
						text = "TRADE_ORDER_VIEW_TITLE"
					}

					widget = {
						size = { 23 23 }
						visible = "[And(IsPlayerValid, TradeOrderLateralView.IsEditingTradeOrder)]"

						button_pin = {
							size = { 100% 100% }
							datacontext = "[TradeOrderLateralView.GetEditedOrderItem.GetTradeOrder]"
							action_tooltip = {
								title = "[SelectLocalization(IsTradeOrderFaved(TradeOrder.Self), 'UNPIN_OUTLINER', 'PIN_OUTLINER')]"
								on_action = "[ToggleTradeOrderFav(TradeOrder.Self)]"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }
							down = "[IsTradeOrderFaved(TradeOrder.Self)]"
						}
					}

					expand = {}
				}
			}
			blockoverride "window_header_alt_color_texture" {
				using = color_default_brown_texture
			}
		}
	}

	blockoverride "panel_content" {
		widget = {
			using = layoutpolicy_expanding

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_notabs_alt
				using = window_main_tabs_margin_alt
				margin_top = 8
				spacing = 5
				visible = "[Not(TradeOrderLateralView.IsMarketPanelOpen)]"

				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 43 }

					hbox = {
						using = layoutpolicy_expanding
						using = bg_paper_card
						margin = { 5 5 }
						spacing = 7
						datacontext = "[TradeOrderLateralView.GetEditedOrderItem]"
						tooltipwidget = { using = trade_order_editing_card_tooltip }

						hbox = {
							layoutpolicy_horizontal = expanding
							icon = {
								visible = "[IsDataModelEmpty(TradeOrderLateralView.GetGoodsEntries)]"
								size = { 26 26 }
								alpha = 0.4
								texture = "gfx/interface/icons/flat_icons/trade_market/missing_goods.dds"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												size = { 50 50 }
												texture = "gfx/interface/icons/flat_icons/trade_market/missing_goods.dds"
											}
										}

										blockoverride "title_text" {
											text = "[trade_order]"
										}

										blockoverride "tooltip_content" {
											TooltipTextBlock = {
												blockoverride "text" {
													text = "TRADE_ORDER_CANNOT_APPLY_NO_GOODS"
												}
											}
										}
									}
								}
							}

							hbox = {
								visible = "[Not(IsDataModelEmpty(TradeOrderLateralView.GetGoodsEntries))]"
								layoutpolicy_horizontal = expanding
								spacing = 4

								hbox = {
									spacing = 2
									datamodel = "[DataModelFirst(TradeOrderLateralView.GetGoodsEntries, Select_int32(GreaterThan_int32(GetDataModelSize(TradeOrderLateralView.GetGoodsEntries), '(int32)3'), '(int32)2', '(int32)3'))]"
									item = {
										widget = {
											size = { 26 26 }
											icon = {
												visible = "[Not(TradeOrderGoodsEntryItem.GetIsAny)]"
												size = { 26 26 }
												texture = "[GetGoodsIcon(TradeOrderGoodsEntryItem.GetGoods)]"
											}
											icon = {
												visible = "[And(And(TradeOrderGoodsEntryItem.GetIsAny, TradeOrderGoodsEntryItem.GetIsImport), Not(TradeOrderGoodsEntryItem.GetIsNeed))]"
												size = { 26 26 }
												texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
											}
											icon = {
												visible = "[And(And(TradeOrderGoodsEntryItem.GetIsAny, Not(TradeOrderGoodsEntryItem.GetIsImport)), Not(TradeOrderGoodsEntryItem.GetIsNeed))]"
												size = { 26 26 }
												texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
											}
											icon = {
												visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)1')]"
												size = { 26 26 }
												texture = "gfx/interface/icons/alerts_icons/constructions_missing_input.dds"
											}
											icon = {
												visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)2')]"
												size = { 26 26 }
												texture = "gfx/interface/icons/alerts_icons/buildings_missing_input.dds"
											}
											icon = {
												visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)3')]"
												size = { 26 26 }
												texture = "gfx/interface/icons/alerts_icons/pops_wanting_stuff.dds"
											}
											icon = {
												visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)4')]"
												size = { 26 26 }
												texture = "gfx/interface/icons/flat_icons/trade_market/trade_categories/profitable_food_trades.dds"
											}
											icon = {
												visible = "[And(Not(TradeOrderGoodsEntryItem.GetIsAny), TradeOrderGoodsEntryItem.GetIsImport)]"
												parentanchor = bottom|right
												size = { 12 12 }
												texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
											}
											icon = {
												visible = "[And(Not(TradeOrderGoodsEntryItem.GetIsAny), Not(TradeOrderGoodsEntryItem.GetIsImport))]"
												parentanchor = bottom|right
												size = { 12 12 }
												texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
											}
										}
									}
								}

								extra_list = {
									visible = "[GreaterThan_int32(GetDataModelSize(TradeOrderLateralView.GetGoodsEntries), '(int32)3')]"
									blockoverride "extra_list_text_content" {
										raw_text = "+[Subtract_int32(GetDataModelSize(TradeOrderLateralView.GetGoodsEntries), '(int32)2')]"
										align = center|nobaseline
									}
									blockoverride "extra_list_size" {
										size = { 34 30}
									}
								}


								expand = {}
							}

							hbox = {
								visible = "[Not(IsDataModelEmpty(TradeOrderLateralView.GetGoodsEntries))]"
								# visible = "[TradeOrderLateralView.IsEditingTradeOrder]"
								spacing = 8

								text_single = {
									size = { 50 15 }
									autoresize = no
									align = right|nobaseline
									using = Font_Size_Small
									raw_text = "[TradeOrderLateralView.GetEditedTradeCount]@trade!"
								}

								text_single = {
									size = { 70 15 }
									autoresize = no
									align = right|nobaseline
									using = Font_Size_Small
									raw_text = "[TradeOrderLateralView.GetEditedProfitPerCapacity|+=2]@profit_trade!"
								}
							}

							expand = {}
						}

						hbox = {
							margin = { 2 0 }
							spacing = 4
							using = bg_number_container_bckg
							blockoverride "number_container_extra" {
								alpha = 0.4
								margin = {2 4}
							}

							checkbox_round_alt = {
								size = { 20 20 }
								down = "[TradeOrderLateralView.GetIsPercentage]"
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "[SelectLocalization( TradeOrderLateralView.GetIsPercentage, 'TRADE_ORDER_TC_TOGGLE_TO_ABSOLUTE_TT', 'TRADE_ORDER_TC_TOGGLE_TO_PERCENTAGE_TT' )]"
									on_action = "[TradeOrderLateralView.TogglePercentage]"
								}
							}

							button_square_minus = {
								size = { 18 18 }
								enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "POSSIBLE_TRADE_CAPACITY_DECREASE"
									enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.DecreaseCapacity('(float)1')]"
								}
								action_tooltip = {
									click_type = left
									click_mode = single
									click_modifier = alt
									title = "POSSIBLE_TRADE_CAPACITY_DECREASE_SLOW"
									enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.DecreaseCapacity('(float)0.1')]"
								}
								action_tooltip = {
									click_type = left
									click_mode = single
									click_modifier = shift
									title = "POSSIBLE_TRADE_CAPACITY_DECREASE_10"
									enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.DecreaseCapacity('(float)10')]"
								}
							}

							text_single = {
								minimumsize = { 50 -1 }
								maximumsize = { 50 -1 }
								align = center|nobaseline
								using = Font_Size_Small
								raw_text = "[TradeOrderLateralView.GetEffectivePercentage|0]%"
							}

							button_square_plus = {
								size = { 18 18 }
								enabled = "[And(TradeOrderLateralView.CanIncreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "POSSIBLE_TRADE_CAPACITY_INCREASE"
									enabled = "[And(TradeOrderLateralView.CanIncreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.IncreaseCapacity('(float)1')]"
								}
								action_tooltip = {
									click_type = left
									click_mode = single
									click_modifier = alt
									title = "POSSIBLE_TRADE_CAPACITY_INCREASE_SLOW"
									enabled = "[And(TradeOrderLateralView.CanIncreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.IncreaseCapacity('(float)0.1')]"
								}
								action_tooltip = {
									click_type = left
									click_mode = single
									click_modifier = shift
									title = "POSSIBLE_TRADE_CAPACITY_INCREASE_10"
									enabled = "[And(TradeOrderLateralView.CanIncreaseCapacity, TradeOrderLateralView.GetIsPercentage)]"
									on_action = "[TradeOrderLateralView.IncreaseCapacity('(float)10')]"
								}
							}
						}

						hbox = {
							margin = { 2 0 }
							spacing = 4
							using = bg_number_container_bckg
							blockoverride "number_container_extra" {
								alpha = 0.4
								margin = {2 4}
							}
							
							checkbox_round_alt = {
								size = { 20 20 }
								down = "[Not(TradeOrderLateralView.GetIsPercentage)]"
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "[SelectLocalization( TradeOrderLateralView.GetIsPercentage, 'TRADE_ORDER_TC_TOGGLE_TO_ABSOLUTE_TT', 'TRADE_ORDER_TC_TOGGLE_TO_PERCENTAGE_TT' )]"
									on_action = "[TradeOrderLateralView.TogglePercentage]"
								}
							}

							button_square_minus = {
								size = { 18 18 }
								enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, Not(TradeOrderLateralView.GetIsPercentage))]"
								tooltipwidget = { BasicFunctionalTooltip = {} }
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "POSSIBLE_TRADE_CAPACITY_DECREASE"
									enabled = "[And(TradeOrderLateralView.CanDecreaseCapacity, Not(TradeOrderLateralView.GetIsPercentage))]"
									on_action = "[TradeOrderLateralView.DecreaseCapacity('(float)1')]"
								}
								action_tooltip = {
									click_type = left
									click_mode = single
									click_modifier = alt
