					name = "goods_imports"
					layoutpolicy_vertical = expanding
					size = { 70 -1 }
				}

				sort_by_key_button = {
					name = "goods_exports"
					layoutpolicy_vertical = expanding
					size = { 70 -1 }
				}

				sort_by_key_button = {
					name = "goods_balance"
					layoutpolicy_vertical = expanding
					size = { 72 -1 }
				}

				sort_by_key_button = {
					name = "market_price"
					layoutpolicy_vertical = expanding
					size = { 80 -1 }
				}
			}

			blockoverride "scroll_list_layout" {
				vbox = { # PP: skips the internal goods (a fixedgridbox would keep their rows empty)
					layoutpolicy_horizontal = expanding
					datamodel = "[TradeOrderSelectGood.Parent.GetMarketGoods]"

					item = {
						widget = {
							using = pp_hide_internal_goods
							layoutpolicy_horizontal = expanding
							size = { -1 32 }

							TradeOrderGoodToggleRow = {}
						}
					}
				}
			}
