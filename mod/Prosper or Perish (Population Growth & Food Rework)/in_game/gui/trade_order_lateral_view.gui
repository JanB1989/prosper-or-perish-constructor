		widget = {
			layoutpolicy_vertical = expanding
			size = { 65 -1 }
			datacontext = "[Market.GetMarketEntry(Goods.Self)]"
			sort_by_small_highlight = { name = "goods_exports" }
			tooltipwidget = { using = goods_market_exports_tooltip }
			hbox = {
				parentanchor = vcenter
				expand = {}
				hbox = {
					spacing = 3
					text_single = {
						visible = "[GreaterThan_CFixedPoint(Market.GetDemandExportOnly(Goods.Self),'(CFixedPoint)0')]"
						autoresize = yes
						align = right|nobaseline
						using = Font_Size_Small
						text = "[Market.GetDemandExportOnly(Goods.Self)|2L]"
					}
					text_single = {
						visible = "[Not(GreaterThan_CFixedPoint(Market.GetDemandExportOnly(Goods.Self),'(CFixedPoint)0'))]"
						autoresize = yes
						align = right|nobaseline
						using = Font_Size_Small
						text = "[Market.GetDemandExportOnly(Goods.Self)|2]"
						default_format = "#medium"
					}
					icon = {
						size = { 16 16 }
						texture = "[GetConceptTexture('export')]"

						using = goods_market_export_tariff_overlay
					}
				}
			}
		}

		widget = {
			layoutpolicy_vertical = expanding
			size = { 15 -1 }
			icon = {
				parentanchor = center
				size = { 22 28 }
				texture = "gfx/interface/buttons/flats/button_simple.dds"
				modify_texture = {
					using = color_bone_texture
					blend_mode = normal
				}
			}
		}

		widget = {
			layoutpolicy_vertical = expanding
			size = { 62 -1 }
			datacontext = "[Market.GetMarketEntry(Goods.Self)]"
			sort_by_small_highlight = { name = "goods_balance" }
			tooltipwidget = { using = goods_market_balance_tooltip }
			hbox = {
				parentanchor = vcenter
				expand = {}
				hbox = {
					spacing = 3
					text_single = {
						autoresize = yes
						align = right|nobaseline
						using = Font_Size_Small
						text = "[Market.GetSurplus(Goods.Self)|+=2]"
					}
					icon = { size = { 16 16 } texture = "gfx/interface/icons/flat_icons/trade_market/goods_balance.dds" }
				}
			}
		}

		widget = {
			size = { 62 20 }
			datacontext = "[Market.GetMarketEntry(Goods.Self)]"
			sort_by_small_highlight = { name = "market_price" }
			sort_by_small_highlight = { name = "market_price_diff" }
			tooltipwidget = { using = goods_market_price_tooltip }
			text_single = {
				size = { 100% 15 }
				autoresize = no
				parentanchor = center
				align = right|nobaseline
				using = Font_Size_Small
				raw_text = "[GoodsMarketEntry.GetPrice|2]@[GoodsMarketEntry.GetGoods.GetPriceDifferenceIconName(GoodsMarketEntry.GetPrice)]!"
			}
		}
	}

	type trade_order_preset_card = widget {
