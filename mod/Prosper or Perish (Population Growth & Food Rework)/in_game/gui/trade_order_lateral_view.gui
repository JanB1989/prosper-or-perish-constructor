					}
					text_single = {
						visible = "[Not(GreaterThan_CFixedPoint(Market.GetSupplyImportOnly(Goods.Self),'(CFixedPoint)0'))]"
						autoresize = yes
						align = right|nobaseline
						using = Font_Size_Small
						text = "[Market.GetSupplyImportOnly(Goods.Self)|2]"
						default_format = "#medium"
