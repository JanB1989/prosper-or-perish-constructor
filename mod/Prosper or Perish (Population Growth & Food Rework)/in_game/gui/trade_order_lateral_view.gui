select_menu_left = {
	blockoverride "menu_setup" {
		name = "trade_order_select_good"
	}

	blockoverride "close_on_action" {
		on_action = "[TradeOrderSelectGood.OnClose]"
	}

	blockoverride "select_header_text" {
		text = "[SelectLocalization( TradeOrderSelectGood.Parent.IsGoodsPanelImport, 'TRADE_ORDER_ADD_IMPORT_GOOD', 'TRADE_ORDER_ADD_EXPORT_GOOD' )]"
	}

	blockoverride "select_content" {
		margin_top = 5
		spacing = 10

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			margin = { 0 4 }
			visible = "[TradeOrderSelectGood.Parent.IsGoodsPanelImport]"

			any_good_card_button = {
				blockoverride "any_good_card_enabled" {
					enabled = "[TradeOrderSelectGood.Parent.CanAddAnyImportGood]"
				}
				blockoverride "any_good_card_icon" {
					texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
					texture_density = 2
				}
				blockoverride "any_good_card_label" {
					text = "TRADE_ORDER_ANY_IMPORT"
				}
				blockoverride "any_good_card_tooltip" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_text" { text = "TRADE_ORDER_ANY_IMPORT" }
							blockoverride "title_icon" {
