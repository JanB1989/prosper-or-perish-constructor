template trade_order_good_trades_tooltip {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				size = { 50 50 }
				texture = "gfx/interface/icons/flat_icons/trade_market/trade.dds"
			}
		}

		blockoverride "title_text" {
			text = "TRADE_ORDER_TRADES_TOOLTIP_TITLE"
		}

		blockoverride "concept_link" {
			text = "[trade_order|E]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0')]"
				blockoverride "text" {
					text = "TRADE_ORDER_GOOD_TRADES_TOOLTIP_SUMMARY"
				}
			}
			TooltipTextBlock = {
				visible = "[Not(GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0'))]"
				blockoverride "text" {
					text = "TRADE_ORDER_TRADES_TOOLTIP_NONE"
				}
			}

			TooltipTextBlock = {
				visible = "[TradeOrderGoodsEntryItem.HasTrend]"
				blockoverride "text" {
					text = "[TradeOrderGoodsEntryItem.GetTrendTooltip]"
				}
			}

			TooltipTextBlock = {
				visible = "[TradeOrderGoodsEntryItem.IsIgnoredInFoodMode]"
				blockoverride "text" {
					text = "TRADE_ORDER_GOOD_IGNORED_FOOD_TT"
				}
			}

			TooltipTextBlock = {
				visible = "[TradeOrderGoodsEntryItem.IsAnyEntryRestrictedToFood]"
				blockoverride "text" {
					text = "TRADE_ORDER_ANY_FOOD_ONLY_TT"
				}
			}

			TooltipScrolledStringPairList = {
				visible = "[And(TradeOrderGoodsEntryItem.GetIsAny, TradeOrderGoodsEntryItem.GetIsNeed)]"
				blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
				textcontext = "[TradeOrderGoodsEntryItem.GetQualifyingNeedGoodsTooltip]"
			}

			TooltipScrolledStringPairList = {
				tooltipmeta = {
					game_concept = "[trade_profit|e]"
					title = "[trade_profit]"
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
				textcontext = "[TradeOrderGoodsEntryItem.GetTradesListTooltip]"
			}
		}
	}
}

template trade_order_editing_card_tooltip {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				size = { 50 50 }
				texture = "[GetConceptTexture('trade_orders')]"
			}
		}

		blockoverride "title_text" {
			text = "TRADE_ORDER_TRADES_TOOLTIP_TITLE"
		}

		blockoverride "concept_link" {
			text = "[trade_order|E]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[EqualTo_int32(TradeOrderLateralView.GetMode, '(int32)0')]"
				blockoverride "text" {
					text = "TRADE_ORDER_MODE_PROFIT_INFO"
				}
			}
			TooltipTextBlock = {
				visible = "[EqualTo_int32(TradeOrderLateralView.GetMode, '(int32)1')]"
				blockoverride "text" {
					text = "TRADE_ORDER_MODE_FOOD_INFO"
				}
			}
			TooltipTextBlock = {
				visible = "[EqualTo_int32(TradeOrderLateralView.GetMode, '(int32)2')]"
				blockoverride "text" {
					text = "TRADE_ORDER_MODE_NEEDS_INFO"
				}
			}

			TooltipTextBlock = {
				visible = "[Not(TradeOrderLateralView.IsEditingTradeOrder)]"
				blockoverride "text" {
					text = "TRADE_ORDER_NEW_TOOLTIP_SUMMARY"
				}
			}

			TooltipListBase = {
				visible = "[DataModelHasItems(TradeOrderLateralView.GetGoodsEntries)]"
				blockoverride "block_title" {
					block "block_title" {
						visible = yes
						text = "TRADE_ORDER_GOODS_LIST_HEADER"
					}
				}

				TooltipScrolledContentSection = {
					blockoverride "block_scrollarea" { maximumsize = { -1 400 } }

					blockoverride "section_content" {
						TooltipListColumnContent = {
							TooltipTableColumn = {
								layoutpolicy_horizontal = expanding

								blockoverride "field_left" {
									icon  = {
										visible = "[TradeOrderGoodsEntryItem.GetIsImport]"
										size = { 16 16 }
										texture = "[GetConceptTexture('import')]"
										tooltip = "[import]"
										tagtooltip_enabled = yes
									}
									icon  = {
										visible = "[Not(TradeOrderGoodsEntryItem.GetIsImport)]"
										size = { 16 16 }
										texture = "[GetConceptTexture('export')]"
										tooltip = "[export]"
										tagtooltip_enabled = yes
									}

									button  = {
										size = { 22 22 }
										visible = "[Not(TradeOrderGoodsEntryItem.GetIsAny)]"
										datacontext = "[TradeOrderGoodsEntryItem.GetGoods]"
										texture = "[GetGoodsIcon(Goods.Self)]"
										datacontext = "[TradeOrderItem.GetMarket]"
										datacontext = "[Market.GetMarketEntry(Goods.Self)]"
										onmousehierarchyenter = "[PdxGuiWidget.SetHighlightGoods(Goods.Self)]"
										tooltipwidget = { using = SpecificGoodsMarket_tooltip }

										action_tooltip = {
											click_type = left
											click_mode = single
											title = "OPEN_GOOD_PANEL"
											on_action = "[ShowGoods(GoodsMarketEntry.GetGoods)]"
										}

										action_tooltip = {
											click_type = right
											click_mode = single
											title = "GOODS_MARKET_CTXMENU_OPEN"
											on_action = "[PdxGuiWidget.ToggleContextMenu]"
										}

										contextmenu_widget = {
											GoodsMarketContextMenu = {}
										}
									}
								}

								blockoverride "tooltip_table_text_single" {
									text_single = {
										visible = "[Not(TradeOrderGoodsEntryItem.GetIsAny)]"
										layoutpolicy_horizontal = expanding
										autoresize = yes
										align = left|nobaseline
										text = "[TradeOrderGoodsEntryItem.GetDisplayName]"
										datacontext = "[TradeOrderGoodsEntryItem.GetGoods]"
										datacontext = "[TradeOrderLateralView.GetMarket]"
										tooltipwidget = { using = SpecificGoodsMarket_tooltip }
									}

									text_single = {
										visible = "[And(TradeOrderGoodsEntryItem.GetIsAny, Not(TradeOrderGoodsEntryItem.GetIsNeed))]"
										layoutpolicy_horizontal = expanding
										autoresize = yes
										align = left|nobaseline
										text = "[TradeOrderGoodsEntryItem.GetDisplayName]"
									}

									text_single = {
										visible = "[And(TradeOrderGoodsEntryItem.GetIsAny, TradeOrderGoodsEntryItem.GetIsNeed)]"
										layoutpolicy_horizontal = expanding
										autoresize = yes
										align = left|nobaseline
										text = "[TradeOrderGoodsEntryItem.GetDisplayName]"
										default_format = "#L"
										tooltipwidget = {
											SimpleContextualTooltipType = {
												blockoverride "title_icon" {
													texture = "[GetConceptTexture('good')]"
												}
												blockoverride "title_text" {
													text = "TRADE_ORDER_NEEDS_QUALIFYING_GOODS_TT"
												}
												blockoverride "tooltip_content" {
													TooltipScrolledStringPairList = {
														blockoverride "block_title" {
															block "block_title" {
																visible = no
															}
														}
														blockoverride "block_scrollarea" { maximumsize = { -1 150 } }
														textcontext = "[TradeOrderGoodsEntryItem.GetQualifyingNeedGoodsTooltip]"
													}
												}
											}
										}
									}
								}

								blockoverride "field_right" {}
							}

							TooltipTableColumn = {
								layoutpolicy_horizontal = fixed

								blockoverride "field_left" {
									tooltipwidget = { using = trade_order_good_trades_tooltip }
									expand = {}
								}

								blockoverride "tooltip_table_text_single" {
									text_single = {
										visible = "[And(Not(TradeOrderGoodsEntryItem.GetIsAny), TradeOrderGoodsEntryItem.HasTrend)]"
										autoresize = yes
										align = right|nobaseline
										text = "[TradeOrderGoodsEntryItem.GetTrendIcon]"
									}
								}

								blockoverride "field_right" {}
							}

							TooltipTableColumn = {
								layoutpolicy_horizontal = fixed

								blockoverride "field_left" {
									tooltipwidget = { using = trade_order_good_trades_tooltip }
									expand = {}
								}

								blockoverride "field_text_visibility" {
									visible = "[GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0')]"
								}

								blockoverride "field_text" {
									align = right|nobaseline
									raw_text = "[TradeOrderGoodsEntryItem.GetTradeCount]@trade!"
								}

								blockoverride "field_right" {}
							}

							TooltipTableColumn = {
								layoutpolicy_horizontal = fixed

								blockoverride "field_left" {
									tooltipwidget = { using = trade_order_good_trades_tooltip }
									expand = {}
								}

								blockoverride "field_text_visibility" {
									visible = "[GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0')]"
								}

								blockoverride "field_text" {
									align = right|nobaseline
									raw_text = "[TradeOrderGoodsEntryItem.GetProfitPerTC|+=2]@profit_trade!"
								}

								blockoverride "field_right" {}
							}

							TooltipTableColumn = {
								layoutpolicy_horizontal = fixed

								blockoverride "field_left" {
									tooltipwidget = { using = trade_order_good_trades_tooltip }
									expand = {}
								}

								blockoverride "field_text_visibility" {
									visible = "[GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0')]"
								}

								blockoverride "field_text" {
									align = right|nobaseline
									raw_text = "[TradeOrderGoodsEntryItem.GetAllocatedTC|2]@trade_capacity!"
								}

								blockoverride "field_right" {}
							}

							blockoverride "column_datamodel" { datamodel = "[TradeOrderLateralView.GetGoodsEntries]" }
						}
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[TradeOrderLateralView.IsEditingTradeOrder]"

				TooltipTextBlock = {
					visible = "[And(TradeOrderItem.GetUseMinProfit, GreaterThan_int32(TradeOrderItem.GetTradeCount, '(int32)0'))]"
					blockoverride "text" {
						text = "TRADE_ORDER_TRADES_TOOLTIP_SUMMARY_MIN"
					}
				}
				TooltipTextBlock = {
					visible = "[And(Not(TradeOrderItem.GetUseMinProfit), GreaterThan_int32(TradeOrderItem.GetTradeCount, '(int32)0'))]"
					blockoverride "text" {
						text = "TRADE_ORDER_TRADES_TOOLTIP_SUMMARY"
					}
				}

				TooltipTextBlock = {
					blockoverride "text" {
						text = "TRADE_ORDER_PRIORITY_INFO"
					}
				}

				TooltipScrolledStringPairList = {
					visible = "[GreaterThan_int32(TradeOrderItem.GetTradeCount, '(int32)0')]"
					tooltipmeta = {
						game_concept = "[trade_profit|e]"
						title = "[trade_profit]"
					}
					blockoverride "block_scrollarea" { maximumsize = { -1 200 } }
					textcontext = "[TradeOrderItem.GetTradesListTooltip]"
				}

				TooltipTextBlock = {
					visible = "[And(TradeOrderItem.GetUseMinProfit, Not(GreaterThan_int32(TradeOrderItem.GetTradeCount, '(int32)0')))]"
					blockoverride "text" {
						text = "TRADE_ORDER_TRADES_TOOLTIP_NONE_MIN"
					}
				}
				TooltipTextBlock = {
					visible = "[And(Not(TradeOrderItem.GetUseMinProfit), Not(GreaterThan_int32(TradeOrderItem.GetTradeCount, '(int32)0')))]"
					blockoverride "text" {
						text = "TRADE_ORDER_TRADES_TOOLTIP_NONE"
					}
				}
			}
		}
	}
}

types TradeOrderLateralViewTypes
{
	type TradeOrderPendingGoodsEntryRow = widget {
		layoutpolicy_horizontal = expanding
		size = { -1 38 }

		hbox = {
			margin_right = 10
			spacing = 5

			widget = {
				using = layoutpolicy_expanding
				card_list_button = {
					size = { 100% 100% }
					tooltipwidget = { using = trade_order_good_trades_tooltip }
					action_tooltip = {
						click_type = right
						click_mode = single
						title = "TRADE_ORDER_GOOD_ENTRY_REMOVE_TT"
						on_action = "[TradeOrderGoodsEntryItem.Remove]"
					}
				}
		
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 4 }
					spacing = 6
		
					widget = {
						size = { 26 26 }
						visible = "[Not(TradeOrderGoodsEntryItem.GetIsAny)]"
						# icon = {
						# 	size = { 26 26 }
						# 	texture = "[GetGoodsIcon(TradeOrderGoodsEntryItem.GetGoods)]"
						# }
						icon = {
							visible = "[TradeOrderGoodsEntryItem.GetIsImport]"
							size = { 26 26 }
							texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
						}
						icon = {
							visible = "[Not(TradeOrderGoodsEntryItem.GetIsImport)]"
							size = { 26 26 }
							texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
						}
					}

					icon  = {
						visible = "[Not(TradeOrderGoodsEntryItem.GetIsAny)]"
						size = { 26 26 }
						datacontext = "[TradeOrderGoodsEntryItem.GetGoods]"
						texture = "[GetGoodsIcon(Goods.Self)]"
					}
		
					icon = {
						size = { 26 26 }
						visible = "[And(And(TradeOrderGoodsEntryItem.GetIsAny, TradeOrderGoodsEntryItem.GetIsImport), Not(TradeOrderGoodsEntryItem.GetIsNeed))]"
						texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
					}
					icon = {
						size = { 26 26 }
						visible = "[And(And(TradeOrderGoodsEntryItem.GetIsAny, Not(TradeOrderGoodsEntryItem.GetIsImport)), Not(TradeOrderGoodsEntryItem.GetIsNeed))]"
						texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
					}
					widget = {
						size = { 26 26 }
						visible = "[TradeOrderGoodsEntryItem.GetIsNeed]"
						icon = {
							size = { 26 26 }
							visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)1')]"
							texture = "gfx/interface/icons/alerts_icons/constructions_missing_input.dds"
						}
						icon = {
							size = { 26 26 }
							visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)2')]"
							texture = "gfx/interface/icons/alerts_icons/buildings_missing_input.dds"
						}
						icon = {
							size = { 26 26 }
							visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)3')]"
							texture = "gfx/interface/icons/alerts_icons/pops_wanting_stuff.dds"
						}
						icon = {
							size = { 26 26 }
							visible = "[EqualTo_int32(TradeOrderGoodsEntryItem.GetNeedCategory, '(int32)4')]"
							texture = "gfx/interface/icons/flat_icons/trade_market/trade_categories/profitable_food_trades.dds"
						}
						icon = {
							visible = "[TradeOrderGoodsEntryItem.GetIsImport]"
							parentanchor = bottom|right
							size = { 12 12 }
							texture = "gfx/interface/icons/flat_icons/trade_market/import.dds"
						}
						icon = {
							visible = "[Not(TradeOrderGoodsEntryItem.GetIsImport)]"
							parentanchor = bottom|right
							size = { 12 12 }
							texture = "gfx/interface/icons/flat_icons/trade_market/export.dds"
						}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						autoresize = no
						align = left|nobaseline
						fontsize = 13
						text = "[TradeOrderGoodsEntryItem.GetDisplayName]"
					}
		
					hbox = {
						visible = "[GreaterThan_int32(TradeOrderGoodsEntryItem.GetTradeCount, '(int32)0')]"
						spacing = 6

						text_single = {
							size = { 15 15 }
							autoresize = no
							align = left|nobaseline
							using = Font_Size_Small
							text = "[TradeOrderGoodsEntryItem.GetTrendIcon]"
						}
						text_single = {
							size = { 50 15 }
							autoresize = no
							align = right|nobaseline
							using = Font_Size_Small
							raw_text = "[TradeOrderGoodsEntryItem.GetTradeCount]@trade!"
						}
						text_single = {
							size = { 70 15 }
							autoresize = no
							align = right|nobaseline
							using = Font_Size_Small
							raw_text = "[TradeOrderGoodsEntryItem.GetProfitPerTC|+=2]@profit_trade!"
						}

						hbox = {
							using = bg_number_container_bckg
							blockoverride "number_container_extra" {
								alpha = 0.4
								margin = {2 4}
							}
							text_single = {
								size = { 60 15 }
								autoresize = no
								align = right|nobaseline
								using = Font_Size_Small
								raw_text = "[TradeOrderGoodsEntryItem.GetAllocatedTC|2]@trade_capacity!"
							}
						}
					}
		
					icon = {
						size = { 20 20 }
						visible = "[TradeOrderGoodsEntryItem.IsIgnoredInFoodMode]"
						using = warning_icon_texture
					}
		
				}
			}
	
			vbox = {
				spacing = 4
				visible = "[EqualTo_int32(TradeOrderLateralView.GetMode, '(int32)2')]"
	
				button_square_plus = {
					size = { 15 15 }
					enabled = "[TradeOrderGoodsEntryItem.CanMoveUp]"
					tooltipwidget = { BasicFunctionalTooltip = {} }
					blockoverride "plusminus_icon" {
						texture = "gfx/interface/icons/outliner/arrow_down.dds"
						mirror = vertical
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						click_modifier = default
						title = "TRADE_ORDER_MOVE_UP_TT"
						enabled = "[TradeOrderGoodsEntryItem.CanMoveUp]"
						on_action = "[TradeOrderGoodsEntryItem.MoveUp]"
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						click_modifier = shift
						title = "TRADE_ORDER_MOVE_TO_TOP_TT"
						enabled = "[TradeOrderGoodsEntryItem.CanMoveUp]"
						on_action = "[TradeOrderGoodsEntryItem.MoveToTop]"
					}
				}
				button_square_plus = {
					size = { 15 15 }
					enabled = "[TradeOrderGoodsEntryItem.CanMoveDown]"
					tooltipwidget = { BasicFunctionalTooltip = {} }
					blockoverride "plusminus_icon" {
						texture = "gfx/interface/icons/outliner/arrow_down.dds"
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						click_modifier = default
						title = "TRADE_ORDER_MOVE_DOWN_TT"
						enabled = "[TradeOrderGoodsEntryItem.CanMoveDown]"
						on_action = "[TradeOrderGoodsEntryItem.MoveDown]"
					}
					action_tooltip = {
						click_type = left
						click_mode = single
						click_modifier = shift
						title = "TRADE_ORDER_MOVE_TO_BOTTOM_TT"
						enabled = "[TradeOrderGoodsEntryItem.CanMoveDown]"
						on_action = "[TradeOrderGoodsEntryItem.MoveToBottom]"
					}
				}
			}
		}

	}

	type TradeOrderMarketToggleRow = widget {
		size = { 100% 32 }
		layoutpolicy_horizontal = expanding

		hbox = {
			checkbox_square_alt = {
				size = { 32 32 }
				action_tooltip = {
					click_type = left
					click_mode = single
					title = "[Market.GetNameWithNoTooltip]"
					enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"
					conditions = "[MakeItFailIfLoc(Not(TradeOrderLateralView.IsMarketSelectionEnabled), 'TRADE_ORDER_MARKET_CUSTOM_DISABLED_TT')]"
					on_action = "[TradeOrderLateralView.ToggleMarketInPanel(Market.Self)]"
				}
	
				action_tooltip = {
					click_type = right
					click_mode = single
					title = "[SelectLocalization( TradeOrderLateralView.IsMarketSelectedInPanel(Market.Self), 'TRADE_ORDER_MARKET_DESELECT_ALL_TT', 'TRADE_ORDER_MARKET_SELECT_ALL_TT' )]"
					enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"
					conditions = "[MakeItFailIfLoc(Not(TradeOrderLateralView.IsMarketSelectionEnabled), 'TRADE_ORDER_MARKET_CUSTOM_DISABLED_TT')]"
					on_action = "[TradeOrderLateralView.ToggleAllMarketsInPanel(Market.Self)]"
				}
				down = "[TradeOrderLateralView.IsMarketSelectedInPanel(Market.Self)]"
				tooltipwidget = { BasicFunctionalTooltip = {} }
				enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"
			}

			widget = {
				using = layoutpolicy_expanding
				hbox = {
					using = bg_paper_card
					using = bg_card_header_01
					
					blockoverride "header_pattern_alpha" { alpha = 0.5 }

					blockoverride "bg_card_header_01_bg" {
						background = {
							visible = "[GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0')]"
							using = color_society_texture
							alpha = 0.8
						}
						background = {
							visible = "[And(Not(GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0')),
							GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0'))]"
							using = color_market_blue_texture
							alpha = 1
						}
						background = {
							visible = "[And(Not(Or(GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0'),
							GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0'))), IsMarketInRange(Market.Self))]"
							using = color_bg_brown_texture
							alpha = 1
						}
						background = {
							visible = "[And(Not(Or(GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0'),
							GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0'))), Not(IsMarketInRange(Market.Self)))]"
							using = color_grey_texture
							alpha = 0.8
						}
						background = {
							texture = "[GetGraphicalCultureTexture('top_header_bg')]"
							texture_density = 2.4
							spriteType = corneredtiled
							spriteborder = { 0 0 }
							alpha = 0.2
						}
					}

					blockoverride "header_color" {
						using = color_diplomacy_texture
					}

					card_header_button_04 = {
						using = layoutpolicy_expanding

						action_tooltip = {
							click_type = left
							click_mode = single
							title = "[Market.GetNameWithNoTooltip]"
							enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"
							conditions = "[MakeItFailIfLoc(Not(TradeOrderLateralView.IsMarketSelectionEnabled), 'TRADE_ORDER_MARKET_CUSTOM_DISABLED_TT')]"
							on_action = "[TradeOrderLateralView.ToggleMarketInPanel(Market.Self)]"
						}
			
						action_tooltip = {
							click_type = right
							click_mode = single
							title = "[SelectLocalization( TradeOrderLateralView.IsMarketSelectedInPanel(Market.Self), 'TRADE_ORDER_MARKET_DESELECT_ALL_TT', 'TRADE_ORDER_MARKET_SELECT_ALL_TT' )]"
							enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"
							conditions = "[MakeItFailIfLoc(Not(TradeOrderLateralView.IsMarketSelectionEnabled), 'TRADE_ORDER_MARKET_CUSTOM_DISABLED_TT')]"
							on_action = "[TradeOrderLateralView.ToggleAllMarketsInPanel(Market.Self)]"
						}

						onmousehierarchyenter = "[PdxGuiWidget.SetHighlightMarket(Market.Self)]"
						ondoubleclick = "[PanToLocation(Market.GetCenterLocation)]"
						enabled = "[TradeOrderLateralView.IsMarketSelectionEnabled]"

						tooltipwidget = {
							using = Market_tooltip
						}

						hbox = {
							margin = {5 0}

							using = bg_black_fade_horizontal

							hbox = {
								spacing = 5

								country_flag_very_small = {
									datacontext = "[Market.GetOwner]"
								}
								text_single = {
									align = center|nobaseline
									maximumsize = {230 -1}
									fontsize_min = 12
									text = "[Market.GetNameWithNoTooltip]"
								}
							}

							expand = {}

							text_single = {
								visible = "[TradeOrderLateralView.IncludesSlaves]"
								raw_text = "[Market.GetUnemployedSlavePopsInMarketText][Market.GetSlaveTradeNetChangeText] @slaves!"
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_text" { text = "TRADE_UNEMPLOYED_SLAVE_POPS" }
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/pops/slaves.dds"
											}
										}
										blockoverride "concept_link" { text = "[slavery|E]" }
										blockoverride "tooltip_content" {
											TooltipTextBlock = {
												blockoverride "text" { text = "TRADE_UNEMPLOYED_SLAVE_POPS_DESC" }
											}
		
											TooltipScrolledStringPairList = {
												visible = "[Not(StringIsEmpty(Market.GetUnemployedSlavePopsBreakdown))]"
												blockoverride "block_scrollarea" { maximumsize = { -1 420 } }
												textcontext = "[Market.GetUnemployedSlavePopsBreakdown]"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}


	type trade_order_good_market_info = hbox {
		widget = {
			layoutpolicy_vertical = expanding
			size = { 65 -1 }
			datacontext = "[Market.GetMarketEntry(Goods.Self)]"
			sort_by_small_highlight = { name = "goods_local_balance" }
			tooltipwidget = { using = goods_market_local_balance_tooltip }
			hbox = {
				parentanchor = vcenter
				expand = {}
				hbox = {
					spacing = 3
					text_single = {
						autoresize = yes
						align = right|nobaseline
						using = Font_Size_Small
						text = "[Market.GetBalanceWithoutTrades(Goods.Self)|+=2]"
					}
					icon = { size = { 16 16 } texture = "[GetConceptTexture('goods')]" }
				}
			}
		}

		widget = {
			layoutpolicy_vertical = expanding
			size = { 65 -1 }
			datacontext = "[Market.GetMarketEntry(Goods.Self)]"
			sort_by_small_highlight = { name = "goods_imports" }
