lateralview = {
	name = "building_view"
	size = { 760 100% } # PP: wider than the vanilla left panel (570) for the slot columns
	widget = { # PP: pp_panel_width for the search filter menu
		size = { 0 0 }
		visible_at_creation = no
		visible = "[Not(BuildingView.Vars.HasValue('pp_panel_width', '760'))]"
		state = {
			name = _show
			on_start = "[BuildingView.Vars.Set('pp_panel_width', '760')]"
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			using = bg_main_inner_alt
			blockoverride "window_header_alt_color_texture"{
				using = color_default_brown_texture
			}
			
			blockoverride "header_text_object" {
				hbox = {
					hbox = {
						spacing = 5
						country_flag_small = {
							visible = "[BuildingView.IsMultiselection]"
							datacontext = "[BuildingView.GetBuilding.GetOwner]"
						}
						icon = {
							size = { 30 30 }
							texture = "[GetBuildingIcon(BuildingView.GetBuilding.GetType.Self)]"
						}
						text_single = {
							align = center|nobaseline
							using = Font_Type_Headers
							using = Font_Size_Big
					
							text = "[BuildingView.GetTitle]"
							default_format = "#yellow_titles"
							maximumsize = { 610 -1 }
						}
					}
				}
			}
		}
	}

	blockoverride "panel_content" {
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 220 }
				using = bg_age_event_frame

				background = {
					texture =  "[GetGoodsIllustration(BuildingView.GetGoods)]"
					texture_density = 2
					alpha = 0.5
					spriteType = stretched
					spriteborder = { 0 0 }
				}

				datacontext = "[BuildingView.GetBuilding]"	
				widget = { # establishment piechart
					size = { 100 100 }
					visible = "[Building.GetHasEstablishmentRamp]"
					parentanchor = center
					piechart = {
						parentanchor = center
						using = bg_circle_piechart
						size = { 100 100 }
						using = piechart_angles
						pieslice_no_highlight = {
							filter_mouse = none
							alwaystransparent = yes
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
							value = "[FixedPointToFloat(Building.GetEstablishmentProgressFraction)]"
							color = { 1 1 1 1 }
						}
						pieslice_no_highlight = {
							filter_mouse = none
							alwaystransparent = yes
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
							value = "[Subtract_float('(float)1.0', FixedPointToFloat(Building.GetEstablishmentProgressFraction))]"
							color = { 1 1 1 0 }
						}
						icon = {
							parentanchor = center
							size = { 60 60 }
							texture = "gfx/interface/icons/flat_icons/building_panel/establishment.dds"
						}
					}
					tooltipwidget = {
						SimpleContextualStringPairTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/flat_icons/building_panel/establishment.dds"
								}
							}
							blockoverride "concept_link" {
								text = "[establishment|e]"
							}
							blockoverride "tooltip_textcontext" {
								textcontext = "[Building.GetEstablishmentTooltip]"
							}
						}
					}
				}
			}

			### INNER MIDDLE TAB SYSTEM
			header_secondary_tabs = {
				blockoverride "content" {
					datacontext = "[BuildingView.GetBuilding]"							
					hbox = {
						margin_left = 12
						using = layoutpolicy_expanding
						maximumsize = { -1 80 }
	
						background = {
							using = button_secondary_tab_alt_color
							using = button_main_tab_icon_texture
						}

						vbox = {
							layoutpolicy_vertical = expanding
							expand = {}
							header_button_left = {
								size = {30 30}
								blockoverride "button_icon_stretch_sprite" {}
								blockoverride "header_button_frame_inner" {visible = no}
								blockoverride "header_button_icon_size" { size = {30 30} }
								blockoverride "header_button_text_layout" {}
	
								blockoverride "icon_texture" {
									texture = "gfx/interface/buttons/flats/history.dds"
									texture_density = 2
								}
	
								blockoverride "icon_replace" {
									icon = {
										parentanchor = center
										widgetanchor = center
										size = { 25 25 }
										visible = "[Not(Building.IsProductionMethodsLocked)]"
					
										texture = "gfx/interface/icons/map_subdivisons/unlocked.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.6
										}
									}
									icon = {
										parentanchor = center
										widgetanchor = center
										size = { 25 25 }
										visible = "[Building.IsProductionMethodsLocked]"
	
										texture = "gfx/interface/icons/map_subdivisons/locked.dds"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.6
										}
									}
	
								}
								action_tooltip = {
									on_action = "[LockProductionMethods(Building.Self)]"
								}
	
								tooltipwidget = {
									SimpleContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												visible = "[Not(Building.IsProductionMethodsLocked)]"
												texture = "gfx/interface/icons/map_subdivisons/unlocked.dds"
											}
											icon = {
												using = tooltip_title_icon_size
												visible = "[Building.IsProductionMethodsLocked]"
												texture = "gfx/interface/icons/map_subdivisons/locked.dds"
											}
										}
	
										blockoverride "concept_link" {
											raw_text = "[production_method|e]"
										}
										lowpriotextcontext =  "[SelectLocalization(Building.IsProductionMethodsLocked, 'PM_IS_LOCKED', 'PM_IS_UNLOCKED' )]"
									}
								}
								action_tooltip = {
									click_type = left
									title = "LOCK_PM"
									visible = "[Not(Building.IsProductionMethodsLocked)]"
									on_action = "[LockProductionMethods(Building.Self)]"
									description = "PM_IS_UNLOCKED"
								}
								action_tooltip = {
									click_type = left
									title = "UNLOCK_PM"
									visible = "[Building.IsProductionMethodsLocked]"
									on_action = "[LockProductionMethods(Building.Self)]"
									description = "PM_IS_LOCKED"
								}
							}
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							size = {-1 40}
							autoresize = no
							align = center|nobaseline
							text = "game_concept_production_methods"
						}
					}
				}
			}

			vbox = {
				using = bg_secondary_inner_alt
				using = layoutpolicy_expanding

				datacontext = "[BuildingView.GetBuilding]"
				datacontext = "[BuildingView.GetBuilding.GetType]"
				datacontext = "[BuildingView.GetBuilding.GetLocation]"
				datacontext = "[BuildingView.GetBuilding.GetLocation.GetMarket]"

