				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					widget = {
						size = { -1 60 }
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							using = bg_cabinet_card_frame
							margin = { 5 5 }

							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 50 }

								tooltipwidget = {
									using = Building_tooltip
								}

								using = bg_building_card_colors
								blockoverride building_color_card_margins {}
								blockoverride building_color_grey_margins {}
								blockoverride "building_main_texture" {
									using = color_grey_texture
								}
								blockoverride "building_color" {
									color = "[BuildingType.GetPopType.GetColor]"
									alpha = 0.7
									blend_mode = overlay
								}

								icon = {
									size = {100% 100%}
									visible = "[BuildingType.GetPopType.IsClergy]"
									using = color_black_texture
									alpha = 0.2
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									maximumsize = { -1 50 }
									ignoreinvisible = yes
									spacing = 6
									margin_left = 3
									margin_right = 3

									widget = {
										size = { 40 -1 }
										piechart = {
											parentanchor = center
