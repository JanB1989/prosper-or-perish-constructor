						ContextMenuEntry = {
							visible = "[Location.ShowMoveCapital]"

							blockoverride "onclick" {
								enabled = "[Player.CanMoveCapitalToLocation(Location.Self)]"

								tooltipwidget = {
									using = move_capital_context_menu_tooltip
