						targetted_button_regular = {
							using = contextmenu_entry_button_inner_template
							layoutpolicy_horizontal = expanding
							size = { -1 35 }
							visible = "[PdxGuiWidget.IsUberButtonVisible]"
							name = "periphora"
							datacontext = "[Location]"
							scripted_action_tooltip = {
								click_type = left
