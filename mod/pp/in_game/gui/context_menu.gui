				blockoverride "entry_icon_texture" {
					texture = "[GetConceptTexture('building')]"
				}

				blockoverride "entry_text" {
					text = "BROWSE_BUILDINGS"
				}
			}

			ContextMenuEntry = {
				visible = "[Goods.IsRawMaterial]"
