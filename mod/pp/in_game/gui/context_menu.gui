					margin = { 10 5 }
					spacing = 5

					using = bg_paper_card

					blockoverride "card_texture_extra" {
						modify_texture = {
							using = color_black_texture
							blend_mode = multiply
							alpha = 0.3
						}
					}

					icon = {
						size = { 30 30 }
						texture = "[GetConceptTexture('imports')]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						fontsize_min = 10
						autoresize = no
