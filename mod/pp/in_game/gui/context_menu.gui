								action_tooltip = {
									click_type = left
									click_mode = single
									title = "MOVE_CAPITAL"
									enabled = "[Player.CanMoveCapitalToLocation(Location.Self)]"
									conditions = "[Player.GetMoveCapitalToLocationConditions(Location.Self)]"
									on_action = "[MoveCapitalHere(Location.Self)]"
								}
							}

							blockoverride "entry_icon_texture" {
								texture = "gfx/interface/buttons/flats/move_capital_button.dds"
								using = ui_direction_button_overlay
							}

							blockoverride "entry_text" {
								text = "MOVE_CAPITAL"
							}
						}

						targetted_button_regular = {
							using = contextmenu_entry_button_inner_template
							layoutpolicy_horizontal = expanding
							size = { -1 35 }
							name = "create_colonial_charter"
							datacontext = "[Location.GetProvinceDefinition]"
							visible = "[And(PdxGuiWidget.IsUberButtonVisible, PdxGuiWidget.IsUberButtonEnabled)]"
