						}

						action_tooltip = {
							title = "TAB_TOOLTIP_PRODUCTION_LEFT_CLICK"
							on_action = "[ToggleLateralGroup('production_group')]"
							on_action = "[SetNonForeignUIFocusMarket]"
						}

						input_action = "top_left_3"

						using = layoutpolicy_expanding

						panel_tab_highlight = {
							visible = "[IsLateralGroupHighlighted('production_group')]"
						}

						button = {
							alwaystransparent = yes
