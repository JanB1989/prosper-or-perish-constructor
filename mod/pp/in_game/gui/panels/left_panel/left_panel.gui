					button_panel_tab_alt = { ### PP: Construction Plan tab (tools/port_vanilla_gui.py, port_left_panel)
						visible = "[And(GetPlayer.Exists, Not(IsObserving))]"
						down = "[GetVariableSystem.Exists('pp_cplan_open')]"
						onmousehierarchyenter = "[ResetHighlightedTab]"
						tooltip = "PP_CPLAN_OPEN_TT"
