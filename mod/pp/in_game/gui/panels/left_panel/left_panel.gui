						input_action = "top_left_4"

						using = layoutpolicy_expanding

						panel_tab_highlight = {
							visible = "[IsLateralGroupHighlighted('society_group')]"
						}

						button = {
							alwaystransparent = yes
							size = { 26 26 }
							parentanchor = center
