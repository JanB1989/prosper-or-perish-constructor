			window_header_alt = {
				blockoverride "header_text" {
					text = "PP_CPLAN_TITLE"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 6 }
				spacing = 4
				pp_cplan_tab_button = {
					text = "PP_CPLAN_TAB_PLAN"
					tooltip = "PP_CPLAN_TAB_PLAN_TT"
