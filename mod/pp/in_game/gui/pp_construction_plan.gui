# Prosper or Perish - Construction Plan panel (branch player-construction-manager, 2026-11-06, Jan).
# A scripted widget (gui/scripted_widgets/pp_construction_plan.txt), so no vanilla window is overridden. It holds the
# opener button and the panel: tabs Plan / Food / Goods / Logistics (the global rules), Locations (every location's
# mode) and Here (one location's own rules, picked in Locations or with the cog in the location window).
# Every button runs a scripted GUI in common/scripted_guis/pp_construction_plan.txt; every number is a script value
# (common/script_values/pp_construction_plan*.txt). Payback shown for a building is the engine's own: the next level's
# build cost (GetBuildOrExpandBuildingCost) over its profit per level here (GetBuildingTypeProfitInLocation).
# Generated parts: pp_construction_plan_goods.gui (Goods rows), pp_construction_plan_here.gui (rule rows).
# Shown only to a player who plays a country (not to observers: their scripted GUIs do nothing).

types PPConstructionPlan
{
	type pp_cplan_tab_button = button_regular {
		size = { 104 30 }
	}

	type pp_cplan_mode_button = button_regular {
		size = { 66 26 }
	}

	type pp_cplan_step_button = button_regular {
		size = { 26 24 }
		tooltip = "PP_CPLAN_STEP_TT"
	}

	type pp_cplan_switch_button = button_regular {
		size = { 70 26 }
		tooltip = "PP_CPLAN_SWITCH_TT"
	}

	type pp_cplan_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_cplan_note = text_multi {
		autoresize = yes
		maximumsize = { 620 -1 }
		minimumsize = { 620 -1 }
		default_format = "#weak"
	}

	type pp_cplan_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}

	type pp_cplan_months_pie = piechart {
		size = { 24 24 }
		using = bg_circle
		using = bg_circle_piechart
		using = piechart_angles
		pieslice_no_highlight = {
			texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
			block "pp_cplan_fill" { value = 0 }
			color = { 1 1 1 1 }
		}
		pieslice_no_highlight = {
			texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
			block "pp_cplan_rest" { value = 1 }
			color = { 1 1 1 1 }
		}
	}

	# The mode of the location in the datacontext, click for the next (the plan's rules / own rules / hands off).
	type pp_cplan_location_mode_button = button_regular {
		size = { 120 26 }
		tooltip = "PP_CPLAN_LOCATION_MODE_TT"
		onclick = "[GetScriptedGui('pp_cplan_cycle_mode').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
		text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)0')]" text = "PP_CPLAN_MODE_PLAN" }
		text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)1')]" text = "PP_CPLAN_MODE_OWN" }
		text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)2')]" text = "PP_CPLAN_MODE_HANDS_OFF" }
	}
}

# ---- Opener (its own scripted widget: a widget only takes mouse input inside its parent's rectangle) ----
widget = {
	name = "pp_construction_plan"
	position = { 36 236 }
	size = { 170 32 }
	# scripted widgets need a function here; "yes" does not work
	visible = "[And(GetPlayer.Exists, Not(IsObserving))]"

	button_regular = {
		name = "pp_cplan_opener"
		size = { 170 32 }
		text = "PP_CPLAN_OPEN"
		tooltip = "PP_CPLAN_OPEN_TT"
		onclick = "[GetVariableSystem.Toggle('pp_cplan_open')]"
	}
}

# ---- Panel ----
	window = {
		name = "pp_construction_plan_window"
		visible = "[And3(GetVariableSystem.Exists('pp_cplan_open'), GetPlayer.Exists, Not(IsObserving))]"
		position = { 90 110 }
		size = { 690 800 }
		movable = yes
		using = bg_window_default_alt
		filter_mouse = all

		vbox = {
