						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('yard_payback')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('yard_payback')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}
					pp_cplan_note = { text = "PP_CPLAN_FOOD_NOTE" }

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.GetProvinces]"
								item = {
									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 4 4 }
										spacing = 2
										background = { using = bg_main_inner_notabs_alt }

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 6
											pp_cplan_label = { raw_text = "[Province.GetName]" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
											button_regular = {
												size = { 120 26 }
												tooltip = "PP_CPLAN_FOCUS_TT"
												onclick = "[GetScriptedGui('pp_cplan_cycle_focus').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)1')]" text = "PP_CPLAN_FOCUS_STANDARD" }
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)2')]" text = "PP_CPLAN_FOCUS_BREADBASKET" }
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)3')]" text = "PP_CPLAN_FOCUS_MARKET_TOWN" }
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)4')]" text = "PP_CPLAN_FOCUS_WORKSHOP" }
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)5')]" text = "PP_CPLAN_FOCUS_HANDS_OFF" }
												text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_focus_n'), '(CFixedPoint)6')]" text = "PP_CPLAN_FOCUS_CUSTOM" }
											}
											pp_cplan_months_pie = {
												tooltip = "PP_CPLAN_STORED_TT"
												blockoverride "pp_cplan_fill" { value = "[FixedPointToFloat(Divide_CFixedPoint(Min_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_stored_n'), '(CFixedPoint)24'), '(CFixedPoint)24'))]" }
												blockoverride "pp_cplan_rest" { value = "[Subtract_float('(float)1.0', FixedPointToFloat(Divide_CFixedPoint(Min_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_stored_n'), '(CFixedPoint)24'), '(CFixedPoint)24')))]" }
											}
											pp_cplan_label = { text = "PP_CPLAN_STORED_VALUE" minimumsize = { 70 -1 } }
											pp_cplan_label = { text = "PP_CPLAN_CAPACITY_VALUE" tooltip = "PP_CPLAN_CAPACITY_TT" }
											expand = {}
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 4
											pp_cplan_label = { text = "PP_CPLAN_BAND_BELOW" }
											pp_cplan_step_button = {
												text = "PP_CPLAN_MINUS"
												onclick = "[GetScriptedGui('pp_cplan_step_band').Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('pp_key', MakeScopeFlag('lo')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
											}
											pp_cplan_label = { raw_text = "[Province.MakeScope.ScriptValue('pp_cplan_band_lo')|0]" minimumsize = { 22 -1 } align = center|nobaseline }
											pp_cplan_step_button = {
												text = "PP_CPLAN_PLUS"
												onclick = "[GetScriptedGui('pp_cplan_step_band').Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('pp_key', MakeScopeFlag('lo')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
											}
											widget = { size = { 10 1 } }
											pp_cplan_label = { text = "PP_CPLAN_IN_A_YEAR" tooltip = "PP_CPLAN_IN_A_YEAR_TT" }
											expand = {}
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 4
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)0')]" text = "PP_CPLAN_ST_0" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)1')]" text = "PP_CPLAN_ST_1" }
											hbox = {
												visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)1')]"
												datamodel = "[Province.MakeScope.GetList('pp_cplan_status_types')]"
												spacing = 4
												item = {
													pp_cplan_label = { raw_text = "[Scope.GetBuildingType.GetName]" }
												}
											}
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)2')]" text = "PP_CPLAN_ST_2" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)3')]" text = "PP_CPLAN_ST_3" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)5')]" text = "PP_CPLAN_ST_5" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)7')]" text = "PP_CPLAN_ST_7" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)8')]" text = "PP_CPLAN_ST_8" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)9')]" text = "PP_CPLAN_ST_9" }
											pp_cplan_label = { visible = "[EqualTo_CFixedPoint(Province.MakeScope.ScriptValue('pp_cplan_status_n'), '(CFixedPoint)10')]" text = "PP_CPLAN_ST_10" }
											expand = {}
										}
									}
								}
							}
						}
					}
				}

				# ======================== Goods ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'goods')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 6 6 }
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_KEEP" tooltip = "PP_CPLAN_KEEP_TT" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_KEEP_VALUE" }
						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('keep')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('keep')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_PAYBACK_LINE" tooltip = "PP_CPLAN_PAYBACK_LINE_TT" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_PAYBACK_LINE_VALUE" }
						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('payback')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('payback')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}
					pp_cplan_note = { text = "PP_CPLAN_GOODS_NOTE" }

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							pp_cplan_goods_rows = {}
						}
					}
				}

				# ======================== Logistics ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'logistics')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 6 6 }
					spacing = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_ACCESS" tooltip = "PP_CPLAN_ACCESS_TT" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_ACCESS_VALUE" }
						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}
					pp_cplan_note = { text = "PP_CPLAN_LOGISTICS_NOTE" }

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							flowcontainer = {
								direction = vertical
								ignoreinvisible = yes
								datamodel = "[GetPlayer.GetProvinces]"
								item = {
									flowcontainer = {
										direction = vertical
										ignoreinvisible = yes
										datamodel = "[Province.GetLocations]"
										item = {
											# a container takes no hbox as a direct child: the row is a widget holding the hbox
											widget = {
												visible = "[GetScriptedGui('pp_cplan_logistics_row').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
												size = { 600 30 }
												hbox = {
													using = layoutpolicy_expanding
													spacing = 6
													margin = { 4 2 }
													pp_cplan_label = { raw_text = "[Location.GetName]" minimumsize = { 170 -1 } maximumsize = { 170 -1 } }
													pp_cplan_label = { text = "PP_CPLAN_ACCESS_HERE" minimumsize = { 60 -1 } tooltip = "PP_CPLAN_ACCESS_HERE_TT" }													button_regular = {
														size = { 120 26 }
														tooltip = "PP_CPLAN_LOGI_TT"
														onclick = "[GetScriptedGui('pp_cplan_cycle_logi').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
														text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_logi_n'), '(CFixedPoint)0')]" text = "PP_CPLAN_FOLLOW" }
														text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_logi_n'), '(CFixedPoint)1')]" text = "PP_CPLAN_ALWAYS" }
														text_single = { parentanchor = center visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_logi_n'), '(CFixedPoint)2')]" text = "PP_CPLAN_NEVER" }
													}
													pp_cplan_location_mode_button = {}
													expand = {}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# ======================== Locations ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'locations')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 6 6 }
					spacing = 4

					pp_cplan_note = { text = "PP_CPLAN_LOCATIONS_NOTE" }

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							flowcontainer = {
								direction = vertical
								ignoreinvisible = yes
								datamodel = "[GetPlayer.GetProvinces]"
								item = {
									flowcontainer = {
										direction = vertical
										ignoreinvisible = yes
										widget = {
											size = { 600 30 }
											hbox = {
												using = layoutpolicy_expanding
												spacing = 6
												margin = { 4 2 }
												pp_cplan_label = { raw_text = "[Province.GetName]" default_format = "#high" }
												expand = {}
											}
										}
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datamodel = "[Province.GetLocations]"
											item = {
												widget = {
													size = { 600 28 }
													hbox = {
														using = layoutpolicy_expanding
														spacing = 6
														margin = { 14 1 }
														pp_cplan_label = { raw_text = "[Location.GetName]" minimumsize = { 160 -1 } maximumsize = { 160 -1 } }
														pp_cplan_location_mode_button = {}
														expand = {}
														button_regular = {
															size = { 60 24 }
															text = "PP_CPLAN_EDIT"
															action_tooltip = {
																click_type = left
																click_mode = single
																title = "PP_CPLAN_EDIT_TT"
																on_action = "[GetScriptedGui('pp_cplan_select').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
																on_action = "[GetVariableSystem.Set('pp_cplan_tab', 'here')]"
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# ======================== Here: one location's own rules ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'here')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 6 6 }
					spacing = 4

					pp_cplan_note = {
						visible = "[Not(GetPlayer.MakeScope.Var('pp_cplan_sel').IsSet)]"
						text = "PP_CPLAN_HERE_NONE"
					}

					vbox = {
						visible = "[GetPlayer.MakeScope.Var('pp_cplan_sel').IsSet]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						vbox = {
							datacontext = "[GetPlayer.MakeScope.Var('pp_cplan_sel').GetLocation]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 4

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								pp_cplan_label = { raw_text = "[Location.GetName]" fontsize = 20 }
								pp_cplan_label = { raw_text = "[Location.GetProvince.GetName]" default_format = "#weak" }
								expand = {}
								pp_cplan_location_mode_button = {}
								pp_cplan_step_button = {
									size = { 60 24 }
									text = "PP_CPLAN_GOTO"
									tooltip = "PP_CPLAN_GOTO_TT"
									onclick = "[PanToLocation(Location.Self)]"
								}
							}
							pp_cplan_note = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)0')]" text = "PP_CPLAN_HERE_MODE_PLAN" }
							pp_cplan_note = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)1')]" text = "PP_CPLAN_HERE_MODE_OWN" }
							pp_cplan_note = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_cplan_mode_n'), '(CFixedPoint)2')]" text = "PP_CPLAN_HERE_MODE_HANDS_OFF" }

							scrollarea = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								scrollbarpolicy_horizontal = always_off
								scrollbar_vertical = { using = Scrollbar_Vertical }
								scrollwidget = {
									vbox = {
										minimumsize = { 600 -1 }
										maximumsize = { 600 -1 }
										spacing = 4

										pp_cplan_title = { text = "PP_CPLAN_HERE_RULES" tooltip = "PP_CPLAN_HERE_RULES_TT" }
										pp_cplan_rule_row_1 = {}
										pp_cplan_rule_row_2 = {}
										pp_cplan_rule_row_3 = {}
										pp_cplan_rule_row_4 = {}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 6
											pp_cplan_title = { text = "PP_CPLAN_HERE_ADD" tooltip = "PP_CPLAN_HERE_ADD_TT" }
											expand = {}
											pp_cplan_step_button = {
												size = { 80 24 }
												text = "PP_CPLAN_REFRESH"
												tooltip = "PP_CPLAN_REFRESH_TT"
												onclick = "[GetScriptedGui('pp_cplan_refresh').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
											}
										}
										# standing here: payback from the profit one standing level makes (as the plan reckons it)
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datamodel = "[Location.MakeScope.GetList('pp_cplan_cands_built')]"
											item = {
												widget = {
													size = { 600 28 }
													hbox = {
														using = layoutpolicy_expanding
														spacing = 6
														margin = { 4 1 }
														datacontext = "[Scope.GetBuilding]"
														pp_cplan_label = { raw_text = "[Building.GetType.GetName]" minimumsize = { 210 -1 } maximumsize = { 210 -1 } }
														pp_cplan_label = {
															visible = "[GreaterThan_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0')]"
															text = "PP_CPLAN_PAYBACK_YEARS_STANDING"
															tooltip = "PP_CPLAN_PAYBACK_STANDING_TT"
														}
														pp_cplan_label = {
															visible = "[Not(GreaterThan_CFixedPoint(Building.GetProfitPerLevel, '(CFixedPoint)0'))]"
															text = "PP_CPLAN_PAYBACK_NONE"
															tooltip = "PP_CPLAN_PAYBACK_STANDING_TT"
														}
														expand = {}
														pp_cplan_step_button = {
															size = { 60 24 }
															text = "PP_CPLAN_ADD"
															tooltip = "PP_CPLAN_ADD_TT"
															onclick = "[GetScriptedGui('pp_cplan_add_rule').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_btype', Building.GetType.MakeScope).End)]"
														}
													}
												}
											}
										}
										# not standing yet: the engine's estimate for a new building here
										flowcontainer = {
											direction = vertical
											ignoreinvisible = yes
											datamodel = "[Location.MakeScope.GetList('pp_cplan_cands')]"
											item = {
												widget = {
													size = { 600 28 }
													hbox = {
														using = layoutpolicy_expanding
														spacing = 6
														margin = { 4 1 }
														datacontext = "[Scope.GetBuildingType]"
														pp_cplan_label = { raw_text = "[BuildingType.GetName]" minimumsize = { 210 -1 } maximumsize = { 210 -1 } }
														pp_cplan_label = {
															visible = "[GreaterThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0')]"
															text = "PP_CPLAN_PAYBACK_YEARS"
															tooltip = "PP_CPLAN_PAYBACK_TT"
														}
														pp_cplan_label = {
															visible = "[Not(GreaterThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0'))]"
															text = "PP_CPLAN_PAYBACK_NONE"
															tooltip = "PP_CPLAN_PAYBACK_TT"
														}
														expand = {}
														pp_cplan_step_button = {
															size = { 60 24 }
															text = "PP_CPLAN_ADD"
															tooltip = "PP_CPLAN_ADD_TT"
															onclick = "[GetScriptedGui('pp_cplan_add_rule').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_btype', BuildingType.MakeScope).End)]"
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			button_close_alt = {
				blockoverride "close_on_action" { on_action = "[GetVariableSystem.Clear('pp_cplan_open')]" }
			}
		}
	}
