# Prosper or Perish - Construction Plan window (branch player-construction-manager, 2026-11-06, Jan; two tabs since
# 2026-11-09, three since 2026-11-10). A scripted widget (gui/scripted_widgets/pp_construction_plan.txt), so no vanilla
# window is overridden.
# Tabs (vanilla main tabs): Global Settings (the plan on or off, the gold reserve, the six rule groups with their
# weight bars and lines, what the last pass built), Location Profiles (the editor, type pp_lprof_editor_tab in
# pp_location_profiles.gui) and Towns and Buildings (the settings of that rule group, type pp_cplan_country_tab,
# construction_plan_country.py). Each rule group row ends in a cog (pp_cplan_detail_button_<group>, since 2026-11-09,
# Jan: "what's happening under the hood"); it shows that group's detail pane (pp_cplan_detail_<group>: gold had,
# wanted, spent and waiting, its situation, the last 12 months, what it built and why) in place of the "Last month"
# list (pp_cplan_last_list). All three are generated into pp_construction_plan_detail.gui
# (construction_plan_detail.py).
# GUI variables: pp_cplan_open (window open), pp_cplan_tab ('profiles' = the second tab, 'country' = the third, anything
# else the first), pp_cplan_detail (the group whose pane is open; unset = the "Last month" list).
# Every button runs a scripted GUI in common/scripted_guis/pp_construction_plan.txt; every number is a script value
# (common/script_values/pp_construction_plan*.txt).
# Shown only to a player who plays a country (not to observers: their scripted GUIs do nothing).

types PPConstructionPlan
{
	type pp_cplan_step_button = button_regular {
		size = { 26 24 }
	}

	type pp_cplan_switch_button = button_regular {
		size = { 70 26 }
		tooltip = "PP_CPLAN_SWITCH_TT"
	}

	type pp_cplan_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_cplan_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}

	# In a list of the last pass's constructions (an item = a location): a town or city upgrade of the Towns and
	# Buildings group. An upgrade is no building, so the group's list of building types here does not hold it and
	# this names it (the location's pp_cplan_log_rank, set by that group; nothing shows blank).
	type pp_cplan_rank_upgrade = text_single {
		visible = "[Scope.Var('pp_cplan_log_rank').IsSet]"
		autoresize = yes
		align = left|nobaseline
		text = "PP_CPLAN_RANK_UPGRADE"
	}
}

# ---- Opener (its own scripted widget: a widget only takes mouse input inside its parent's rectangle) ----
widget = {
	name = "pp_construction_plan"
	position = { 36 236 }
	size = { 170 32 }
	# scripted widgets need a function here; "yes" does not work
	# (not on the pause menu: vanilla's own HUD parts ask IsPauseMenuShown; in game 2026-11-10 the button stood on it)
	visible = "[And3(GetPlayer.Exists, Not(IsObserving), Not(IsPauseMenuShown))]"

	button_regular = {
		name = "pp_cplan_opener"
		size = { 170 32 }
		text = "PP_CPLAN_OPEN"
		tooltip = "PP_CPLAN_OPEN_TT"
		onclick = "[GetVariableSystem.Toggle('pp_cplan_open')]"
		# the Towns and Buildings tab's grids: place the tiles (the window may open on that tab)
		onclick = "[GetScriptedGui('pp_cplan_country_layout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
}

# ---- Window ----
	window = {
		name = "pp_construction_plan_window"
		visible = "[And4(GetVariableSystem.Exists('pp_cplan_open'), GetPlayer.Exists, Not(IsObserving), Not(IsPauseMenuShown))]"
		position = { 90 110 }
		size = { 758 820 }
		movable = yes
		using = bg_window_default_alt
		filter_mouse = all

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" {
					text = "PP_CPLAN_TITLE"
				}
			}

			header_main_tabs = {
				layoutpolicy_horizontal = expanding
				blockoverride "content" {
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PLAN"
						}
						tooltip = "PP_CPLAN_TAB_PLAN_TT"
						down = "[Not(Or(GetVariableSystem.HasValue('pp_cplan_tab', 'profiles'), GetVariableSystem.HasValue('pp_cplan_tab', 'country')))]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'plan')]"
					}
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PROFILES"
						}
						tooltip = "PP_CPLAN_TAB_PROFILES_TT"
						down = "[GetVariableSystem.HasValue('pp_cplan_tab', 'profiles')]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'profiles')]"
					}
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_COUNTRY"
						}
						tooltip = "PP_CPLAN_TAB_COUNTRY_TT"
						down = "[GetVariableSystem.HasValue('pp_cplan_tab', 'country')]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'country')]"
						onclick = "[GetScriptedGui('pp_cplan_country_layout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				# ======================== Global settings ========================
				vbox = {
					visible = "[Not(Or(GetVariableSystem.HasValue('pp_cplan_tab', 'profiles'), GetVariableSystem.HasValue('pp_cplan_tab', 'country')))]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes # the closed detail panes take no spacing
					margin = { 10 8 }
					spacing = 8

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						pp_cplan_label = { text = "PP_CPLAN_MASTER" tooltip = "PP_CPLAN_MASTER_TT" fontsize = 18 }
						expand = {}
						pp_cplan_switch_button = {
							visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5')]"
							text = "PP_CPLAN_ON"
							onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						pp_cplan_switch_button = {
							visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5'))]"
							text = "PP_CPLAN_OFF"
							onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_RESERVE" tooltip = "PP_CPLAN_RESERVE_TT" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_RESERVE_VALUE" tooltip = "PP_CPLAN_RESERVE_TT" }
						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							tooltip = "PP_CPLAN_RESERVE_STEP_TT"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
							onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							tooltip = "PP_CPLAN_RESERVE_STEP_TT"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
							onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}

					# the rule groups: name, line, weight bar (generated, pp_construction_plan_weights.gui) with the part
					# in % and the gold the group has saved (its purse, since 2026-11-10), and the detail cog (generated,
					# pp_construction_plan_detail.gui); label 140 + line 190 + bar 294 + cog 26 + spacing fit the tab's
					# ~694 px (the window is 68 px wider for the saved gold)
					hbox = {
						layoutpolicy_horizontal = expanding
						pp_cplan_title = { text = "PP_CPLAN_RULES" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_SHARE_HEAD" tooltip = "PP_CPLAN_SHARE_TT" default_format = "#weak" }
					}

					# profiles
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_PROFILES_RULE" tooltip = "PP_CPLAN_PROFILES_RULE_TT" minimumsize = { 140 -1 } maximumsize = { 140 -1 } }
						widget = { size = { 190 1 } }
						expand = {}
						pp_cplan_weight_bar_profiles = {}
						pp_cplan_detail_button_profiles = {}
					}

					# food
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_FOOD_RULE" tooltip = "PP_CPLAN_FOOD_RULE_TT" minimumsize = { 140 -1 } maximumsize = { 140 -1 } }
						widget = { size = { 190 1 } }
						expand = {}
						pp_cplan_weight_bar_food = {}
						pp_cplan_detail_button_food = {}
					}

					# logistics
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_LOGISTICS_RULE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" minimumsize = { 140 -1 } maximumsize = { 140 -1 } }
						hbox = {
							minimumsize = { 190 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_ACCESS_VALUE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_logistics = {}
						pp_cplan_detail_button_logistics = {}
					}

					# improve
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_IMPROVE_RULE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" minimumsize = { 140 -1 } maximumsize = { 140 -1 } }
						hbox = {
							minimumsize = { 190 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_IMPROVE_LINE_VALUE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_improve = {}
						pp_cplan_detail_button_improve = {}
					}

					# business
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_BUSINESS_RULE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" minimumsize = { 140 -1 } maximumsize = { 140 -1 } }
						hbox = {
							minimumsize = { 190 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_BUSINESS_LINE_VALUE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_business = {}
						pp_cplan_detail_button_business = {}
					}

					# country (Towns and Buildings: its settings are on the third tab, so no line here; the longer
					# name takes the line's room: label 200 + 130 instead of 140 + 190)
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_COUNTRY_RULE" tooltip = "PP_CPLAN_COUNTRY_RULE_TT" minimumsize = { 200 -1 } maximumsize = { 200 -1 } }
						widget = { size = { 130 1 } }
						expand = {}
						pp_cplan_weight_bar_country = {}
						pp_cplan_detail_button_country = {}
					}

					# last month, everything the plan built; a rule group's cog shows its own pane here instead
					vbox = {
						visible = "[Not(GetVariableSystem.Exists('pp_cplan_detail'))]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 8

						pp_cplan_title = { text = "PP_CPLAN_LAST" }
						pp_cplan_label = { text = "PP_CPLAN_LAST_SUMMARY" }

						# a line per rule group and location (generated, pp_construction_plan_detail.gui)
						pp_cplan_last_list = {}
					}

					# the rule groups' detail panes (generated, pp_construction_plan_detail.gui)
					pp_cplan_detail_profiles = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'profiles')]" }
					pp_cplan_detail_food = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'food')]" }
					pp_cplan_detail_logistics = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'logistics')]" }
					pp_cplan_detail_improve = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'improve')]" }
					pp_cplan_detail_business = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'business')]" }
					pp_cplan_detail_country = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'country')]" }
				}

				# ======================== Location profiles ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'profiles')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					pp_lprof_editor_tab = {}
				}

				# ======================== Towns and Buildings ========================
				# (the settings of the rule group of that name; the type is construction_plan_country.py's)
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'country')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					pp_cplan_country_tab = {}
				}
			}
		}

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetVariableSystem.Clear('pp_cplan_open')]"
					on_action = "[GetVariableSystem.Clear('pp_lprof_pick')]"
					on_action = "[GetVariableSystem.Clear('pp_cplan_detail')]"
				}
			}
		}
	}
