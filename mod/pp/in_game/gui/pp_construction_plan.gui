# Prosper or Perish - Construction Plan window (branch player-construction-manager, 2026-11-06, Jan; two tabs since
# 2026-11-09). A scripted widget (gui/scripted_widgets/pp_construction_plan.txt), so no vanilla window is overridden.
# Tabs (vanilla main tabs): Global settings (the plan on or off, the gold reserve, the five rule groups with their
# weight bars and lines, what the last pass built) and Location profiles (the editor, type pp_lprof_editor_tab in
# pp_location_profiles.gui). GUI variables: pp_cplan_open (window open), pp_cplan_tab ('profiles' = the second tab).
# Every button runs a scripted GUI in common/scripted_guis/pp_construction_plan.txt; every number is a script value
# (common/script_values/pp_construction_plan*.txt).
# Shown only to a player who plays a country (not to observers: their scripted GUIs do nothing).

types PPConstructionPlan
{
	type pp_cplan_step_button = button_regular {
		size = { 26 24 }
	}

	type pp_cplan_switch_button = button_regular {
		size = { 70 26 }
		tooltip = "PP_CPLAN_SWITCH_TT"
	}

	type pp_cplan_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_cplan_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}
}

# ---- Opener (its own scripted widget: a widget only takes mouse input inside its parent's rectangle) ----
widget = {
	name = "pp_construction_plan"
	position = { 36 236 }
	size = { 170 32 }
	# scripted widgets need a function here; "yes" does not work
	visible = "[And(GetPlayer.Exists, Not(IsObserving))]"

	button_regular = {
		name = "pp_cplan_opener"
		size = { 170 32 }
		text = "PP_CPLAN_OPEN"
		tooltip = "PP_CPLAN_OPEN_TT"
		onclick = "[GetVariableSystem.Toggle('pp_cplan_open')]"
	}
}

# ---- Window ----
	window = {
		name = "pp_construction_plan_window"
		visible = "[And3(GetVariableSystem.Exists('pp_cplan_open'), GetPlayer.Exists, Not(IsObserving))]"
		position = { 90 110 }
		size = { 690 820 }
		movable = yes
		using = bg_window_default_alt
		filter_mouse = all

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" {
					text = "PP_CPLAN_TITLE"
				}
			}

			header_main_tabs = {
				layoutpolicy_horizontal = expanding
				blockoverride "content" {
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PLAN"
						}
						tooltip = "PP_CPLAN_TAB_PLAN_TT"
						down = "[Not(GetVariableSystem.HasValue('pp_cplan_tab', 'profiles'))]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'plan')]"
					}
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PROFILES"
						}
						tooltip = "PP_CPLAN_TAB_PROFILES_TT"
						down = "[GetVariableSystem.HasValue('pp_cplan_tab', 'profiles')]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'profiles')]"
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				# ======================== Global settings ========================
				vbox = {
					visible = "[Not(GetVariableSystem.HasValue('pp_cplan_tab', 'profiles'))]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 8 }
					spacing = 8

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						pp_cplan_label = { text = "PP_CPLAN_MASTER" tooltip = "PP_CPLAN_MASTER_TT" fontsize = 18 }
						expand = {}
						pp_cplan_switch_button = {
							visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5')]"
							text = "PP_CPLAN_ON"
							onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						pp_cplan_switch_button = {
							visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5'))]"
							text = "PP_CPLAN_OFF"
							onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_RESERVE" tooltip = "PP_CPLAN_RESERVE_TT" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_RESERVE_VALUE" tooltip = "PP_CPLAN_RESERVE_TT" }
						pp_cplan_step_button = {
							text = "PP_CPLAN_MINUS"
							tooltip = "PP_CPLAN_RESERVE_STEP_TT"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
							onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
						}
						pp_cplan_step_button = {
							text = "PP_CPLAN_PLUS"
							tooltip = "PP_CPLAN_RESERVE_STEP_TT"
							onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
							onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
						}
					}

					# the rule groups: name, line, weight bar (generated, pp_construction_plan_weights.gui) and part in %
					hbox = {
						layoutpolicy_horizontal = expanding
						pp_cplan_title = { text = "PP_CPLAN_RULES" }
						expand = {}
						pp_cplan_label = { text = "PP_CPLAN_SHARE_HEAD" tooltip = "PP_CPLAN_SHARE_TT" default_format = "#weak" }
					}

					# profiles
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_PROFILES_RULE" tooltip = "PP_CPLAN_PROFILES_RULE_TT" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
						widget = { size = { 220 1 } }
						expand = {}
						pp_cplan_weight_bar_profiles = {}
					}

					# food
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_FOOD_RULE" tooltip = "PP_CPLAN_FOOD_RULE_TT" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
						widget = { size = { 220 1 } }
						expand = {}
						pp_cplan_weight_bar_food = {}
					}

					# logistics
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_LOGISTICS_RULE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
						hbox = {
							minimumsize = { 220 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_ACCESS_VALUE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_logistics = {}
					}

					# improve
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_IMPROVE_RULE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
						hbox = {
							minimumsize = { 220 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_IMPROVE_LINE_VALUE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_improve = {}
					}

					# business
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_cplan_label = { text = "PP_CPLAN_BUSINESS_RULE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" minimumsize = { 150 -1 } maximumsize = { 150 -1 } }
						hbox = {
							minimumsize = { 220 -1 }
							spacing = 4
							pp_cplan_label = { text = "PP_CPLAN_BUSINESS_LINE_VALUE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" }
							expand = {}
							pp_cplan_step_button = { text = "PP_CPLAN_MINUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
							pp_cplan_step_button = { text = "PP_CPLAN_PLUS" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
						}
						expand = {}
						pp_cplan_weight_bar_business = {}
					}

					pp_cplan_title = { text = "PP_CPLAN_LAST" }
					pp_cplan_label = { text = "PP_CPLAN_LAST_SUMMARY" }

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							flowcontainer = {
								direction = vertical
								datamodel = "[GetPlayer.MakeScope.GetList('pp_cplan_log')]"
								item = {
									flowcontainer = {
										direction = horizontal
										spacing = 4
										margin = { 2 1 }
										flowcontainer = {
											direction = horizontal
											datamodel = "[Scope.GetList('pp_cplan_log_types')]"
											spacing = 4
											item = {
												pp_cplan_label = { raw_text = "[Scope.GetBuildingType.GetName]" }
											}
										}
										pp_cplan_label = { text = "PP_CPLAN_IN_LOCATION" }
										pp_cplan_label = {
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pp_cplan_why_n'), '(CFixedPoint)1')]"
											text = "PP_CPLAN_WHY_FOOD"
										}
										pp_cplan_label = {
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pp_cplan_why_n'), '(CFixedPoint)2')]"
											text = "PP_CPLAN_WHY_LOGISTICS"
										}
										pp_cplan_label = {
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pp_cplan_why_n'), '(CFixedPoint)3')]"
											text = "PP_CPLAN_WHY_BUSINESS"
										}
										pp_cplan_label = {
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pp_cplan_why_n'), '(CFixedPoint)5')]"
											text = "PP_CPLAN_WHY_PROFILE"
										}
										pp_cplan_label = {
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pp_cplan_why_n'), '(CFixedPoint)6')]"
											text = "PP_CPLAN_WHY_IMPROVE"
										}
									}
								}
							}
						}
					}
				}

				# ======================== Location profiles ========================
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'profiles')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					pp_lprof_editor_tab = {}
				}
			}
		}

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetVariableSystem.Clear('pp_cplan_open')]"
					on_action = "[GetVariableSystem.Clear('pp_lprof_pick')]"
				}
			}
		}
	}
