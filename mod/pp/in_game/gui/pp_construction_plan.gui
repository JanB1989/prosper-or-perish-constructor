# Prosper or Perish - Construction Plan window (branch player-construction-manager, 2026-11-06, Jan; two tabs since
# 2026-11-09, three since 2026-11-10). A scripted widget (gui/scripted_widgets/pp_construction_plan.txt), so no vanilla
# window is overridden.
# Size (2026-11-20, Jan: "I hate having to scroll"): 1360 x 820, the tab body about 1316 x 700 px, the Global Settings
# tab in two columns (left 650 px: switch, reserve, monthly budget, summary, rule groups; right ~630 px, full height:
# the "Last month" list or a rule group's pane, whose list of what was built is the only part that scrolls).
# Tabs (vanilla main tabs): Global Settings (the plan on or off, the gold reserve, the monthly budget, the six rule
# groups with their weight bars and lines, what the last pass built) and Towns and Buildings (the settings of that rule group, type
# pp_cplan_country_tab, construction_plan_country.py; Location Profiles, the second tab until 2026-11-19, are gone)
# and Plans (since 2026-11-20: the settings every town-right plan shares and each plan's card, type pp_tplan_set_tab,
# town_plan_settings_gui.py).
# Each rule group row ends in a cog (pp_cplan_detail_button_<group>, since 2026-11-09,
# Jan: "what's happening under the hood"); it shows that group's detail pane (pp_cplan_detail_<group>: gold had,
# wanted, spent and waiting, its situation, the last 12 months, what it built and why) in place of the "Last month"
# list (pp_cplan_last_list). All three are generated into pp_construction_plan_detail.gui
# (construction_plan_detail.py).
# GUI variables: pp_cplan_open (window open), pp_cplan_tab ('country' = the second tab, 'plans' the third,
# anything else the first), pp_cplan_detail (the group whose pane is open; unset = the "Last month" list).
# Every button runs a scripted GUI in common/scripted_guis/pp_construction_plan.txt; every number is a script value
# (common/script_values/pp_construction_plan*.txt).
# Shown only to a player who plays a country (not to observers: their scripted GUIs do nothing).

types PPConstructionPlan
{
	type pp_cplan_step_button = button_regular {
		size = { 26 24 }
	}

	type pp_cplan_switch_button = button_regular {
		size = { 70 26 }
		tooltip = "PP_CPLAN_SWITCH_TT"
	}

	type pp_cplan_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_cplan_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}

	# In a list of the last pass's constructions (an item = a location): a town or city upgrade of the Towns and
	# Buildings group. An upgrade is no building, so the group's list of building types here does not hold it and
	# this names it (the location's pp_cplan_log_rank, set by that group; nothing shows blank).
	type pp_cplan_rank_upgrade = text_single {
		visible = "[Scope.Var('pp_cplan_log_rank').IsSet]"
		autoresize = yes
		align = left|nobaseline
		text = "PP_CPLAN_RANK_UPGRADE"
	}
}

# ---- Opener ----
# The window opens from its own tab at the end of the top-left panel's tab row (Jan 2026-11-20: the tab docked under
# the row stuck out): the mod's copy of vanilla panels/left_panel/left_panel.gui, written by tools/port_vanilla_gui.py
# (port_left_panel). The location window's header has a second way in (location_plan.add_location_button).

# ---- Window ----
	window = {
		name = "pp_construction_plan_window"
		visible = "[And4(GetVariableSystem.Exists('pp_cplan_open'), GetPlayer.Exists, Not(IsObserving), Not(IsPauseMenuShown))]"
		position = { 90 110 }
		size = { 1360 820 }
		movable = yes
		using = bg_window_default_alt
		filter_mouse = all

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" {
					text = "PP_CPLAN_TITLE"
				}
			}

			header_main_tabs = {
				layoutpolicy_horizontal = expanding
				blockoverride "content" {
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PLAN"
						}
						tooltip = "PP_CPLAN_TAB_PLAN_TT"
						down = "[Not(Or(GetVariableSystem.HasValue('pp_cplan_tab', 'country'), GetVariableSystem.HasValue('pp_cplan_tab', 'plans')))]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'plan')]"
					}
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_COUNTRY"
						}
						tooltip = "PP_CPLAN_TAB_COUNTRY_TT"
						down = "[GetVariableSystem.HasValue('pp_cplan_tab', 'country')]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'country')]"
						onclick = "[GetScriptedGui('pp_cplan_country_layout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
					button_main_tab_alt = {
						layoutpolicy_horizontal = expanding
						blockoverride "tab_text" {
							text = "PP_CPLAN_TAB_PLANS"
						}
						tooltip = "PP_CPLAN_TAB_PLANS_TT"
						down = "[GetVariableSystem.HasValue('pp_cplan_tab', 'plans')]"
						onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'plans')]"
					}
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_main_inner_alt
				using = window_main_tabs_margin_alt

				# ======================== Global settings ========================
				# Two columns (2026-11-20, Jan: no scrolling): left the switch, the gold reserve, the monthly budget, the
				# summary line and the six rule groups with their status lines (LEFT_WIDTH px); right, over the whole
				# height, the "Last month" list or the open rule group's pane, whose list of what was built is the only
				# part that scrolls.
				hbox = {
					visible = "[Not(Or(GetVariableSystem.HasValue('pp_cplan_tab', 'country'), GetVariableSystem.HasValue('pp_cplan_tab', 'plans')))]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 8 }
					spacing = 16

					# ---- left column ----
					vbox = {
						minimumsize = { 650 -1 }
						maximumsize = { 650 -1 }
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes
						spacing = 8

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							pp_cplan_label = { text = "PP_CPLAN_MASTER" tooltip = "PP_CPLAN_MASTER_TT" fontsize = 18 }
							expand = {}
							pp_cplan_switch_button = {
								visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5')]"
								text = "PP_CPLAN_ON"
								onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							pp_cplan_switch_button = {
								visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5'))]"
								text = "PP_CPLAN_OFF"
								onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							pp_cplan_label = { text = "PP_CPLAN_RESERVE" tooltip = "PP_CPLAN_RESERVE_TT" }
							expand = {}
							pp_cplan_label = { text = "PP_CPLAN_RESERVE_VALUE" tooltip = "PP_CPLAN_RESERVE_TT" }
							pp_cplan_step_button = {
								text = "PP_CPLAN_MINUS"
								tooltip = "PP_CPLAN_RESERVE_STEP_TT"
								onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
								onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
							}
							pp_cplan_step_button = {
								text = "PP_CPLAN_PLUS"
								tooltip = "PP_CPLAN_RESERVE_STEP_TT"
								onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
								onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('reserve_big')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
							}
						}

						# the monthly budget (2026-11-20, Jan: "below that: spend this much"): the most new gold a pass
						# shares out (pp_cplan_budget_gold, 0 = no limit; pp_cplan_purse_share); steps of
						# [construction_plan] budget_step / budget_step_big
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							pp_cplan_label = { text = "PP_CPLAN_BUDGET" tooltip = "PP_CPLAN_BUDGET_TT" }
							expand = {}
							pp_cplan_label = { text = "PP_CPLAN_BUDGET_VALUE" tooltip = "PP_CPLAN_BUDGET_TT" }
							pp_cplan_step_button = {
								text = "PP_CPLAN_MINUS"
								tooltip = "PP_CPLAN_BUDGET_STEP_TT"
								onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('budget')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
								onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('budget_big')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
							}
							pp_cplan_step_button = {
								text = "PP_CPLAN_PLUS"
								tooltip = "PP_CPLAN_BUDGET_STEP_TT"
								onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('budget')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
								onrightclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('budget_big')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
							}
						}

						# is gold the limit at all (2026-11-20): the gold that came into the plan a month lately, what all
						# rule groups together lack and how long that takes (pp_cplan_flow_n, pp_cplan_f_all_*;
						# construction_plan_status.py); before the first month's measure it says it needs a month
						pp_cplan_d_line = {
							visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_flow_known'), '(CFixedPoint)0.5'))]"
							text = "PP_CPLAN_FLOW_UNKNOWN"
							tooltip = "PP_CPLAN_FLOW_TT"
						}
						pp_cplan_d_line = {
							visible = "[And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_flow_known'), '(CFixedPoint)0.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_all_missing'), '(CFixedPoint)0.5')))]"
							text = "PP_CPLAN_FLOW_ENOUGH"
							tooltip = "PP_CPLAN_FLOW_TT"
						}
						pp_cplan_d_line = {
							visible = "[And3(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_flow_known'), '(CFixedPoint)0.5'), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_all_missing'), '(CFixedPoint)0.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_all_years'), '(CFixedPoint)98.5')))]"
							text = "PP_CPLAN_FLOW_SHORT"
							tooltip = "PP_CPLAN_FLOW_TT"
						}
						pp_cplan_d_line = {
							visible = "[And3(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_flow_known'), '(CFixedPoint)0.5'), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_all_missing'), '(CFixedPoint)0.5'), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_all_years'), '(CFixedPoint)98.5'))]"
							text = "PP_CPLAN_FLOW_NEVER"
							tooltip = "PP_CPLAN_FLOW_TT"
						}
						# the monthly budget, not the treasury, held the plan back at the last pass (gold above the
						# reserve stayed in no purse; pp_cplan_f_budget_binds, kept by pp_cplan_forecast_store)
						pp_cplan_d_line = {
							visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_budget_binds'), '(CFixedPoint)0.5')]"
							text = "PP_CPLAN_BUDGET_BINDS"
							tooltip = "PP_CPLAN_BUDGET_BINDS_TT"
						}

						# the rule groups: name, line, weight bar (generated, pp_construction_plan_weights.gui) with the
						# part in % and the gold the group has saved (its purse), and the detail cog (generated,
						# pp_construction_plan_detail.gui): label 120 + line 190 + bar 294 + cog 26 + 3 x 4 spacing = 642
						# of the column's 650 px. Under each row its status line (the status types, generated beside
						# the bars by construction_plan_status.py): how the group stands for gold and its situation
						hbox = {
							layoutpolicy_horizontal = expanding
							pp_cplan_title = { text = "PP_CPLAN_RULES" }
							expand = {}
							pp_cplan_label = { text = "PP_CPLAN_SHARE_HEAD" tooltip = "PP_CPLAN_SHARE_TT" default_format = "#weak" }
						}

						# profiles
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_PROFILES_RULE" tooltip = "PP_CPLAN_PROFILES_RULE_TT" minimumsize = { 120 -1 } maximumsize = { 120 -1 } }
								widget = { size = { 190 1 } }
								expand = {}
								pp_cplan_weight_bar_profiles = {}
								pp_cplan_detail_button_profiles = {}
							}
							pp_cplan_status_profiles = {}
						}

						# food
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_FOOD_RULE" tooltip = "PP_CPLAN_FOOD_RULE_TT" minimumsize = { 120 -1 } maximumsize = { 120 -1 } }
								widget = { size = { 190 1 } }
								expand = {}
								pp_cplan_weight_bar_food = {}
								pp_cplan_detail_button_food = {}
							}
							pp_cplan_status_food = {}
						}

						# logistics
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_LOGISTICS_RULE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" minimumsize = { 120 -1 } maximumsize = { 120 -1 } }
								hbox = {
									minimumsize = { 190 -1 }
									spacing = 4
									pp_cplan_label = { text = "PP_CPLAN_ACCESS_VALUE" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" }
									expand = {}
									pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
									pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_LOGISTICS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('access_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
								}
								expand = {}
								pp_cplan_weight_bar_logistics = {}
								pp_cplan_detail_button_logistics = {}
							}
							pp_cplan_status_logistics = {}
						}

						# improve
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_IMPROVE_RULE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" minimumsize = { 120 -1 } maximumsize = { 120 -1 } }
								hbox = {
									minimumsize = { 190 -1 }
									spacing = 4
									pp_cplan_label = { text = "PP_CPLAN_IMPROVE_LINE_VALUE" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" }
									expand = {}
									pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
									pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_IMPROVE_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('improve_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
								}
								expand = {}
								pp_cplan_weight_bar_improve = {}
								pp_cplan_detail_button_improve = {}
							}
							pp_cplan_status_improve = {}
						}

						# business
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_BUSINESS_RULE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" minimumsize = { 120 -1 } maximumsize = { 120 -1 } }
								hbox = {
									minimumsize = { 190 -1 }
									spacing = 4
									pp_cplan_label = { text = "PP_CPLAN_BUSINESS_LINE_VALUE" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" }
									expand = {}
									pp_cplan_step_button = { text = "PP_CPLAN_MINUS" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('down')).End)]" }
									pp_cplan_step_button = { text = "PP_CPLAN_PLUS" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" onclick = "[GetScriptedGui('pp_cplan_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('business_line')).AddScope('pp_dir', MakeScopeFlag('up')).End)]" }
								}
								expand = {}
								pp_cplan_weight_bar_business = {}
								pp_cplan_detail_button_business = {}
							}
							pp_cplan_status_business = {}
						}

						# country (Towns and Buildings: its settings are on its own tab, so no line here; the longer
						# name takes the line's room: label 200 + 110 instead of 120 + 190)
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 1
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								pp_cplan_label = { text = "PP_CPLAN_COUNTRY_RULE" tooltip = "PP_CPLAN_COUNTRY_RULE_TT" minimumsize = { 200 -1 } maximumsize = { 200 -1 } }
								widget = { size = { 110 1 } }
								expand = {}
								pp_cplan_weight_bar_country = {}
								pp_cplan_detail_button_country = {}
							}
							pp_cplan_status_country = {}
						}

						expand = {}
					}

					# ---- right column: the whole height ----
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes # the closed detail panes take no room

						# last month, everything the plan built; a rule group's cog shows its own pane here instead
						vbox = {
							visible = "[Not(GetVariableSystem.Exists('pp_cplan_detail'))]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 8

							pp_cplan_title = { text = "PP_CPLAN_LAST" }
							pp_cplan_label = { text = "PP_CPLAN_LAST_SUMMARY" }

							# a line per rule group and location (generated, pp_construction_plan_detail.gui): it
							# scrolls, as only a pane's list of what was built does besides
							pp_cplan_last_list = {}
						}

						# the rule groups' detail panes (generated, pp_construction_plan_detail.gui)
						pp_cplan_detail_profiles = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'profiles')]" }
						pp_cplan_detail_food = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'food')]" }
						pp_cplan_detail_logistics = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'logistics')]" }
						pp_cplan_detail_improve = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'improve')]" }
						pp_cplan_detail_business = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'business')]" }
						pp_cplan_detail_country = { visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'country')]" }
					}
				}

				# ======================== Towns and Buildings ========================
				# (the settings of the rule group of that name; the type is construction_plan_country.py's)
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'country')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					pp_cplan_country_tab = {}
				}

				# ======================== Plans ========================
				# (the settings every town-right plan shares and each plan's card; the type is
				# town_plan_settings_gui.py's, gui/pp_town_plan_settings_generated.gui)
				vbox = {
					visible = "[GetVariableSystem.HasValue('pp_cplan_tab', 'plans')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					pp_tplan_set_tab = {}
				}
			}
		}

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetVariableSystem.Clear('pp_cplan_open')]"
					on_action = "[GetVariableSystem.Clear('pp_cplan_detail')]"
				}
			}
		}
	}
