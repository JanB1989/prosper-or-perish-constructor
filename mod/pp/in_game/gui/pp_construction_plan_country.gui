# Generated by ppc finalize (construction_plan_country.py) from [construction_plan_country]; do not edit by hand.

# Prosper or Perish - Construction Plan, the Towns and Buildings tab (Jan 2026-11-10: "keep the UI tight"). The
# type pp_cplan_country_tab is the tab's body: pp_construction_plan.gui places it in the window's tab area (about
# 650 x 700 px). Three sections, each one header row with its line and switches, then its tiles: pressed with a gold
# glow = ticked. A tile shows only while the country could use it (script values pp_cplan_pub_show_<building>,
# pp_cplan_right_show_<right>, read only while the tab is open) or while it is ticked. Every button runs a scripted
# GUI of common/scripted_guis/pp_construction_plan_country.txt.

types PPConstructionPlanCountry
{
	type pp_cplan_country_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_cplan_country_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}

	type pp_cplan_country_step_button = button_regular {
		size = { 26 24 }
	}

	type pp_cplan_country_tab = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes
		margin = { 8 6 }
		spacing = 4

