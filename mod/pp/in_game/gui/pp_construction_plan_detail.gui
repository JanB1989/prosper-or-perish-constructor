	# the business group's cog: opens its pane, or closes it while open
	type pp_cplan_detail_button_business = widget {
		size = { 26 26 }
		button_automation_shortcut = {
			visible = "[Not(GetVariableSystem.HasValue('pp_cplan_detail', 'business'))]"
			parentanchor = center
			size = { 24 24 }
			action_tooltip = {
				title = "PP_CPLAN_D_SHOW"
				on_action = "[GetVariableSystem.Set('pp_cplan_detail', 'business')]"
			}
		}
		button_automation_shortcut = {
			visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'business')]"
			parentanchor = center
			size = { 24 24 }
			# open: vanilla's selected colour (its sort buttons)
			blockoverride "bg_button_color" {
				using = color_sortby_on
			}
			action_tooltip = {
				title = "PP_CPLAN_D_HIDE"
				on_action = "[GetVariableSystem.Clear('pp_cplan_detail')]"
			}
		}
	}

	# the business group's pane (its construction code 103)
	type pp_cplan_detail_business = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes
		spacing = 6
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_cplan_title = { text = "PP_CPLAN_D_TITLE_BUSINESS" tooltip = "PP_CPLAN_BUSINESS_RULE_TT" }
			expand = {}
			button_close_alt = {
				size = { 22 22 }
				blockoverride "close_properties" {}
				blockoverride "close_inputaction" {}
