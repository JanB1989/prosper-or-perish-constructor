# Generated by ppc finalize (construction_plan.py) from [construction_plan]; do not edit by hand.
# The Construction Plan window's detail panes (construction_plan_detail.py; Jan 2026-11-09: what each
# rule group did under the hood). Per rule group a cog for its row (pp_cplan_detail_button_<group>) and a
# pane (pp_cplan_detail_<group>) that the window shows instead of its "Last month" list while the GUI
# variable pp_cplan_detail = <group>: the gold it had, wanted and spent, what waited for gold, the situation
# its rule read, the last 12 months (grey wanted, gold spent) and what it built and why.
# Every number is a script value the monthly pass leaves (pp_cplan_d_*, pp_cplan_h_*, the list items'
# pp_cplan_log_*_n).

types PPConstructionPlanDetail
{
	# a line of the pane (wraps at the pane's width)
	type pp_cplan_d_line = text_multi {
		layoutpolicy_horizontal = expanding
		autoresize = yes
	}

	# one rule state in the profiles' grid
	type pp_cplan_d_cell = text_single {
		autoresize = yes
		align = left|nobaseline
		minimumsize = { 196 -1 }
		maximumsize = { 196 -1 }
	}

	# one month of the chart: grey what the group wanted, gold on top what it spent (0..100 of its largest
	# month)
	type pp_cplan_d_column = widget {
		size = { 16 60 }
		background = {
			using = color_super_dark_brown_texture
			alpha = 0.6
		}
		progressbar = {
			size = { 100% 100% }
			direction = vertical
			texture_density = 2
			spriteType = corneredstretched
			spriteborder = { 0 12 }
			min = 0
			max = 100
			block "pp_cplan_d_need" {
				value = 0
			}
			progresstexture = "gfx/interface/progressbars/progress_bar_silver_rotated.dds"
			noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
		}
		progressbar = {
			size = { 100% 100% }
			direction = vertical
			texture_density = 2
			spriteType = corneredstretched
			spriteborder = { 0 12 }
			min = 0
			max = 100
			block "pp_cplan_d_spent" {
				value = 0
			}
			progresstexture = "gfx/interface/progressbars/progress_bar_goldish_rotated.dds"
			noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
		}
	}

	type pp_cplan_d_swatch_need = icon {
		size = { 10 14 }
		texture = "gfx/interface/progressbars/progress_bar_silver_rotated.dds"
	}
	type pp_cplan_d_swatch_spent = icon {
		size = { 10 14 }
		texture = "gfx/interface/progressbars/progress_bar_goldish_rotated.dds"
	}

	# the profiles group's cog: opens its pane, or closes it while open
	type pp_cplan_detail_button_profiles = widget {
		size = { 26 26 }
		button_automation_shortcut = {
			visible = "[Not(GetVariableSystem.HasValue('pp_cplan_detail', 'profiles'))]"
			parentanchor = center
			size = { 24 24 }
			action_tooltip = {
				title = "PP_CPLAN_D_SHOW"
				on_action = "[GetVariableSystem.Set('pp_cplan_detail', 'profiles')]"
			}
		}
		button_automation_shortcut = {
			visible = "[GetVariableSystem.HasValue('pp_cplan_detail', 'profiles')]"
			parentanchor = center
			size = { 24 24 }
			# open: vanilla's selected colour (its sort buttons)
			blockoverride "bg_button_color" {
				using = color_sortby_on
			}
			action_tooltip = {
				title = "PP_CPLAN_D_HIDE"
				on_action = "[GetVariableSystem.Clear('pp_cplan_detail')]"
			}
		}
	}

	# the profiles group's pane (its construction code 105)
	type pp_cplan_detail_profiles = vbox {
		layoutpolicy_horizontal = expanding
