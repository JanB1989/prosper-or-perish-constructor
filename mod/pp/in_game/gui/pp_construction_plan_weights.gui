	type pp_cplan_weight_bar_country = hbox {
		spacing = 4
		button_square_minus = {
			size = { 15 15 }
			tooltip = "PP_CPLAN_D_DOWN_TT_COUNTRY"
			onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
		}
		widget = {
			size = { 140 20 }
			progressbar_framed = {
				position = { 0 0 }
				size = { 140 14 }
				using = progress_bar_goldish
				min = 0
				max = 10
				value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('pp_cplan_country_w'))]"
			}
			# white: the weight at which it would pay for all it wants within a year (pp_cplan_f_<group>_need_w)
			progressbar = {
				position = { 0 14 }
				size = { 140 6 }
				min = 0
				max = 10
				value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_need_w'))]"
				progresstexture = "gfx/interface/progressbars/progress_bar_whiteish.dds"
				noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
			}
			button = {
				position = { 0 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w1')).End)]"
			}
			button = {
				position = { 14 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w2')).End)]"
			}
			button = {
				position = { 28 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w3')).End)]"
			}
			button = {
				position = { 42 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w4')).End)]"
			}
			button = {
				position = { 56 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w5')).End)]"
			}
			button = {
				position = { 70 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w6')).End)]"
			}
			button = {
				position = { 84 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w7')).End)]"
			}
			button = {
				position = { 98 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w8')).End)]"
			}
			button = {
				position = { 112 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w9')).End)]"
			}
			button = {
				position = { 126 0 }
				size = { 14 20 }
				tooltip = "PP_CPLAN_D_NEED_TT_COUNTRY"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w10')).End)]"
			}
		}
		button_square_plus = {
			size = { 15 15 }
			tooltip = "PP_CPLAN_D_UP_TT_COUNTRY"
			onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
		}
		text_single = {
			raw_text = "[GetPlayer.MakeScope.ScriptValue('pp_cplan_part_country')|0]%"
			tooltip = "PP_CPLAN_SHARE_TT"
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
		}
		# what the group has saved (its purse)
		text_single = {
			text = "PP_CPLAN_D_PURSE_COUNTRY"
			tooltip = "PP_CPLAN_PURSE_TT"
			minimumsize = { 64 -1 }
			maximumsize = { 64 -1 }
			align = right|nobaseline
		}
	}

	# the country group's status: how it stands for gold, and its situation at its last look
	type pp_cplan_status_country = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		margin = { 6 0 }
		spacing = 10
		pp_cplan_status_text = {
			visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)0.5'))]"
			text = "PP_CPLAN_D_ST_0"
			tooltip = "PP_CPLAN_D_OUTLOOK_0_COUNTRY"
		}
		pp_cplan_status_text = {
			visible = "[And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)0.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)1.5')))]"
			text = "PP_CPLAN_D_ST_1"
			tooltip = "PP_CPLAN_D_OUTLOOK_1"
		}
		pp_cplan_status_text = {
			visible = "[And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)1.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)2.5')))]"
			text = "PP_CPLAN_D_ST_2"
			tooltip = "PP_CPLAN_D_OUTLOOK_2_COUNTRY"
		}
		pp_cplan_status_text = {
			visible = "[And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)2.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)3.5')))]"
			text = "PP_CPLAN_D_ST_3"
			tooltip = "PP_CPLAN_D_OUTLOOK_3_COUNTRY"
		}
		pp_cplan_status_text = {
			visible = "[And(And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)3.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)4.5'))), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_years'), '(CFixedPoint)98.5')))]"
			text = "PP_CPLAN_D_ST_4_COUNTRY"
			tooltip = "PP_CPLAN_D_OUTLOOK_4_COUNTRY"
		}
		pp_cplan_status_text = {
			visible = "[And(And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)3.5'), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)4.5'))), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_years'), '(CFixedPoint)98.5'))]"
			text = "PP_CPLAN_D_ST_4N"
			tooltip = "PP_CPLAN_D_OUTLOOK_4N_COUNTRY"
		}
		pp_cplan_status_text = {
			visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_f_country_status'), '(CFixedPoint)4.5')]"
			text = "PP_CPLAN_D_ST_5"
			tooltip = "PP_CPLAN_D_OUTLOOK_5_COUNTRY"
		}
		expand = {}
	}
}
