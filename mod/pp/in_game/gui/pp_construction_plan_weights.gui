			}
		}
		button_square_plus = {
			size = { 15 15 }
			tooltip = "PP_CPLAN_WEIGHT_TT"
			onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_dir', MakeScopeFlag('up')).End)]"
		}
		text_single = {
			raw_text = "[GetPlayer.MakeScope.ScriptValue('pp_cplan_part_country')|0]%"
			tooltip = "PP_CPLAN_SHARE_TT"
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
