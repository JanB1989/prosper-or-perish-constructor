				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w5')).End)]"
			}
			button = {
				position = { 70 0 }
				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w6')).End)]"
			}
			button = {
				position = { 84 0 }
				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w7')).End)]"
			}
			button = {
				position = { 98 0 }
				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w8')).End)]"
			}
			button = {
