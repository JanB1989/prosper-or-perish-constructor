		spacing = 4
		button_square_minus = {
			size = { 15 15 }
			tooltip = "PP_CPLAN_WEIGHT_TT"
			onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_dir', MakeScopeFlag('down')).End)]"
		}
		widget = {
			size = { 140 14 }
			progressbar_framed = {
				size = { 100% 100% }
				using = progress_bar_goldish
				min = 0
				max = 10
				value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('pp_cplan_country_w'))]"
			}
			button = {
				position = { 0 0 }
				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w1')).End)]"
			}
			button = {
				position = { 14 0 }
				size = { 14 14 }
				tooltip = "PP_CPLAN_WEIGHT_TT"
				onclick = "[GetScriptedGui('pp_cplan_weight').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('country')).AddScope('pp_n', MakeScopeFlag('w2')).End)]"
			}
