# Prosper or Perish - Location Plan window (2026-11-07, Jan; a plan is a marker on the location). A scripted widget
# (gui/scripted_widgets/pp_location_plan.txt), so no vanilla window is overridden; opened by the plan button in the
# location window's header (location_plan.py patches it in) and by the round button of the location window's Plans row.
# The player sets what the location is for: one click per plan (the location variable pp_tplan_p_<plan>), several per
# location;
# the Construction Plan builds toward the held plans. The picker grid is generated (pp_location_plan_generated.gui; a
# plan's tooltip carries its state after the last look); the map mode pp_location_plan shows the location's plans
# and town rights as icons. Shown only to a player who plays a country.

types PPLocationPlan
{
	type pp_lplan_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_lplan_note = text_multi {
		autoresize = yes
		maximumsize = { 500 -1 }
		minimumsize = { 500 -1 }
		default_format = "#weak"
	}

	type pp_lplan_group_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}
}

window = {
	name = "pp_location_plan_window"
	visible = "[And3(GetVariableSystem.Exists('pp_lplan_open'), GetPlayer.Exists, Not(IsObserving))]"
	position = { 620 110 }
	size = { 540 800 }
	movable = yes
	using = bg_window_default_alt
	filter_mouse = all

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" {
				text = "PP_LPLAN_TITLE"
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt

			pp_lplan_note = {
				visible = "[Not(GetPlayer.MakeScope.Var('pp_lplan_sel').IsSet)]"
				text = "PP_LPLAN_NONE_PICKED"
			}

			vbox = {
				visible = "[GetPlayer.MakeScope.Var('pp_lplan_sel').IsSet]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vbox = {
					datacontext = "[GetPlayer.MakeScope.Var('pp_lplan_sel').GetLocation]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 8 6 }
					spacing = 5

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						pp_lplan_label = { raw_text = "[Location.GetName]" fontsize = 20 }
						pp_lplan_label = { raw_text = "[Location.GetProvince.GetName]" default_format = "#weak" }
						expand = {}
						button_regular = {
							size = { 110 26 }
							text = "PP_LPLAN_SHOW_MAP"
							tooltip = "PP_LPLAN_SHOW_MAP_TT"
							onclick = "[GetMapMode('pp_location_plan').SetMapMode]"
						}
						button_regular = {
							size = { 70 26 }
							visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('pp_tplan_n'), '(CFixedPoint)0')]"
							text = "PP_LPLAN_CLEAR"
							tooltip = "PP_LPLAN_CLEAR_TT"
							onclick = "[GetScriptedGui('pp_tplan_clear').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
					}

					pp_lplan_note = { text = "PP_LPLAN_NOTE" }

					# The Construction Plan is off: say so, with the switch right here (plans are kept either way).
					hbox = {
						visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_cplan_on_n'), '(CFixedPoint)0.5'))]"
						layoutpolicy_horizontal = expanding
						spacing = 6
						text_multi = {
							autoresize = yes
							maximumsize = { 380 -1 }
							minimumsize = { 380 -1 }
							text = "PP_LPLAN_OFF"
						}
						expand = {}
						button_regular = {
							size = { 100 26 }
							text = "PP_LPLAN_SWITCH_ON"
							tooltip = "PP_LPLAN_SWITCH_ON_TT"
							onclick = "[GetScriptedGui('pp_cplan_toggle_on').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					pp_lplan_label = {
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_tplan_n'), '(CFixedPoint)0')]"
						text = "PP_LPLAN_NOTHING_YET"
					}

					scrollarea = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = { using = Scrollbar_Vertical }
						scrollwidget = {
							vbox = {
								minimumsize = { 490 -1 }
								maximumsize = { 490 -1 }
								pp_lplan_picker = {}
							}
						}
					}
				}
			}
		}
	}

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }
		button_close_alt = {
			blockoverride "close_on_action" { on_action = "[GetVariableSystem.Clear('pp_lplan_open')]" }
		}
	}
}
