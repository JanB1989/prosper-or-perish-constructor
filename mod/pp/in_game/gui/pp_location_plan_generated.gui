	# The marked buildings of the location (the list pp_lplan_b): click one to take its mark off.
	type pp_lplan_bstrip = flowcontainer {
		direction = horizontal
		spacing = 3
		datamodel = "[Location.MakeScope.GetList('pp_lplan_b')]"
		item = {
			widget = {
				size = { 36 36 }
				icon = { size = { 36 36 } texture = "gfx/interface/component_tiles/square_tile.dds" color = { 0.9 0.7 0.25 0.95 } }
				button = {
					size = { 30 30 }
					parentanchor = center
					texture = "[GetBuildingIcon(Scope.GetBuildingType.Self)]"
					tooltip = "PP_LPLAN_BMARK_TILE"
					onclick = "[GetScriptedGui('pp_lplan_bmark').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_bt', Scope.GetBuildingType.MakeScope).End)]"
				}
			}
		}
	}

	# Every item to plan, by group: click to plan or unplan; planned ones carry a gold frame.
	type pp_lplan_picker = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 2
		pp_lplan_group_title = { text = "PP_LPLAN_GROUP_FARMING" }
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			widget = {
				size = { 40 40 }
				icon = { visible = "[Location.MakeScope.Var('pp_lplan_g_camels').IsSet]" size = { 40 40 } texture = "gfx/interface/component_tiles/square_tile.dds" color = { 0.9 0.7 0.25 0.95 } }
				button = {
					size = { 34 34 }
					parentanchor = center
					texture = "gfx/interface/icons/trade_goods/icon_goods_camels.dds"
					alpha = "[Select_float(Location.MakeScope.Var('pp_lplan_g_camels').IsSet, '(float)1.0', '(float)0.45')]"
					tooltip = "PP_LPLAN_PICK_CAMELS"
					onclick = "[GetScriptedGui('pp_lplan_toggle').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_key', MakeScopeFlag('camels')).End)]"
				}
			}
			widget = {
				size = { 40 40 }
