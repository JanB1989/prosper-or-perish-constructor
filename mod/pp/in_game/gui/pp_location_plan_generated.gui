	# The Plans row of the location window's Infrastructure tab (datacontext Location): the location's plans
	# (town rights) as pressed tiles, a click takes one off; the round button opens the Location Plan window.
	type pp_tplan_location_row = hbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { -1 45 }
		margin = { 5 5 }
		using = bg_paper_card
		using = bg_cabinet_card_frame
		widget = {
			size = { 40 -1 }
			layoutpolicy_vertical = expanding
			using = bg_card_header_01
			icon = { size = { 28 28 } parentanchor = center texture = "gfx/interface/icons/map_modes/pp_location_plan.dds" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 5 0 }
			margin_right = 2
			spacing = 4
			using = bg_corner_flavor
			blockoverride "corner_flavor_texture" {
