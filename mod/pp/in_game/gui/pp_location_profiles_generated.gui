	# The Location Plan window's Profile row (datacontext Location).
	type pp_lprof_plan_row = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 3
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_lprof_title = { text = "PP_LPROF_UI_ROW_TITLE" }
			widget = {
				visible = "[Location.MakeScope.Var('pp_lprof').IsSet]"
				size = { 30 30 }
				pp_lprof_face_1 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)101')]" tooltip = "PP_LPROF_UI_BADGE_1" }
				pp_lprof_face_2 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)102')]" tooltip = "PP_LPROF_UI_BADGE_2" }
				pp_lprof_face_3 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)103')]" tooltip = "PP_LPROF_UI_BADGE_3" }
				pp_lprof_face_4 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)104')]" tooltip = "PP_LPROF_UI_BADGE_4" }
				pp_lprof_face_5 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)105')]" tooltip = "PP_LPROF_UI_BADGE_5" }
				pp_lprof_face_6 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)106')]" tooltip = "PP_LPROF_UI_BADGE_6" }
				pp_lprof_face_7 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)107')]" tooltip = "PP_LPROF_UI_BADGE_7" }
