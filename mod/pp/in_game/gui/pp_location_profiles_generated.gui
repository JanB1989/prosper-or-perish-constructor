					icon = { visible = "[Not(Or(GetPlayer.MakeScope.Var('pp_lprof_e_r1_g').IsSet, GetPlayer.MakeScope.Var('pp_lprof_e_r1_c').IsSet))]" parentanchor = center size = { 18 18 } texture = "gfx/interface/buttons/flats/plus.dds" using = button_regular_icon_color }
