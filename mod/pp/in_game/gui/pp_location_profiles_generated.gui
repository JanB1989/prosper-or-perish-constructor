	# The items: click one to make it the edited profile's icon or rule target (pp_lprof_pick).
	type pp_lprof_picker = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 2
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'icon')]" text = "PP_LPROF_UI_PICK_ICON" }
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'r1')]" text = "PP_LPROF_UI_PICK_R1" }
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'r2')]" text = "PP_LPROF_UI_PICK_R2" }
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'r3')]" text = "PP_LPROF_UI_PICK_R3" }
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'r4')]" text = "PP_LPROF_UI_PICK_R4" }
			pp_lprof_title = { visible = "[GetVariableSystem.HasValue('pp_lprof_pick', 'r5')]" text = "PP_LPROF_UI_PICK_R5" }
			expand = {}
			button_regular = {
				size = { 80 26 }
				text = "PP_LPROF_UI_CANCEL"
				tooltip = "PP_LPROF_UI_CANCEL_TT"
				onclick = "[GetVariableSystem.Clear('pp_lprof_pick')]"
