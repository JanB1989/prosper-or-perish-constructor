	# The Profile row of the Location Plan window and of the location window's Infrastructure tab (datacontext
	# Location).
	type pp_lprof_plan_row = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 3
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_lprof_title = { text = "PP_LPROF_UI_ROW_TITLE" }
			pp_lprof_badge = { size = { 30 30 } }
			pp_lprof_label = { visible = "[Not(Location.MakeScope.Var('pp_lprof').IsSet)]" text = "PP_LPROF_UI_ROW_NONE" default_format = "#weak" }
			expand = {}
			button_regular = {
				visible = "[Location.MakeScope.Var('pp_lprof').IsSet]"
				size = { 70 26 }
				text = "PP_LPROF_UI_NONE"
				tooltip = "PP_LPROF_UI_NONE_TT"
				onclick = "[GetScriptedGui('pp_lprof_assign').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_slot', MakeScopeFlag('none')).End)]"
			}
			button_regular = {
				size = { 110 26 }
				text = "PP_LPROF_UI_EDIT_PROFILES"
				tooltip = "PP_LPROF_UI_EDIT_PROFILES_TT"
				onclick = "[GetVariableSystem.Set('pp_cplan_open', 'yes')]"
				onclick = "[GetVariableSystem.Set('pp_cplan_tab', 'profiles')]"
			}
		}
