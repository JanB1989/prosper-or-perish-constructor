					pp_lprof_label = { parentanchor = left|vcenter visible = "[EqualTo_string(GetPlayer.MakeScope.Var('pp_lprof_e_r1_g').GetGoods.GetKey, 'logistics')]" text = "PP_LPROF_UI_MARKET_ACCESS" }
