	# The editor's profiles: click one to edit it; + at the first free slot makes a new one.
	type pp_lprof_slot_strip = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 2
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			widget = {
				visible = "[GetPlayer.MakeScope.Var('pp_lprof_1_on').IsSet]"
				size = { 46 46 }
				icon = { visible = "[GetVariableSystem.HasValue('pp_lprof_edit', 's1')]" size = { 100% 100% } texture = "gfx/interface/component_tiles/square_tile.dds" color = { 0.9 0.7 0.25 0.95 } }
				button = {
					size = { 40 40 }
					parentanchor = center
					tooltip = "PP_LPROF_UI_EDIT_1"
					onclick = "[GetVariableSystem.Set('pp_lprof_edit', 's1')]"
					onclick = "[GetVariableSystem.Clear('pp_lprof_pick')]"
					pp_lprof_face_1 = {}
				}
			}
			widget = {
				visible = "[Not(GetPlayer.MakeScope.Var('pp_lprof_1_on').IsSet)]"
				size = { 46 46 }
				button_regular = {
					size = { 40 40 }
					parentanchor = center
					tooltip = "PP_LPROF_UI_NEW_TT"
					onclick = "[GetScriptedGui('pp_lprof_new').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_slot', MakeScopeFlag('s1')).End)]"
					onclick = "[GetVariableSystem.Set('pp_lprof_edit', 's1')]"
					onclick = "[GetVariableSystem.Clear('pp_lprof_pick')]"
					icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/buttons/flats/plus.dds" using = button_regular_icon_color }
				}
			}
			widget = {
				visible = "[GetPlayer.MakeScope.Var('pp_lprof_2_on').IsSet]"
