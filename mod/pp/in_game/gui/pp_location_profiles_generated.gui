	# The row "Also build here" of the location window's Infrastructure tab (datacontext Location), the Profile
	# row's card: the location's marks as toggle tiles (marked first, then the goods standing buildings make), and
	# the button that opens the Location Plan window.
	type pp_lplan_location_row = hbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { -1 45 }
		margin = { 5 5 }
		using = bg_paper_card
		using = bg_cabinet_card_frame
		widget = {
			size = { 40 -1 }
			layoutpolicy_vertical = expanding
			using = bg_card_header_01
			using = bg_card_header_01
			icon = { size = { 28 28 } parentanchor = center texture = "gfx/interface/icons/map_modes/pp_location_plan.dds" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 5 0 }
			margin_right = 2
			spacing = 4
			using = bg_corner_flavor
			blockoverride "corner_flavor_texture" {
				texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
				texture_density = 2
				spriteType = Corneredstretched
				spriteborder = { 35 35 }
				alpha = 0.4
			}
			blockoverride "corner_flavor_color" {
				modify_texture = { using = color_bg_blue_texture blend_mode = multiply }
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 3
				margin_bottom = 3
				spacing = 3
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5
					text_single = { text = "PP_LPLAN_ALSO_TITLE" align = left|nobaseline }
					text_single = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_lplan_planned_n'), '(CFixedPoint)0')]" text = "PP_LPLAN_ALSO_NONE" align = left|nobaseline default_format = "#medium" }
					text_single = { visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('pp_lplan_planned_n'), '(CFixedPoint)11')]" text = "PP_LPLAN_ALSO_COUNT" align = left|nobaseline default_format = "#medium" }
