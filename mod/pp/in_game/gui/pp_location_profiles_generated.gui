				pp_lprof_face_12 = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.Var('pp_lprof').GetValue, '(CFixedPoint)112')]" tooltip = "PP_LPROF_UI_BADGE_12" }
			}
			pp_lprof_label = { visible = "[Not(Location.MakeScope.Var('pp_lprof').IsSet)]" text = "PP_LPROF_UI_ROW_NONE" default_format = "#weak" }
			expand = {}
			button_regular = {
				visible = "[Location.MakeScope.Var('pp_lprof').IsSet]"
				size = { 70 26 }
				text = "PP_LPROF_UI_NONE"
				tooltip = "PP_LPROF_UI_NONE_TT"
				onclick = "[GetScriptedGui('pp_lprof_assign').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_slot', MakeScopeFlag('none')).End)]"
			}
			button_regular = {
				size = { 110 26 }
				text = "PP_LPROF_UI_EDIT_PROFILES"
				tooltip = "PP_LPROF_UI_EDIT_PROFILES_TT"
				onclick = "[GetVariableSystem.Set('pp_lprof_open', 'yes')]"
			}
		}
		flowcontainer = {
			visible = "[Or8(GetPlayer.MakeScope.Var('pp_lprof_1_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_2_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_3_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_4_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_5_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_6_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_7_on').IsSet, Or5(GetPlayer.MakeScope.Var('pp_lprof_8_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_9_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_10_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_11_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_12_on').IsSet))]"
