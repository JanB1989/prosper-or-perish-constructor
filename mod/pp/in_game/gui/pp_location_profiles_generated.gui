	# The Profile row of the location window's Infrastructure tab (datacontext Location), styled like the tab's
	# other rows: a paper card in a wooden frame, the badge in the header strip, the profiles as toggle tiles.
	type pp_lprof_location_row = hbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { -1 45 }
		margin = { 5 5 }
		using = bg_paper_card
		using = bg_cabinet_card_frame
		widget = {
			size = { 40 -1 }
			layoutpolicy_vertical = expanding
			using = bg_card_header_01
			using = bg_card_header_01
			pp_lprof_badge = { size = { 28 28 } parentanchor = center }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 5 0 }
			margin_right = 2
			spacing = 4
			using = bg_corner_flavor
			blockoverride "corner_flavor_texture" {
				texture = "gfx/interface/component_decoration/bg_corner_flavor_06.dds"
				texture_density = 2
				spriteType = Corneredstretched
				spriteborder = { 35 35 }
				alpha = 0.4
			}
			blockoverride "corner_flavor_color" {
				modify_texture = { using = color_bg_blue_texture blend_mode = multiply }
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 3
				margin_bottom = 3
				spacing = 3
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5
					text_single = { text = "PP_LPROF_UI_ROW_TITLE" align = left|nobaseline }
					text_single = { visible = "[Not(Location.MakeScope.Var('pp_lprof').IsSet)]" text = "PP_LPROF_UI_ROW_NONE" align = left|nobaseline default_format = "#medium" }
					expand = {}
				}
				hbox = {
					visible = "[Or8(GetPlayer.MakeScope.Var('pp_lprof_1_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_2_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_3_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_4_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_5_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_6_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_7_on').IsSet, Or4(GetPlayer.MakeScope.Var('pp_lprof_8_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_9_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_10_on').IsSet, GetPlayer.MakeScope.Var('pp_lprof_11_on').IsSet))]"
					layoutpolicy_horizontal = expanding
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 3
						button = {
							visible = "[GetPlayer.MakeScope.Var('pp_lprof_1_on').IsSet]"
							using = header_button_template
							blockoverride "header_button_template_push_properties" { using = button_tab_toggle_properties_template }
							blockoverride "header_button_template_texture" { using = pressed_button_texture }
							blockoverride "header_button_full_content" {}
							size = { 34 34 }
							down = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_lprof_n'), '(CFixedPoint)1')]"
							glow = { visible = "[EqualTo_CFixedPoint(Location.MakeScope.ScriptValue('pp_lprof_n'), '(CFixedPoint)1')]" glow_radius = 5 color = { 1.0 0.85 0.55 1.0 } alpha = 0.8 }
							tooltip = "PP_LPROF_UI_ASSIGN_1"
							onclick = "[GetScriptedGui('pp_lprof_assign').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('pp_slot', MakeScopeFlag('s1')).End)]"
