			pp_tplan_set_switch = { visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_close_n'), '(CFixedPoint)0.5'))]" text = "PP_TPLAN_SET_OFF" tooltip = "PP_TPLAN_SET_CLOSE_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}

