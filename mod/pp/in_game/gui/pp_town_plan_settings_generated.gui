			pp_tplan_set_switch = { visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_order_n'), '(CFixedPoint)0.5'))]" text = "PP_TPLAN_SET_BEST" tooltip = "PP_TPLAN_SET_ORDER_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_order').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
