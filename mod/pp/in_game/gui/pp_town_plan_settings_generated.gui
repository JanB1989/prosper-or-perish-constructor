			pp_tplan_set_switch = { visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_free_n'), '(CFixedPoint)0.5'))]" text = "PP_TPLAN_SET_OFF" tooltip = "PP_TPLAN_SET_FREE_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_free').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
