# Generated by ppc finalize (town_plan_settings_gui.py) from the plan list (town_plans.py); do not edit by hand.

# The Construction Plan window's Plans tab (pp_construction_plan.gui places the type as its third tab; the body
# shows only while pp_cplan_tab = plans, so it costs nothing while another tab is open). On top the settings
# every plan shares, below the plan icons (the Location Plan picker's groups) and the card of the selected plan
# (GUI variable pp_tplan_set_sel). Every button runs a scripted GUI of the country (town plan settings); every value
# is a country script value.

types PPTownPlanSettings
{
	type pp_tplan_set_label = text_single {
		autoresize = yes
		align = left|nobaseline
	}

	type pp_tplan_set_title = text_single {
		autoresize = yes
		align = left|nobaseline
		default_format = "#yellow_titles"
	}

	type pp_tplan_set_text = text_multi {
		layoutpolicy_horizontal = expanding
		autoresize = yes
		maximumsize = { 680 -1 }
	}

	type pp_tplan_set_step = button_regular {
		size = { 26 24 }
	}

	type pp_tplan_set_switch = button_regular {
		size = { 150 26 }
	}

	type pp_tplan_set_tab = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes
		margin = { 10 8 }
		spacing = 6

		# ---- All plans ----
		pp_tplan_set_title = { text = "PP_TPLAN_SET_ALL" tooltip = "PP_TPLAN_SET_ALL_TT" }
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_tplan_set_label = { text = "PP_TPLAN_SET_PB" tooltip = "PP_TPLAN_SET_PB_TT" }
			expand = {}
			pp_tplan_set_label = { text = "PP_TPLAN_SET_PB_ALL" tooltip = "PP_TPLAN_SET_PB_TT" }
			pp_tplan_set_step = { text = "PP_TPLAN_SET_MINUS" tooltip = "PP_TPLAN_SET_SHORTER_TT" onclick = "[GetScriptedGui('pp_tplan_pb_down').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('all')).End)]" }
			pp_tplan_set_step = { text = "PP_TPLAN_SET_PLUS" tooltip = "PP_TPLAN_SET_LONGER_TT" onclick = "[GetScriptedGui('pp_tplan_pb_up').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pp_key', MakeScopeFlag('all')).End)]" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_tplan_set_label = { text = "PP_TPLAN_SET_LOSS" tooltip = "PP_TPLAN_SET_LOSS_TT" }
			expand = {}
			pp_tplan_set_switch = { visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_loss_n'), '(CFixedPoint)0.5')]" text = "PP_TPLAN_SET_ON" tooltip = "PP_TPLAN_SET_LOSS_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_loss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			pp_tplan_set_switch = { visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_loss_n'), '(CFixedPoint)0.5'))]" text = "PP_TPLAN_SET_OFF" tooltip = "PP_TPLAN_SET_LOSS_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_loss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_tplan_set_label = { text = "PP_TPLAN_SET_STAFF" tooltip = "PP_TPLAN_SET_STAFF_TT" }
			expand = {}
			pp_tplan_set_switch = { visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_staff_n'), '(CFixedPoint)0.5')]" text = "PP_TPLAN_SET_ON" tooltip = "PP_TPLAN_SET_STAFF_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_staff').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			pp_tplan_set_switch = { visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pp_tplan_staff_n'), '(CFixedPoint)0.5'))]" text = "PP_TPLAN_SET_OFF" tooltip = "PP_TPLAN_SET_STAFF_TT" onclick = "[GetScriptedGui('pp_tplan_toggle_staff').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			pp_tplan_set_label = { text = "PP_TPLAN_SET_FREE" tooltip = "PP_TPLAN_SET_FREE_TT" }
