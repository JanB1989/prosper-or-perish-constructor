}

# the badge: number over the word, on a faint dark plate
template pp_advance_time_badge {
	background = {
		texture = "gfx/interface/component_tiles/square_tile.dds"
		texture_density = 2
		alpha = 0.55
		modify_texture = {
			using = color_black_texture
			blend_mode = multiply
		}
	}
	widget = {
		size = { 100% 26 }
		parentanchor = hcenter|top
		position = { 0 1 }
		alwaystransparent = yes
		using = pp_advance_time_number
	}
	text_single = {
		size = { 100% 18 }
		parentanchor = hcenter|bottom
		position = { 0 -2 }
		autoresize = no
		align = center|nobaseline
		raw_text = "[Localize('PP_ADVANCE_YEARS_UNIT')]"
		using = Font_Size_Small
		default_format = "#pp_advance_time_unit"
	}
}

# on the card (zoomed in): the upper right corner, beside the medallion. In the card's button (270 x 270) ...
template pp_advance_time_chip {
	widget = {
		name = "pp_advance_time"
		size = { 64 42 }
		parentanchor = right|top
		position = { -14 62 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		alwaystransparent = yes
		using = pp_advance_time_badge
	}
}

# ... and in every unlock artwork widget (305 x 102, 2 below the card's top), which is drawn over the button: the same spot
template pp_advance_time_chip_art {
	widget = {
		name = "pp_advance_time"
		size = { 64 42 }
		parentanchor = right|top
		position = { -31 60 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		alwaystransparent = yes
		using = pp_advance_time_badge
	}
}

