		size = { 100% 100% }
		autoresize = no
		align = center|nobaseline
		raw_text = "[Divide_float(Select_float(AdvanceNode.GetItem.GetAdvance.HasResearchCostDiscount, FixedPointToFloat(GetVariableFromGlobalVariableMap('pp_advance_cost_past', AdvanceNode.GetItem.GetDefinition.MakeScope).GetValue), FixedPointToFloat(GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).GetValue)), Max_float('(float)0.12', Multiply_float('(float)12', Multiply_float(FixedPointToFloat(GetPlayer.GetModifier('research_speed')), Add_float('(float)1', FixedPointToFloat(GetPlayer.GetModifier('research_speed_modifier')))))))|1][Localize('PP_ADVANCE_YEARS_UNIT')]"
		using = Font_Size_Small
		default_format = "#pp_advance_time_middling"
	}
	text_single = { # slow
