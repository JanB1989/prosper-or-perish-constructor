# on the card (zoomed in): the card's footer, between the corner ornaments
template pp_advance_time_chip {
	widget = {
		name = "pp_advance_time"
		size = { 170 24 }
		parentanchor = hcenter|bottom
		position = { 0 -2 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		alwaystransparent = yes
		using = pp_advance_time_body
	}
}

# on the round icon (zoomed out): directly under the icon
template pp_advance_time_chip_round {
	widget = {
		name = "pp_advance_time"
		size = { 200 34 }
		parentanchor = hcenter|bottom
		position = { 0 8 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		allow_outside = yes
		alwaystransparent = yes
		using = pp_advance_time_body
	}
}
