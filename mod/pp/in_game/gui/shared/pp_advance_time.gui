# on the card (zoomed in): below the card's right half, clear of the line to its children
template pp_advance_time_chip {
	widget = {
		name = "pp_advance_time"
		size = { 104 34 }
		parentanchor = right|bottom
		position = { -12 30 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		allow_outside = yes
		alwaystransparent = yes
		using = pp_advance_time_body
	}
}

# on the round icon (zoomed out): below the icon's right half
template pp_advance_time_chip_round {
	widget = {
		name = "pp_advance_time"
		size = { 120 40 }
		parentanchor = right|bottom
		position = { -20 10 }
		visible = "[GetVariableFromGlobalVariableMap('pp_advance_cost', AdvanceNode.GetItem.GetDefinition.MakeScope).IsSet]"
		allow_outside = yes
		alwaystransparent = yes
		using = pp_advance_time_body
	}
}
