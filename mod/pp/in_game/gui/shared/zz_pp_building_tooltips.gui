# Prosper or Perish: keep long building tooltips readable.
# Copied from vanilla and wraps the existing body content in a scroll area. BuildingType_tooltip is not
# re-declared any more: since EU5 1.4 vanilla scrolls its body itself.

template Building_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetBuildingIcon(Building.GetType)]"
				datacontext = "[Building.GetType]"
				tooltipwidget = {
					using = BuildingType_tooltip
				}
			}
		}

		blockoverride "title_text" {
			text = "[Building.GetFlavorName]"
		}

		blockoverride "concept_link" {
			text = "[building|e] | [Building.GetType.GetName]"
		}

		blockoverride "title_button" {
			datacontext = "[Building.GetType]"
			widget = { #estate building
				visible = "[BuildingType.OnlyEstatesCanBuild]"
				using = tooltip_title_icon_size
				icon =  {
					using = tooltip_title_icon_size
					texture = "[GetEstateIcon(BuildingType.GetEligibleEstate)]"
					datacontext = "[BuildingType.GetEligibleEstate]"
					tooltipwidget = {
						using = Estate_building_Tooltip
					}		
				}
			}

			widget = { #non estate building
				using = tooltip_title_icon_size
				visible = "[Not(BuildingType.OnlyEstatesCanBuild)]"
				icon =  {
					visible = "[Or(Not(BuildingType.IsSpecialBuilding), BuildingType.NeedsAdvance)]"
					using = tooltip_title_icon_size
					texture = "[GetAgeIcon(BuildingType.GetAge)]"
					datacontext = "[BuildingType.GetAge]"
					tooltipwidget = {
						using = Age_tooltip
					}
				}
			}
		}
		blockoverride "tooltip_content" {
            TooltipScrolledContentSection = {
                blockoverride "block_scrollarea" { maximumsize = { -1 700 } }
                blockoverride "section_content" {
                    vbox = {
                        set_parent_dimension_to_minimum = height
                        layoutpolicy_horizontal = expanding
                        spacing = 10
                        using = building_tooltip_detail

                    }
                }
            }
        }
	}
}
