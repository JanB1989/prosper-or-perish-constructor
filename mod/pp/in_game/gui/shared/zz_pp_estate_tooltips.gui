# Prosper or Perish: estate tooltips can include long modifier breakdowns,
# especially for peasants, so keep vanilla bodies inside bounded scroll areas.

template EstateType_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[EstateType.GetNameWithNoTooltip]"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetEstateIcon(EstateType.Self)]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "concept_link" {
			text = [estate|E]
		}

		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "block_scrollarea" { maximumsize = { -1 700 } }
				blockoverride "section_content" {
					vbox = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding
						spacing = 10
						ignoreinvisible = yes

						TooltipRowList = {
							textcontext = "[EstateType.GetTooltip]"
						}

						TooltipFlavorTextBlock = {
							blockoverride "text" {
								text = "[EstateType.GetFlavorText]"
							}
						}
					}
				}
			}
		}
	}
}

template Estate_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetEstateIcon(Estate.GetType)]"
		}

		blockoverride "title_text" {
			text = "[Estate.GetLongNameWithNoTooltip]"
		}
		blockoverride "title_button" {
			hbox = {
				visible = "[Estate.GetType.IsNobles]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('nobles')]" }
			}
			hbox = {
				visible = "[Estate.GetType.IsClergy]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('clergy')]" }
			}
			hbox = {
				visible = "[Estate.GetType.IsBurghers]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('burghers')]" }
			}
			hbox = {
				visible = "[Estate.GetType.IsPeasants]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('peasants')]" }
				mapmode_tooltip_button = { datacontext = "[GetMapMode('laborers')]" }
				mapmode_tooltip_button = { datacontext = "[GetMapMode('soldiers')]" }
			}
			hbox = {
				visible = "[Estate.GetType.IsTribes]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('tribesmen')]" }
			}
			hbox = {
				visible = "[Estate.GetType.IsCossacks]"
				mapmode_tooltip_button = { datacontext = "[GetMapMode('soldiers')]" }
			}
			hint_button = {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_estates')]"
				}
			}
		}

		blockoverride "concept_link" {
			text = [estate|E]
		}

		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "block_scrollarea" { maximumsize = { -1 700 } }
				blockoverride "section_content" {
					vbox = {
						set_parent_dimension_to_minimum = height
						layoutpolicy_horizontal = expanding
						spacing = 10
						ignoreinvisible = yes

						TooltipDebugTextBlock = {
							blockoverride "text" {
								debug_text = "[Estate.GetDebugText]"
							}
						}
						block "extra_estates_info" {}

						TooltipStringPairList = {
							textcontext = "ESTATE_BREAKDOWN"
						}

						TooltipListBase = {

							TooltipManualTableField = {
								visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "[gold|e]"
								}
								text_single = {
									autoresize = yes
									raw_text = "[Estate.GetGold|2]([Estate.GetBalance|+=2])@gold!"
								}
							}

							TooltipManualTableField = {
								visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "ESTATE_INCOME"
								}
								text_single = {
									autoresize = yes
									raw_text = "[Estate.GetLastMonthsIncomeAfterTaxWithTooltip]@gold!"
								}
							}

							TooltipStringPairList = {
								visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
								textcontext = "[Estate.GetEconomyInfo]"
							}



							TooltipManualTableField = {
								visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "ESTATE_EXPENSES"
								}
								text_single = {
									autoresize = yes
									raw_text = "#R -[Estate.GetLastMonthsExpense|2]@gold!#!"
								}

								tooltipwidget = {
									using = estate_expense_tooltip
								}

							}

							TooltipManualTableField = {
								visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "[wealth_impact|e]"
								}
								text_single = {
									autoresize = yes
									raw_text = "[Estate.GetWealthImpactString]"
								}
							}
						}


						TooltipListBase = {
							visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"

							TooltipManualTableField = {
								text_single = {
									text = "[estate_culture|e]"
								}
								expand = {}
								hbox = {
									spacing = 4
									icon = {
										size = { 18 18 }
										texture = "[Estate.GetCultureStatusIcon]"
									}
									text_single = {
										autoresize = yes
										text = "[Estate.GetCultureDisplayText]"
									}
								}
							}

							TooltipManualTableField = {
								text_single = {
									text = "[estate_religion|e]"
								}
								expand = {}
								hbox = {
									spacing = 4
									icon = {
										size = { 18 18 }
										texture = "[GetReligionIcon(Estate.GetReligion)]"
									}
									text_single = {
										autoresize = yes
										text = "[Estate.GetReligionDisplayText]"
									}
								}
							}
						}

						TooltipTextBlock = {
							visible = "[Estate.IsNextBuildSetUp]"
							blockoverride "text" {
								text = "[Estate.GetCurrentBuildInformation]"
							}
						}

						TooltipScrolledTextBlock = {
							blockoverride "block_scrollarea" { maximumsize = { -1 100 }}
							visible = "[Estate.HasPrivateArmy]"
							blockoverride "text" {
								raw_text = "[Estate.GetPrivateArmyInfo]"
							}
						}

						TooltipTextBlock = {
							visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
							blockoverride "text" {
								text = "[Estate.GetMostLikedCountries]"
							}

							tooltipwidget = {
								SimpleContextualStringPairTooltipType = {
									blockoverride "title_icon_texture" {
										texture = "[GetEstateIcon(Estate.GetType)]"
									}
									blockoverride "concept_link" {
										text = [estate_opinion|E]
									}

									textcontext = "[Estate.GetMostLikedCountriesFull]"
								}
							}
						}

						TooltipTextBlock = {
							visible = "[Not(Estate.GetType.IsAlwaysLoyal)]"
							blockoverride "text" {
								text = "[Estate.GetLeastLikedCountries]"
							}

							tooltipwidget = {
								SimpleContextualStringPairTooltipType = {
									blockoverride "title_icon_texture" {
										texture = "[GetEstateIcon(Estate.GetType)]"
									}
									blockoverride "concept_link" {
										text = [estate_opinion|E]
									}
									textcontext = "[Estate.GetLeastLikedCountriesFull]"
								}
							}
						}

						TooltipScrolledFlavorTextBlock = {
							blockoverride "block_scrollarea" { maximumsize = { -1 120 }}
							blockoverride "text" {
								text = "[Estate.GetType.GetFlavorText]"
							}
						}

					}
				}
			}
		}
	}
}
